<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- The app ships as Native AOT: trim and AOT analyzers on every shipped project. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!-- Displayed text lives in Resources/*.resx; the generator makes a strongly typed class per file (Format* methods for placeholders). -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/Resources')">
    <PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" PrivateAssets="all" />
  </ItemGroup>
</Project>
