@page "/message"
@namespace ServiceBusConsole.Pages

@inject NavigationManager Nav
@inject ServiceBusConnection Connection
@inject IMessageService MessageService
@inject NavigationState NavState

@if (NavState.Message is null)
{
    <Markup Content="No message selected." Foreground="@Color.Red" />
}
else
{
    var msg = NavState.Message;
    var src = NavState.MessageSource!;

    <Rows @onkeydown="HandleKeyDown">
        <Panel BorderColor="@Color.Grey37" FillWidth="true" Padding="@(new(0, 0, 0, 0))">
            <Columns>
                <Markup Content="@src.EntityName" Foreground="@Color.Grey" />
                <Markup Content=" › " Foreground="@Color.Grey" />
                <Markup Content="@($"Message #{msg.SequenceNumber}")" Foreground="@Color.DodgerBlue1" Decoration="@Decoration.Bold" />
            </Columns>
        </Panel>

        <Padder Padding="@(new(0, 1, 0, 0))">
            <Panel Title="Properties" BorderColor="@Color.Grey" FillWidth="true" Padding="@(new(1, 0, 1, 0))">
                <SpectreTable Expand="true" Border="TableBorder.Simple">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH>Property</SpectreTH>
                            <SpectreTH>Value</SpectreTH>
                        </SpectreTR>
                    </SpectreTHead>
                    <SpectreTBody>
                        <SpectreTR><SpectreTD>Message ID</SpectreTD><SpectreTD>@msg.MessageId</SpectreTD></SpectreTR>
                        <SpectreTR><SpectreTD>Sequence #</SpectreTD><SpectreTD>@msg.SequenceNumber</SpectreTD></SpectreTR>
                        <SpectreTR><SpectreTD>Subject</SpectreTD><SpectreTD>@msg.Subject</SpectreTD></SpectreTR>
                        <SpectreTR><SpectreTD>Content Type</SpectreTD><SpectreTD>@msg.ContentType</SpectreTD></SpectreTR>
                        <SpectreTR><SpectreTD>Enqueued</SpectreTD><SpectreTD>@msg.EnqueuedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</SpectreTD></SpectreTR>
                        <SpectreTR><SpectreTD>Delivery Count</SpectreTD><SpectreTD>@msg.DeliveryCount</SpectreTD></SpectreTR>
                        @foreach (var prop in msg.Properties)
                        {
                            <SpectreTR>
                                <SpectreTD>@prop.Key</SpectreTD>
                                <SpectreTD>@prop.Value</SpectreTD>
                            </SpectreTR>
                        }
                    </SpectreTBody>
                </SpectreTable>
            </Panel>
        </Padder>

        <Padder Padding="@(new(0, 1, 0, 0))">
            <Panel Title="Body" BorderColor="@Color.Grey" FillWidth="true" Padding="@(new(1, 0, 1, 0))">
                <ViewHeightScrollable LinesToRender="@(Math.Max(5, Console.WindowHeight / 2))" Scrollbar="new()">
                    <Markup Content="@FormatBody(msg.Body)" />
                </ViewHeightScrollable>
            </Panel>
        </Padder>

        <Padder Padding="@(new(1, 0, 0, 0))">
            <Columns>
                @if (IsDlq)
                {
                    <TextButton Content="[F10] Requeue" OnClick="@(() => _requeue!.Invoke())"
                                FocusedColor="@Color.Green" FocusOrder="1" OnKeyDown="@HandleKeyDown" />
                    <Markup Content="   " />
                }
                <TextButton Content="[F9] Delete" OnClick="@(() => _delete!.Invoke())"
                            FocusedColor="@Color.Red" FocusOrder="2" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[Esc] Back" OnClick="GoBack"
                            FocusedColor="@Color.Yellow" FocusOrder="3" OnKeyDown="@HandleKeyDown" />
            </Columns>
        </Padder>
    </Rows>
}

<AsyncCommand @ref="_delete" TItem="object"
              ConfirmMessage="@(_ => $"Delete message #{NavState.Message?.SequenceNumber} from {NavState.MessageSource?.EntityName}?")"
              Execute="@(_ => MessageService.DeleteMessageAsync(NavState.MessageSource!, NavState.Message!.SequenceNumber))"
              OnCompleted="@(_ => { GoBack(); return Task.CompletedTask; })" />

<AsyncCommand @ref="_requeue" TItem="object"
              Execute="@(_ => MessageService.RequeueMessageAsync(NavState.MessageSource!, NavState.Message!.SequenceNumber))"
              OnCompleted="@(_ => { GoBack(); return Task.CompletedTask; })" />

@code {
    private AsyncCommand<object>? _delete;
    private AsyncCommand<object>? _requeue;

    private bool IsDlq => NavState.MessageSource?.IsDlq == true;

    private void GoBack()
    {
        var src = NavState.MessageSource;
        if (src is null) { Nav.NavigateTo("/"); return; }
        if (src.IsSubscription)
            { NavState.TopicName = src.TopicName; NavState.SubscriptionName = src.SubscriptionName; Nav.NavigateTo("/subscription-browser"); }
        else
            Nav.NavigateTo($"/queues/{Uri.EscapeDataString(src.EntityName)}");
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (_delete?.HandleKey(e) == true) return;
        if (_requeue?.HandleKey(e) == true) return;
        switch (e.Key)
        {
            case "Escape": GoBack(); return;
            case "F9": case "Delete": _delete!.Invoke(); return;
            case "F10": if (IsDlq) _requeue!.Invoke(); return;
        }
    }

    private static readonly System.Text.Json.JsonSerializerOptions IndentedJson = new()
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
    };

    private static string FormatBody(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            // Bodies sent as AMQP strings arrive JSON-encoded; unwrap one level.
            if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.String)
                return FormatBody(doc.RootElement.GetString() ?? body);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, IndentedJson);
        }
        catch (System.Text.Json.JsonException) { return body; }
    }
}
