@page "/message"
@namespace ServiceBusConsole.Pages

@inject NavigationManager Nav
@inject ServiceBusConnection Connection
@inject NavigationState NavState
@inject MessageBrowserStore Store

@if (NavState.Message is null)
{
    <Markup Content="No message selected." Foreground="@Color.Red" />
}
else
{
    var msg = NavState.Message;

    <Rows @onkeydown="HandleKeyDown">
        <Panel BorderColor="@Color.Grey37" FillWidth="true" Padding="@(new(0, 0, 0, 0))">
            <Columns>
                <Markup Content="@(NavState.MessageSource?.DisplayName ?? "")" Foreground="@Color.Grey" />
                <Markup Content=" › " Foreground="@Color.Grey" />
                <Markup Content="@($"Message #{msg.SequenceNumber}")" Foreground="@Color.DodgerBlue1" Decoration="@Decoration.Bold" />
            </Columns>
        </Panel>

        <Padder Padding="@(new(0, 1, 0, 0))">
            <Panel Title="Properties" BorderColor="@Color.Grey" FillWidth="true" Padding="@(new(1, 0, 1, 0))">
                <SpectreTable Expand="true" Border="TableBorder.Simple">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH>Property</SpectreTH>
                            <SpectreTH>Value</SpectreTH>
                        </SpectreTR>
                    </SpectreTHead>
                    <SpectreTBody>
                        <SpectreTR><SpectreTD>Message ID</SpectreTD><SpectreTD>@msg.MessageId</SpectreTD></SpectreTR>
                        <SpectreTR><SpectreTD>Sequence #</SpectreTD><SpectreTD>@msg.SequenceNumber</SpectreTD></SpectreTR>
                        <SpectreTR><SpectreTD>Subject</SpectreTD><SpectreTD>@msg.Subject</SpectreTD></SpectreTR>
                        <SpectreTR><SpectreTD>Content Type</SpectreTD><SpectreTD>@msg.ContentType</SpectreTD></SpectreTR>
                        <SpectreTR><SpectreTD>Enqueued</SpectreTD><SpectreTD>@msg.EnqueuedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</SpectreTD></SpectreTR>
                        <SpectreTR><SpectreTD>Delivery Count</SpectreTD><SpectreTD>@msg.DeliveryCount</SpectreTD></SpectreTR>
                        <SpectreTR><SpectreTD>State</SpectreTD><SpectreTD>@StateText(msg)</SpectreTD></SpectreTR>
                        @foreach (var prop in msg.Properties)
                        {
                            <SpectreTR>
                                <SpectreTD>@prop.Key</SpectreTD>
                                <SpectreTD>@prop.Value</SpectreTD>
                            </SpectreTR>
                        }
                    </SpectreTBody>
                </SpectreTable>
            </Panel>
        </Padder>

        <Padder Padding="@(new(0, 1, 0, 0))">
            <Panel Title="Body" BorderColor="@Color.Grey" FillWidth="true" Padding="@(new(1, 0, 1, 0))">
                <ViewHeightScrollable LinesToRender="@(Math.Max(5, Console.WindowHeight / 2))" Scrollbar="new()">
                    <Markup Content="@FormatBody(msg.Body)" />
                </ViewHeightScrollable>
            </Panel>
        </Padder>

        <Padder Padding="@(new(1, 0, 0, 0))">
            <Columns>
                @if (Mode == BrowseMode.Locked)
                {
                    <TextButton Content="[F9] Complete" OnClick="@(() => _complete?.Invoke())"
                                FocusedColor="@Color.Red" FocusOrder="1" OnKeyDown="@HandleKeyDown" />
                    <Markup Content="  " />
                    <TextButton Content="[F4] Abandon" OnClick="@(() => _abandon?.Invoke())"
                                FocusedColor="@Color.Yellow" FocusOrder="2" OnKeyDown="@HandleKeyDown" />
                    <Markup Content="  " />
                    @if (!IsDlq)
                    {
                        <TextButton Content="[F3] Dead-letter" OnClick="@(() => _deadLetter?.Invoke())"
                                    FocusedColor="@Color.Red" FocusOrder="3" OnKeyDown="@HandleKeyDown" />
                        <Markup Content="  " />
                    }
                }
                @if (CanRequeue)
                {
                    <TextButton Content="[F10] Requeue" OnClick="@(() => _requeue?.Invoke())"
                                FocusedColor="@Color.Green" FocusOrder="4" OnKeyDown="@HandleKeyDown" />
                    <Markup Content="  " />
                }
                else if (Mode == BrowseMode.Peek && _browser is not null)
                {
                    <TextButton Content="[F10] Resend" OnClick="@(() => _resend?.Invoke())"
                                FocusedColor="@Color.Green" FocusOrder="4" OnKeyDown="@HandleKeyDown" />
                    <Markup Content="  " />
                }
                <TextButton Content="[Esc] Back" OnClick="GoBack"
                            FocusedColor="@Color.Yellow" FocusOrder="5" OnKeyDown="@HandleKeyDown" />
            </Columns>
        </Padder>
    </Rows>
}

<AsyncCommand @ref="_complete" TItem="object"
              ConfirmMessage="@(_ => $"Complete message #{NavState.Message?.SequenceNumber}? It is removed from {NavState.MessageSource?.DisplayName}.")"
              Execute="@(_ => Act((b, m) => b.CompleteAsync(m)))"
              OnCompleted="@(_ => { GoBack(); return Task.CompletedTask; })" />

<AsyncCommand @ref="_abandon" TItem="object"
              Execute="@(_ => Act((b, m) => b.AbandonAsync(m)))"
              OnCompleted="@(_ => { GoBack(); return Task.CompletedTask; })" />

<AsyncCommand @ref="_deadLetter" TItem="object"
              ConfirmMessage="@(_ => $"Move message #{NavState.Message?.SequenceNumber} to the dead-letter queue?")"
              Execute="@(_ => Act((b, m) => b.DeadLetterAsync(m)))"
              OnCompleted="@(_ => { GoBack(); return Task.CompletedTask; })" />

<AsyncCommand @ref="_requeue" TItem="object"
              ConfirmMessage="@(_ => $"Requeue message #{NavState.Message?.SequenceNumber} to {NavState.MessageSource?.SendTarget}?")"
              Execute="@(_ => Act((b, m) => b.RequeueAsync(m)))"
              OnCompleted="@(_ => { GoBack(); return Task.CompletedTask; })" />

<AsyncCommand @ref="_resend" TItem="object"
              ConfirmMessage="@(_ => $"Send a copy of message #{NavState.Message?.SequenceNumber} to {NavState.MessageSource?.SendTarget}? The original stays.")"
              Execute="@(_ => Act((b, m) => b.ResendAsync(m)))"
              OnCompleted="@(_ => { GoBack(); return Task.CompletedTask; })" />

@code {
    private AsyncCommand<object>? _complete;
    private AsyncCommand<object>? _abandon;
    private AsyncCommand<object>? _deadLetter;
    private AsyncCommand<object>? _requeue;
    private AsyncCommand<object>? _resend;
    private MessageBrowser? _browser;

    private bool IsDlq => NavState.MessageSource?.IsDlq == true;
    private BrowseMode? Mode => NavState.Message is null ? null : _browser?.Mode;
    private bool CanRequeue => Mode == BrowseMode.Received || (Mode == BrowseMode.Locked && IsDlq);

    protected override void OnInitialized()
    {
        if (Store.Current is { } current && current.Source == NavState.MessageSource) _browser = current;
    }

    private string StateText(MessageInfo m) => m.State switch
    {
        MessageState.Locked => _browser?.IsLockHeld(m) == true ? "Locked by this console" : "Lock lost (back on the queue)",
        MessageState.Received => "Received and deleted; requeue it or it is gone",
        _ => "Peeked (read-only)",
    };

    private AsyncCommand<object>?[] Commands => [_complete, _abandon, _deadLetter, _requeue, _resend];

    private Task Act(Func<MessageBrowser, IReadOnlyList<MessageInfo>, Task> action) =>
        _browser is { } b && NavState.Message is { } m
            ? action(b, [m])
            : throw new InvalidOperationException("This message is no longer loaded.");

    private void GoBack()
    {
        var src = NavState.MessageSource;
        if (src is null) { Nav.NavigateTo("/"); return; }
        if (src.IsSubscription)
            { NavState.TopicName = src.TopicName; NavState.SubscriptionName = src.SubscriptionName; Nav.NavigateTo("/subscription-browser"); }
        else
            Nav.NavigateTo($"/queues/{Uri.EscapeDataString(src.EntityName)}");
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (Commands.Any(c => c?.HandleKey(e) == true)) return;
        if (Commands.Any(c => c?.IsBusy == true)) return;
        switch (e.Key)
        {
            case "Escape": GoBack(); return;
            case "F9": case "Delete": if (Mode == BrowseMode.Locked) _complete?.Invoke(); return;
            case "F4": if (Mode == BrowseMode.Locked) _abandon?.Invoke(); return;
            case "F3": if (Mode == BrowseMode.Locked && !IsDlq) _deadLetter?.Invoke(); return;
            case "F10":
                if (CanRequeue) _requeue?.Invoke();
                else if (Mode == BrowseMode.Peek) _resend?.Invoke();
                return;
        }
    }

    private static readonly System.Text.Json.JsonSerializerOptions IndentedJson = new()
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
    };

    private static string FormatBody(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            // Bodies sent as AMQP strings arrive JSON-encoded; unwrap one level.
            if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.String)
                return FormatBody(doc.RootElement.GetString() ?? body);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, IndentedJson);
        }
        catch (System.Text.Json.JsonException) { return body; }
    }
}
