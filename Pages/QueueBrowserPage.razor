@page "/queues/{QueueName}"
@namespace ServiceBusConsole.Pages

@inject NavigationManager Nav
@inject ServiceBusConnection Connection
@inject IMessageService MessageService
@inject IQueueService QueueService
@inject NavigationState NavState
@inject RazorConsole.Core.Focus.FocusManager FocusManager

<FullscreenPage OnKeyDown="HandleKeyDown">
    <Content>
        <Panel BorderColor="@Color.Grey37" Expand="true" Padding="@(new(0, 0, 0, 0))">
            <Columns>
                <Markup Content="Queues" Foreground="@Color.Grey" />
                <Markup Content=" › " Foreground="@Color.Grey" />
                <Markup Content="@QueueName" Foreground="@Color.DodgerBlue1" Decoration="@Decoration.Bold" />
                @if (_isDlq) { <Markup Content=" (DLQ)" Foreground="@Color.Yellow" /> }
            </Columns>
        </Panel>

        @if (_loading)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                    <Markup Content="Loading messages..." Foreground="@Color.Grey" Decoration="@Decoration.Italic" />
                </Columns>
            </Padder>
        }
        else if (_messages.Count > 0)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="@($"{_messages.Count} message(s)")" Foreground="@Color.Grey" />
            </Padder>

            <Scrollable Items="@_messages"
                        PageSize="@FullscreenLayout.PageSizeSimpleTable()"
                        Scrollbar="new()"
                        SelectedIndex="@_selectedIndex"
                        SelectedIndexChanged="@(i => { _selectedIndex = i; _focusedMessage = _messages.ElementAtOrDefault(i); })"
                        OnActivate="@(() => { if (_messages.ElementAtOrDefault(_selectedIndex) is {} m) ViewMessage(m); })">
                <SpectreTable Expand="true" Border="TableBorder.Simple">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH Align="Justify.Right">#</SpectreTH>
                            <SpectreTH Align="Justify.Left">Message ID</SpectreTH>
                            <SpectreTH Align="Justify.Left">Subject</SpectreTH>
                            <SpectreTH Align="Justify.Left">Enqueued</SpectreTH>
                            <SpectreTH Align="Justify.Right">Delivery</SpectreTH>
                        </SpectreTR>
                    </SpectreTHead>
                    <SpectreTBody @ref="_tbody"
                                  Navigable="true"
                                  FocusOrder="1"
                                  RowCount="@context.Items.Count"
                                  OnKeyDown="@HandleKeyDown">
                        @{ var i = 0; }
                        @foreach (var m in context.Items)
                        {
                            var idx = i++;
                            <SpectreTR @key="m.SequenceNumber" RowIndex="@idx">
                                <SpectreTD Align="Justify.Right">@m.SequenceNumber</SpectreTD>
                                <SpectreTD>@Truncate(m.MessageId, 30)</SpectreTD>
                                <SpectreTD>@Truncate(m.Subject, 25)</SpectreTD>
                                <SpectreTD>@m.EnqueuedTime.LocalDateTime.ToString("HH:mm:ss")</SpectreTD>
                                <SpectreTD Align="Justify.Right">@m.DeliveryCount</SpectreTD>
                            </SpectreTR>
                        }
                    </SpectreTBody>
                </SpectreTable>
            </Scrollable>
        }
        else
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="No messages. Use F7 Peek or F8 Receive to load." Foreground="@Color.Grey" Decoration="@Decoration.Italic" />
            </Padder>
        }
    </Content>
    <Footer>
        <Padder Padding="@(new(1, 0, 0, 0))">
            <Columns>
                <TextButton Content="[F7] Peek" OnClick="PeekMessages" FocusedColor="@Color.Green" FocusOrder="2" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[F8] Receive" OnClick="ReceiveMessages" FocusedColor="@Color.Red" FocusOrder="3" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                @if (!_isDlq)
                {
                    <TextButton Content="[F6] View DLQ" OnClick="@(() => SwitchDlq(true))" FocusedColor="@Color.Yellow" FocusOrder="4" OnKeyDown="@HandleKeyDown" />
                }
                else
                {
                    <TextButton Content="[F6] View Active" OnClick="@(() => SwitchDlq(false))" FocusedColor="@Color.Green" FocusOrder="4" OnKeyDown="@HandleKeyDown" />
                }
                <Markup Content="   " />
                @if (_isDlq)
                {
                    <TextButton Content="[F10] Requeue" OnClick="@(() => _requeue!.Invoke(_focusedMessage))" FocusedColor="@Color.Green" FocusOrder="5" OnKeyDown="@HandleKeyDown" />
                    <Markup Content="   " />
                }
                <TextButton Content="[F9] Delete" OnClick="@(() => _delete!.Invoke(_focusedMessage))" FocusedColor="@Color.Red" FocusOrder="6" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[F11] Purge" OnClick="@(() => _purge!.Invoke())" FocusedColor="@Color.Red" FocusOrder="7" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[Esc] Back" OnClick="@(() => Nav.NavigateTo("/queues"))" FocusedColor="@Color.Yellow" FocusOrder="8" OnKeyDown="@HandleKeyDown" />
            </Columns>
        </Padder>
    </Footer>
</FullscreenPage>

<AsyncCommand @ref="_delete" TItem="MessageInfo"
              ConfirmMessage="@(m => $"Delete message #{m!.SequenceNumber}?")"
              Execute="@(m => MessageService.DeleteMessageAsync(Source, m!.SequenceNumber))"
              OnCompleted="@(m => { _messages.Remove(m!); _selectedIndex = Math.Min(_selectedIndex, Math.Max(0, _messages.Count - 1)); _focusedMessage = _messages.ElementAtOrDefault(_selectedIndex); StateHasChanged(); return Task.CompletedTask; })" />

<AsyncCommand @ref="_requeue" TItem="MessageInfo"
              Execute="@(m => MessageService.RequeueMessageAsync(Source, m!.SequenceNumber))"
              OnCompleted="@(m => { _messages.Remove(m!); _focusedMessage = _messages.ElementAtOrDefault(_selectedIndex); StateHasChanged(); return Task.CompletedTask; })" />

<ErrorModal Message="@_error" OnDismiss="@(() => _error = string.Empty)" />

<AsyncCommand @ref="_purge" TItem="object"
              ConfirmMessage="@(_ => $"Purge ALL messages from {QueueName}{(_isDlq ? " DLQ" : "")}? This cannot be undone.")"
              Execute="@(_ => MessageService.PurgeMessagesAsync(Source))"
              OnCompleted="@(_ => { _messages = []; _selectedIndex = 0; _focusedMessage = null; StateHasChanged(); return Task.CompletedTask; })" />

@code {
    [Parameter] public string QueueName { get; set; } = "";

    private bool _isDlq = true;
    private List<MessageInfo> _messages = [];
    private bool _loading;
    private string _error = string.Empty;
    private int _selectedIndex;
    private MessageInfo? _focusedMessage;
    private SpectreTBody? _tbody;
    private bool _tableAutoFocused;

    private AsyncCommand<MessageInfo>? _delete;
    private AsyncCommand<MessageInfo>? _requeue;
    private AsyncCommand<object>? _purge;

    private const int FetchLimit = 100;
    private MessageSource Source => new(QueueName, _isDlq);

    protected override void OnInitialized()
    {
        if (Connection.CurrentNamespace is null)
            Nav.NavigateTo("/");
    }

    protected override async Task OnInitializedAsync() => await PeekMessages();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_tableAutoFocused && _tbody is not null && _messages.Count > 0)
        {
            _tableAutoFocused = true;
            await FocusManager.FocusAsync(_tbody.FocusKey);
        }
    }

    private async Task SwitchDlq(bool dlq) { _isDlq = dlq; _messages = []; _selectedIndex = 0; _focusedMessage = null; await PeekMessages(); }

    private async Task PeekMessages()
    {
        _loading = true; _error = string.Empty; StateHasChanged();
        try { _messages = await MessageService.PeekMessagesAsync(QueueName, FetchLimit, _isDlq); }
        catch (Exception ex) { _error = ex.Message; }
        _focusedMessage = _messages.ElementAtOrDefault(_selectedIndex);
        _loading = false; StateHasChanged();
    }

    private async Task ReceiveMessages()
    {
        _loading = true; _error = string.Empty; StateHasChanged();
        try { _messages = await MessageService.ReceiveMessagesAsync(QueueName, FetchLimit, _isDlq); }
        catch (Exception ex) { _error = ex.Message; }
        _focusedMessage = _messages.ElementAtOrDefault(_selectedIndex);
        _loading = false; StateHasChanged();
    }

    private void ViewMessage(MessageInfo msg)
    {
        NavState.Message = msg;
        NavState.MessageSource = Source;
        Nav.NavigateTo("/message");
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (_delete?.HandleKey(e) == true) return;
        if (_requeue?.HandleKey(e) == true) return;
        if (_purge?.HandleKey(e) == true) return;
        switch (e.Key)
        {
            case "Escape": Nav.NavigateTo("/queues"); return;
            case "F6": _ = SwitchDlq(!_isDlq); return;
            case "F7": _ = PeekMessages(); return;
            case "F8": _ = ReceiveMessages(); return;
            case "F9": case "Delete": case "\\":
                if (_focusedMessage is not null) _delete!.Invoke(_focusedMessage);
                return;
            case "F10":
                if (_isDlq && _focusedMessage is not null) _requeue!.Invoke(_focusedMessage);
                return;
            case "F11": _purge!.Invoke(); return;
        }
    }

    private static string Truncate(string value, int maxLength) =>
        value.Length <= maxLength ? value : value[..(maxLength - 1)] + "…";
}
