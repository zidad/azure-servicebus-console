@page "/"
@namespace ServiceBusConsole.Pages

@inject NavigationManager Nav
@inject NavigationState NavState
@inject INamespaceService NamespaceService
@inject ServiceBusConnection Connection
@inject FileCache FileCache
@inject RazorConsole.Core.Focus.FocusManager FocusManager
@inject ITerminalViewport Viewport

<Figlet Content="SB Console" Color="@Color.DodgerBlue1" Justify="Justify.Left" />

<Panel Title="⚠ Work In Progress" BorderColor="@Color.DarkOrange" FillWidth="true" Padding="@(new(1, 0, 1, 0))">
    <Rows>
        <Markup Content="This application is still in early development. Many features are unstable or incomplete." Foreground="@Color.DarkOrange" Decoration="@Decoration.Bold" />
        <Markup Content="Use with caution — especially destructive operations (delete, receive)." Foreground="@Color.Grey" />
    </Rows>
</Panel>

<Panel Title="Connection" BorderColor="@Color.Grey" FillWidth="true" Padding="@(new(1, 0, 1, 0))">
    <Rows>
        <Scrollable Items="@SubscriptionOptions"
                    PageSize="@SubscriptionOptions.Length"
                    SelectedIndex="@_subscriptionIndex"
                    SelectedIndexChanged="@(i => { _subscriptionIndex = i; _ = SelectSubscription(SubscriptionOptions[i]); })"
                    OnActivate="FocusNamespaces">
            <SpectreTable Expand="true" Border="TableBorder.Rounded">
                <SpectreTHead>
                    <SpectreTR>
                        <SpectreTH Align="Justify.Left">Azure subscription</SpectreTH>
                        <SpectreTH Align="Justify.Left">ID</SpectreTH>
                    </SpectreTR>
                </SpectreTHead>
                <SpectreTBody @ref="_subscriptionBody"
                              Navigable="true"
                              FocusOrder="1"
                              RowCount="@context.Items.Count"
                              OnKeyDown="@HandleKeyDown">
                    @{ var i = 0; }
                    @foreach (var sub in context.Items)
                    {
                        var idx = i++;
                        <SpectreTR @key="sub.Name" RowIndex="@idx">
                            <SpectreTD>@sub.Name</SpectreTD>
                            <SpectreTD>@(sub.Id ?? "localhost:5672")</SpectreTD>
                        </SpectreTR>
                    }
                </SpectreTBody>
            </SpectreTable>
        </Scrollable>

        @if (_namespacesLoading)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                    <Markup Content="Discovering namespaces..." Foreground="@Color.Grey" Decoration="@Decoration.Italic" />
                </Columns>
            </Padder>
        }
        else if (_connectionFailed)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <Markup Content="Could not connect.  " Foreground="@Color.Red" />
                    <TextButton Content="Retry" OnClick="RetryConnection" FocusedColor="@Color.Yellow" FocusOrder="2" OnKeyDown="@HandleKeyDown" />
                </Columns>
            </Padder>
        }
        else if (_namespaces.Count > 0)
        {
            <Scrollable Items="@_namespaces"
                        PageSize="@NamespacePageSize"
                        Scrollbar="new()"
                        SelectedIndex="@_namespaceIndex"
                        SelectedIndexChanged="@(i => SelectNamespace(i))"
                        OnActivate="@(() => Nav.NavigateTo("/queues"))">
                <SpectreTable Expand="true" Border="TableBorder.Rounded">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH Align="Justify.Left">Namespace</SpectreTH>
                            <SpectreTH Align="Justify.Left">Resource group</SpectreTH>
                            <SpectreTH Align="Justify.Left">Location</SpectreTH>
                            <SpectreTH Align="Justify.Left">SKU</SpectreTH>
                            <SpectreTH Align="Justify.Left">Status</SpectreTH>
                        </SpectreTR>
                    </SpectreTHead>
                    <SpectreTBody @ref="_namespaceBody"
                                  Navigable="true"
                                  FocusOrder="2"
                                  RowCount="@context.Items.Count"
                                  OnKeyDown="@HandleKeyDown">
                        @{ var i = 0; }
                        @foreach (var ns in context.Items)
                        {
                            var idx = i++;
                            <SpectreTR @key="ns.Name" RowIndex="@idx">
                                <SpectreTD>@ns.Name</SpectreTD>
                                <SpectreTD>@ns.ResourceGroup</SpectreTD>
                                <SpectreTD>@ns.Location</SpectreTD>
                                <SpectreTD>@ns.Sku</SpectreTD>
                                <SpectreTD>@ns.Status</SpectreTD>
                            </SpectreTR>
                        }
                    </SpectreTBody>
                </SpectreTable>
            </Scrollable>
        }

        @if (ChosenNamespace is not null)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <TextButton Content="[F1] Queues"
                                OnClick="@(() => Nav.NavigateTo("/queues"))"
                                FocusedColor="@Color.DodgerBlue1"
                                FocusOrder="3"
                                OnKeyDown="@HandleKeyDown" />
                    <Markup Content="  " />
                    <TextButton Content="[F2] Topics"
                                OnClick="@(() => Nav.NavigateTo("/topics"))"
                                FocusedColor="@Color.DodgerBlue1"
                                FocusOrder="4"
                                OnKeyDown="@HandleKeyDown" />
                    <Markup Content="  " />
                    <TextButton Content="[F3] All Subscriptions"
                                OnClick="@(() => Nav.NavigateTo("/subscriptions"))"
                                FocusedColor="@Color.DodgerBlue1"
                                FocusOrder="5"
                                OnKeyDown="@HandleKeyDown" />
                </Columns>
            </Padder>
        }
    </Rows>
</Panel>

<Padder Padding="@(new(0, 1, 0, 0))">
    <Columns>
        <Markup Content="@($"Cache: {FileCache.CacheDirectory}")" Foreground="@Color.Grey" Decoration="@Decoration.Italic" />
        <Markup Content="   " />
        @if (_cacheStatus is null)
        {
            <TextButton Content="Clear cache" OnClick="ClearCache" FocusedColor="@Color.Red" FocusOrder="6" OnKeyDown="@HandleKeyDown" />
        }
        else
        {
            <Markup Content="@_cacheStatus" Foreground="@(_cacheClearFailed ? Color.Red : Color.Green)" />
        }
    </Columns>
</Padder>

<ErrorModal Message="@_error" OnDismiss="@(() => _error = string.Empty)" />

@code {
    private static AzureSubscription[] SubscriptionOptions => AzureSubscriptions.All;

    // Figlet 6 + banner 4 + panel 2 + subscription table 9 + namespace chrome 4 + buttons 2 + cache row 2.
    private const int NonNamespaceLines = 29;
    private int NamespacePageSize => Math.Clamp(Viewport.Height - NonNamespaceLines, 1, 10);
    private static readonly TimeSpan SubscriptionDebounce = TimeSpan.FromMilliseconds(250);

    private int _subscriptionIndex;
    private int _namespaceIndex;
    private List<NamespaceInfo> _namespaces = [];
    private bool _namespacesLoading;
    private bool _connectionFailed;
    private string _error = string.Empty;
    private CancellationTokenSource _cts = new();
    private SpectreTBody? _subscriptionBody;
    private SpectreTBody? _namespaceBody;
    private bool _subscriptionsFocused;
    private bool _focusNamespaces;
    private string? _restoreNamespace;

    private NamespaceInfo? ChosenNamespace => _namespacesLoading ? null : _namespaces.ElementAtOrDefault(_namespaceIndex);

    protected override Task OnInitializedAsync()
    {
        _subscriptionIndex = Math.Max(0, Array.FindIndex(SubscriptionOptions, s => s.Name == NavState.AzureSubscriptionName));
        return SelectSubscription(SubscriptionOptions[_subscriptionIndex]);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_subscriptionsFocused && _subscriptionBody is not null)
        {
            _subscriptionsFocused = true;
            await FocusManager.FocusAsync(_subscriptionBody.FocusKey);
        }
        if (_focusNamespaces && _namespaceBody is not null)
        {
            _focusNamespaces = false;
            await FocusManager.FocusAsync(_namespaceBody.FocusKey);
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (ChosenNamespace is null) return;
        switch (e.Key)
        {
            case "F1": Nav.NavigateTo("/queues"); return;
            case "F2": Nav.NavigateTo("/topics"); return;
            case "F3": Nav.NavigateTo("/subscriptions"); return;
        }
    }

    private void FocusNamespaces()
    {
        _focusNamespaces = true;
        StateHasChanged();
    }

    private Task RetryConnection() => SelectSubscription(SubscriptionOptions[_subscriptionIndex]);

    private string? _cacheStatus;
    private bool _cacheClearFailed;

    private void ClearCache()
    {
        try
        {
            var count = FileCache.Clear();
            _cacheStatus = count == 0 ? "✓ Cache already empty" : $"✓ Cache cleared ({count} file{(count == 1 ? "" : "s")})";
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _cacheClearFailed = true;
            _cacheStatus = $"Clear failed: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task SelectSubscription(AzureSubscription subscription)
    {
        // Take the token for *this* run: a newer selection replaces the field.
        _cts.Cancel();
        var token = (_cts = new CancellationTokenSource()).Token;
        _error = string.Empty;
        _connectionFailed = false;
        _namespaces = [];
        _namespaceIndex = 0;
        _restoreNamespace = Connection.CurrentNamespace;
        NavState.AzureSubscriptionName = subscription.Name;

        if (subscription.IsEmulator)
        {
            _namespaces = [AzureSubscriptions.EmulatorNamespace];
            SelectNamespace(0);
            return;
        }

        _namespacesLoading = true;
        StateHasChanged();

        try
        {
            // Arrowing through subscriptions should not query Azure for each one passed.
            await Task.Delay(SubscriptionDebounce, token);
            await foreach (var ns in NamespaceService.GetNamespacesAsync(subscription, token))
            {
                if (token.IsCancellationRequested) return;
                _namespacesLoading = false;
                var idx = _namespaces.FindIndex(x => x.Name == ns.Name);
                if (idx >= 0) _namespaces[idx] = ns; else _namespaces.Add(ns);
                if (ns.FullyQualifiedNamespace == _restoreNamespace)
                {
                    _restoreNamespace = null;
                    _namespaceIndex = _namespaces.FindIndex(x => x.Name == ns.Name);
                }
                SelectNamespace(_namespaceIndex);
            }
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) { _connectionFailed = true; _error = ex.Message; }

        _namespacesLoading = false;
        StateHasChanged();
    }

    private void SelectNamespace(int index)
    {
        _namespaceIndex = index;
        if (_namespaces.ElementAtOrDefault(index) is { } ns) Connection.SetNamespace(ns);
        StateHasChanged();
    }
}
