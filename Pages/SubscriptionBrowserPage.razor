@page "/subscription-browser"
@namespace ServiceBusConsole.Pages

@inject NavigationManager Nav
@inject ServiceBusConnection Connection
@inject NavigationState NavState

<MessageBrowserView Entity="@(new MessageSource(SubscriptionName, IsDlq: true, TopicName, SubscriptionName))" BackPath="@BackPath">
    <Breadcrumb>
        <Markup Content="Topics" Foreground="@Color.Grey" />
        <Markup Content=" › " Foreground="@Color.Grey" />
        <Markup Content="@TopicName" Foreground="@Color.Grey" />
        <Markup Content=" › " Foreground="@Color.Grey" />
        <Markup Content="@SubscriptionName" Foreground="@Color.DodgerBlue1" Decoration="@Decoration.Bold" />
    </Breadcrumb>
</MessageBrowserView>

@code {
    private string TopicName => NavState.TopicName ?? "";
    private string SubscriptionName => NavState.SubscriptionName ?? "";

    private string BackPath => NavState.ReturnPath ?? (string.IsNullOrEmpty(TopicName) ? "/topics" : "/topic-detail");

    protected override void OnInitialized()
    {
        if (Connection.CurrentNamespace is null)
            Nav.NavigateTo("/");
    }
}
