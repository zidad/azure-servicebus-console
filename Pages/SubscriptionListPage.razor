@page "/topic-detail"
@namespace ServiceBusConsole.Pages
@implements IDisposable

@inject NavigationManager Nav
@inject NavigationState NavState
@inject ServiceBusConnection Connection
@inject ITopicService TopicService
@inject IMessageService MessageService
@inject RazorConsole.Core.Focus.FocusManager FocusManager

<FullscreenPage OnKeyDown="HandleKeyDown">
    <Content>
        <Panel BorderColor="@Color.Grey37" Expand="true" Padding="@(new(0, 0, 0, 0))">
            <Columns>
                <Markup Content="Topics" Foreground="@Color.Grey" />
                <Markup Content=" › " Foreground="@Color.Grey" />
                <Markup Content="@TopicName" Foreground="@Color.DodgerBlue1" Decoration="@Decoration.Bold" />
            </Columns>
        </Panel>

        @if (_subscriptions.Count == 0 && _loadFailed)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="Failed to load. Press [F5] to retry." Foreground="@Color.Red" />
            </Padder>
        }
        else if (_subscriptions.Count == 0)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                    <Markup Content="Loading subscriptions..." Foreground="@Color.Grey" Decoration="@Decoration.Italic" />
                </Columns>
            </Padder>
        }
        else
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="@($"{_subscriptions.Count} subscription(s)  |  Enter to browse · Backspace to delete")" Foreground="@Color.Grey" />
            </Padder>

            <Scrollable Items="@_subscriptions"
                        PageSize="@FullscreenLayout.PageSizeRoundedTable()"
                        Scrollbar="new()"
                        SelectedIndex="@_selectedIndex"
                        SelectedIndexChanged="@(i => { _selectedIndex = i; _focusedItem = _subscriptions.ElementAtOrDefault(i)?.Name; })"
                        OnActivate="@(() => { if (_subscriptions.ElementAtOrDefault(_selectedIndex) is {} s) { NavState.TopicName = TopicName; NavState.SubscriptionName = s.Name; NavState.ReturnPath = "/topic-detail"; Nav.NavigateTo("/subscription-browser"); } })">
                <SpectreTable Expand="true" Border="TableBorder.Rounded">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH Align="Justify.Left">Subscription</SpectreTH>
                            <SpectreTH Align="Justify.Right">Active</SpectreTH>
                            <SpectreTH Align="Justify.Right">DLQ</SpectreTH>
                            <SpectreTH Align="Justify.Right">Transfer</SpectreTH>
                            <SpectreTH></SpectreTH>
                        </SpectreTR>
                    </SpectreTHead>
                    <SpectreTBody @ref="_tbody"
                                  Navigable="true"
                                  FocusOrder="1"
                                  RowCount="@context.Items.Count"
                                  OnKeyDown="@HandleKeyDown">
                        @{ var i = 0; }
                        @foreach (var s in context.Items)
                        {
                            var idx = i++;
                            <SpectreTR @key="s.Name" RowIndex="@idx">
                                <SpectreTD>@s.Name</SpectreTD>
                                <SpectreTD Align="Justify.Right">@s.ActiveMessageCount</SpectreTD>
                                <SpectreTD Align="Justify.Right">@(s.DeadLetterMessageCount > 0 ? $"! {s.DeadLetterMessageCount}" : "0")</SpectreTD>
                                <SpectreTD Align="Justify.Right">@s.TransferMessageCount</SpectreTD>
                                <SpectreTD>@if (s.IsRefreshing) { <Spinner /> }</SpectreTD>
                            </SpectreTR>
                        }
                    </SpectreTBody>
                </SpectreTable>
            </Scrollable>
        }
    </Content>
    <Footer>
        <Padder Padding="@(new(1, 0, 0, 0))">
            <Columns>
                <TextButton Content="[F5] Refresh" OnClick="LoadSubscriptions" FocusedColor="@Color.Green" FocusOrder="2" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[F9] Delete" OnClick="@(() => _deleteSub!.Invoke(_focusedItem))" FocusedColor="@Color.Red" FocusOrder="3" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[F11] Purge DLQ" OnClick="@(() => _purgeDlq!.Invoke(_focusedItem))" FocusedColor="@Color.Red" FocusOrder="4" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[Esc] Back" OnClick="@(() => Nav.NavigateTo("/topics"))" FocusedColor="@Color.Yellow" FocusOrder="5" OnKeyDown="@HandleKeyDown" />
            </Columns>
        </Padder>
    </Footer>
</FullscreenPage>

<ErrorModal Message="@_error" OnDismiss="@(() => _error = string.Empty)" />

<AsyncCommand @ref="_deleteSub" TItem="string"
              ConfirmMessage="@(n => $"Delete subscription '{n}' from topic '{TopicName}'? This cannot be undone.")"
              Execute="@(n => TopicService.DeleteSubscriptionAsync(TopicName, n!))"
              OnCompleted="@(n => { _subscriptions.RemoveAll(s => s.Name == n); _selectedIndex = Math.Min(_selectedIndex, Math.Max(0, _subscriptions.Count - 1)); _focusedItem = _subscriptions.ElementAtOrDefault(_selectedIndex)?.Name; StateHasChanged(); return Task.CompletedTask; })" />

<AsyncCommand @ref="_purgeDlq" TItem="string"
              ConfirmMessage="@(n => $"Purge ALL messages from DLQ of '{TopicName}/{n}'? This cannot be undone.")"
              Execute="@(n => MessageService.PurgeMessagesAsync(new MessageSource(n!, IsDlq: true, TopicName, n!)))"
              OnCompleted="@(n => { if (_subscriptions.FirstOrDefault(s => s.Name == n) is {} s) s.DeadLetterMessageCount = 0; SortAndReanchor(); StateHasChanged(); return Task.CompletedTask; })" />

@code {
    private string TopicName => NavState.TopicName ?? "";

    private List<SubscriptionInfo> _subscriptions = [];
    private int _selectedIndex;
    private string? _focusedItem;
    private string _error = string.Empty;
    private AsyncCommand<string>? _deleteSub;
    private AsyncCommand<string>? _purgeDlq;
    private bool _loadFailed;
    private CancellationTokenSource _cts = new();
    private readonly RenderThrottle _renderThrottle = new();
    private SpectreTBody? _tbody;
    private bool _tableAutoFocused;

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }


    protected override void OnInitialized()
    {
        if (Connection.CurrentNamespace is null)
            Nav.NavigateTo("/");
        _focusedItem = NavState.SubscriptionName;
    }

    protected override async Task OnInitializedAsync() => await LoadSubscriptions();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_tableAutoFocused && _tbody is not null && _subscriptions.Count > 0)
        {
            _tableAutoFocused = true;
            await FocusManager.FocusAsync(_tbody.FocusKey);
        }
    }

    private async Task LoadSubscriptions()
    {
        // Take the token for *this* run: F5 replaces the field, and a superseded run
        // must not read the new run's token and conclude it was never cancelled.
        _cts.Cancel();
        var token = (_cts = new CancellationTokenSource()).Token;
        _error = string.Empty;
        _loadFailed = false;

        var live = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _renderThrottle.Reset();
        var transitionRendered = false;

        try
        {
            await foreach (var s in TopicService.GetSubscriptionsAsync(TopicName, token))
            {
                if (token.IsCancellationRequested) break;
                if (!s.IsRefreshing) live.Add(s.Name);
                var idx = _subscriptions.FindIndex(x => x.Name == s.Name);
                if (idx >= 0) _subscriptions[idx] = s; else _subscriptions.Add(s);

                // Cached rows arrive in one burst, so force a render when the first live
                // row lands; after that the throttle paces the (network-bound) stream.
                var firstLive = !s.IsRefreshing && !transitionRendered;
                if (firstLive) transitionRendered = true;

                if (firstLive || _renderThrottle.ShouldRender())
                {
                    SortAndReanchor();
                    await InvokeAsync(StateHasChanged);
                }
            }

            if (!token.IsCancellationRequested)
                _subscriptions.RemoveAll(s => !live.Contains(s.Name));

            SortAndReanchor();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _loadFailed = true; _error = ex.Message; await InvokeAsync(StateHasChanged); }
    }

    private void SortAndReanchor()
    {
        var focused = _focusedItem;
        _subscriptions = [.. _subscriptions.OrderBy(s => s.Name)];
        if (focused is not null)
        {
            var newIdx = _subscriptions.FindIndex(s => s.Name == focused);
            if (newIdx >= 0) _selectedIndex = newIdx;
        }
        _focusedItem = _subscriptions.ElementAtOrDefault(_selectedIndex)?.Name;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (_deleteSub?.HandleKey(e) == true) return;
        if (_purgeDlq?.HandleKey(e) == true) return;
        switch (e.Key)
        {
            case "Escape": Nav.NavigateTo("/topics"); return;
            case "F5": _ = LoadSubscriptions(); return;
            case "F9": case "Delete": case "\\":
                if (_focusedItem is not null) _deleteSub!.Invoke(_focusedItem);
                return;
            case "F11":
                if (_focusedItem is not null) _purgeDlq!.Invoke(_focusedItem);
                return;
        }
    }
}
