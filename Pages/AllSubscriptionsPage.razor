@page "/subscriptions"
@namespace ServiceBusConsole.Pages
@implements IDisposable

@inject NavigationManager Nav
@inject NavigationState NavState
@inject ServiceBusConnection Connection
@inject ITopicService TopicService
@inject IMessageService MessageService
@inject RazorConsole.Core.Focus.FocusManager FocusManager

<FullscreenPage OnKeyDown="HandleKeyDown">
    <Content>
        <Panel BorderColor="@Color.Grey37" Expand="true" Padding="@(new(0, 0, 0, 0))">
            <Markup Content="All Subscriptions" Foreground="@Color.DodgerBlue1" Decoration="@Decoration.Bold" />
        </Panel>

        @if (_all.Count == 0 && _loadFailed)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="Failed to load. Press [F5] to retry." Foreground="@Color.Red" />
            </Padder>
        }
        else if (_all.Count == 0)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                    <Markup Content="Loading subscriptions..." Foreground="@Color.Grey" Decoration="@Decoration.Italic" />
                </Columns>
            </Padder>
        }
        else
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="@($"{_filtered.Count} subscription(s)")" Foreground="@Color.Grey" />
            </Padder>

            <Scrollable Items="@_filtered"
                        PageSize="@FullscreenLayout.PageSizeRoundedTableWithFilter()"
                        Scrollbar="new()"
                        SelectedIndex="@_selectedIndex"
                        SelectedIndexChanged="@(i => { _selectedIndex = i; _focusedItem = _filtered.ElementAtOrDefault(i); })"
                        OnActivate="@(() => { if (_filtered.ElementAtOrDefault(_selectedIndex) is {} s) { NavState.TopicName = s.TopicName; NavState.SubscriptionName = s.Name; NavState.ReturnPath = "/subscriptions"; Nav.NavigateTo("/subscription-browser"); } })">
                <SpectreTable Expand="true" Border="TableBorder.Rounded">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH Align="Justify.Left">Topic</SpectreTH>
                            <SpectreTH Align="Justify.Left">Subscription</SpectreTH>
                            <SpectreTH Align="Justify.Right">Active</SpectreTH>
                            <SpectreTH Align="Justify.Right">DLQ</SpectreTH>
                            <SpectreTH Align="Justify.Right">Transfer</SpectreTH>
                            <SpectreTH></SpectreTH>
                        </SpectreTR>
                    </SpectreTHead>
                    <SpectreTBody @ref="_tbody"
                                  Navigable="true"
                                  FocusOrder="1"
                                  RowCount="@context.Items.Count"
                                  OnKeyDown="@HandleKeyDown">
                        @{ var i = 0; }
                        @foreach (var s in context.Items)
                        {
                            var idx = i++;
                            <SpectreTR @key="@($"{s.TopicName}/{s.Name}")" RowIndex="@idx">
                                <SpectreTD>@s.TopicName</SpectreTD>
                                <SpectreTD>@s.Name</SpectreTD>
                                <SpectreTD Align="Justify.Right">@s.ActiveMessageCount</SpectreTD>
                                <SpectreTD Align="Justify.Right">@(s.DeadLetterMessageCount > 0 ? $"! {s.DeadLetterMessageCount}" : "0")</SpectreTD>
                                <SpectreTD Align="Justify.Right">@s.TransferMessageCount</SpectreTD>
                                <SpectreTD>@if (s.IsRefreshing) { <Spinner /> }</SpectreTD>
                            </SpectreTR>
                        }
                    </SpectreTBody>
                </SpectreTable>
            </Scrollable>
        }
    </Content>
    <Footer>
        <TextInput Value="@_filter"
                   ValueChanged="ApplyFilter"
                   OnFocus="@(_ => _filterFocused = true)"
                   OnBlur="@(_ => _filterFocused = false)"
                   Placeholder="Type to filter by topic or subscription..."
                   Expand="true"
                   FocusOrder="2" />

        <Padder Padding="@(new(1, 0, 0, 0))">
            <Columns>
                <TextButton Content="[F5] Refresh" OnClick="LoadSubscriptions" FocusedColor="@Color.Green" FocusOrder="3" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[F9] Delete" OnClick="@(() => _deleteSub!.Invoke(_focusedItem))" FocusedColor="@Color.Red" FocusOrder="4" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[F11] Purge DLQ" OnClick="@(() => _purgeDlq!.Invoke(_focusedItem))" FocusedColor="@Color.Red" FocusOrder="5" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[Esc] Back" OnClick="@(() => Nav.NavigateTo("/"))" FocusedColor="@Color.Yellow" FocusOrder="6" OnKeyDown="@HandleKeyDown" />
            </Columns>
        </Padder>
    </Footer>
</FullscreenPage>

<ErrorModal Message="@_error" OnDismiss="@(() => _error = string.Empty)" />

<AsyncCommand @ref="_deleteSub" TItem="SubscriptionInfo"
              ConfirmMessage="@(s => $"Delete subscription '{s!.Name}' from topic '{s.TopicName}'? This cannot be undone.")"
              Execute="@(s => TopicService.DeleteSubscriptionAsync(s!.TopicName, s.Name))"
              OnCompleted="@(s => { _all.RemoveAll(x => x.TopicName == s!.TopicName && x.Name == s.Name); _focusedItem = null; SortAndUpdateFilterState(); _selectedIndex = Math.Min(_selectedIndex, Math.Max(0, _filtered.Count - 1)); _focusedItem = _filtered.ElementAtOrDefault(_selectedIndex); StateHasChanged(); return Task.CompletedTask; })" />

<AsyncCommand @ref="_purgeDlq" TItem="SubscriptionInfo"
              ConfirmMessage="@(s => $"Purge ALL messages from DLQ of '{s!.TopicName}/{s.Name}'? This cannot be undone.")"
              Execute="@(s => MessageService.PurgeMessagesAsync(new MessageSource(s!.Name, IsDlq: true, s.TopicName, s.Name)))"
              OnCompleted="@(s => { if (_all.FirstOrDefault(x => x.TopicName == s!.TopicName && x.Name == s.Name) is {} x) x.DeadLetterMessageCount = 0; SortAndUpdateFilterState(); StateHasChanged(); return Task.CompletedTask; })" />

@code {
    private List<SubscriptionInfo> _all = [];
    private List<SubscriptionInfo> _filtered = [];
    private string? _filter;
    private bool _filterFocused;
    private int _selectedIndex;
    private SubscriptionInfo? _focusedItem;
    private string _error = string.Empty;
    private AsyncCommand<SubscriptionInfo>? _deleteSub;
    private AsyncCommand<SubscriptionInfo>? _purgeDlq;
    private bool _loadFailed;
    private CancellationTokenSource _cts = new();
    private string? _restoreFocusKey;
    private SpectreTBody? _tbody;
    private bool _tableAutoFocused;

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }


    protected override void OnInitialized()
    {
        if (Connection.CurrentNamespace is null)
            Nav.NavigateTo("/");
        if (NavState.TopicName is not null && NavState.SubscriptionName is not null)
            _restoreFocusKey = $"{NavState.TopicName}/{NavState.SubscriptionName}";
    }

    protected override async Task OnInitializedAsync() => await LoadSubscriptions();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_tableAutoFocused && _tbody is not null && _filtered.Count > 0)
        {
            _tableAutoFocused = true;
            await FocusManager.FocusAsync(_tbody.FocusKey);
        }
    }

    private async Task LoadSubscriptions()
    {
        _cts.Cancel();
        _cts = new CancellationTokenSource();
        _error = string.Empty;
        _loadFailed = false;

        var live = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var transitionRendered = false;

        try
        {
            await foreach (var s in TopicService.GetAllSubscriptionsAsync(_cts.Token))
            {
                var key = $"{s.TopicName}/{s.Name}";
                if (!s.IsRefreshing) live.Add(key);
                var idx = _all.FindIndex(x => x.TopicName == s.TopicName && x.Name == s.Name);
                if (idx >= 0) _all[idx] = s; else _all.Add(s);

                if (!s.IsRefreshing && !transitionRendered)
                {
                    transitionRendered = true;
                    SortAndUpdateFilterState();
                    await InvokeAsync(StateHasChanged);
                }
                else if (!s.IsRefreshing)
                {
                    SortAndUpdateFilterState();
                }
            }

            if (!_cts.IsCancellationRequested)
            {
                _all.RemoveAll(s => !live.Contains($"{s.TopicName}/{s.Name}"));
                SortAndUpdateFilterState();
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _loadFailed = true; _error = ex.Message; await InvokeAsync(StateHasChanged); }
    }

    private void SortAndUpdateFilterState()
    {
        var focused = _focusedItem;
        _all = [.. _all.OrderByDescending(s => s.TotalMessageCount).ThenBy(s => s.TopicName).ThenBy(s => s.Name)];
        _filtered = string.IsNullOrWhiteSpace(_filter) ? [.. _all]
            : _all.Where(s => s.TopicName.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                            || s.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();
        if (focused is null && _restoreFocusKey is not null)
        {
            focused = _filtered.FirstOrDefault(s => $"{s.TopicName}/{s.Name}" == _restoreFocusKey);
            if (focused is not null) _restoreFocusKey = null;
        }
        if (focused is not null)
        {
            var newIdx = _filtered.FindIndex(s => s.TopicName == focused.TopicName && s.Name == focused.Name);
            if (newIdx >= 0) _selectedIndex = newIdx;
        }
        _focusedItem = _filtered.ElementAtOrDefault(_selectedIndex);

    }

    private void ApplyFilter(string? value)
    {
        _filter = value;
        _selectedIndex = 0;
        _focusedItem = null;
        SortAndUpdateFilterState();
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (_deleteSub?.HandleKey(e) == true) return;
        if (_purgeDlq?.HandleKey(e) == true) return;
        switch (e.Key)
        {
            case "Escape": Nav.NavigateTo("/"); return;
            case "F5": _ = LoadSubscriptions(); return;
            case "F9": case "Delete": case "\\":
                if (_focusedItem is not null) _deleteSub!.Invoke(_focusedItem);
                return;
            case "F11":
                if (_focusedItem is not null) _purgeDlq!.Invoke(_focusedItem);
                return;
            case "Backspace":
                if (!_filterFocused) ApplyFilter(string.IsNullOrEmpty(_filter) ? null : _filter[..^1]);
                return;
            default:
                if (!_filterFocused && e.Key.Length == 1 && !char.IsControl(e.Key[0]))
                    ApplyFilter((_filter ?? "") + e.Key);
                break;
        }
    }
}
