@page "/queues"
@namespace ServiceBusConsole.Pages
@implements IDisposable

@inject NavigationManager Nav
@inject NavigationState NavState
@inject ServiceBusConnection Connection
@inject IQueueService QueueService
@inject IMessageService MessageService
@inject RazorConsole.Core.Focus.FocusManager FocusManager
@inject Microsoft.Extensions.Logging.ILogger<QueueListPage> Logger

<FullscreenPage OnKeyDown="HandleKeyDown">
    <Content>
        <Panel BorderColor="@Color.Grey37" Expand="true" Padding="@(new(0, 0, 0, 0))">
            <Markup Content="Queues" Foreground="@Color.DodgerBlue1" Decoration="@Decoration.Bold" />
        </Panel>

        @if (_all.Count == 0 && _loadFailed)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="Failed to load. Press [F5] to retry." Foreground="@Color.Red" />
            </Padder>
        }
        else if (_all.Count == 0)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                    <Markup Content="Loading queues..." Foreground="@Color.Grey" Decoration="@Decoration.Italic" />
                </Columns>
            </Padder>
        }
        else
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="@($"{_filtered.Count} queue(s)")" Foreground="@Color.Grey" />
            </Padder>

            <Scrollable Items="@_filtered"
                        PageSize="@FullscreenLayout.PageSizeRoundedTableWithFilter()"
                        Scrollbar="new()"
                        SelectedIndex="@_selectedIndex"
                        SelectedIndexChanged="@(i => { _selectedIndex = i; _focusedItem = _filtered.ElementAtOrDefault(i)?.Name; })"
                        OnActivate="@(() => { if (_filtered.ElementAtOrDefault(_selectedIndex) is {} q) { NavState.FocusedQueueName = q.Name; Nav.NavigateTo($"/queues/{Uri.EscapeDataString(q.Name)}"); } })">
                <SpectreTable Expand="true" Border="TableBorder.Rounded">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH Align="Justify.Left">Queue</SpectreTH>
                            <SpectreTH Align="Justify.Right">Active</SpectreTH>
                            <SpectreTH Align="Justify.Right">DLQ</SpectreTH>
                            <SpectreTH Align="Justify.Right">Scheduled</SpectreTH>
                            <SpectreTH Align="Justify.Right">Transfer</SpectreTH>
                            <SpectreTH></SpectreTH>
                        </SpectreTR>
                    </SpectreTHead>
                    <SpectreTBody @ref="_tbody"
                                  Navigable="true"
                                  FocusOrder="1"
                                  RowCount="@context.Items.Count"
                                  OnKeyDown="@HandleKeyDown">
                        @{ var i = 0; }
                        @foreach (var q in context.Items)
                        {
                            var idx = i++;
                            <SpectreTR @key="q.Name" RowIndex="@idx">
                                <SpectreTD>@q.Name</SpectreTD>
                                <SpectreTD Align="Justify.Right">@q.ActiveMessageCount</SpectreTD>
                                <SpectreTD Align="Justify.Right">@(q.DeadLetterMessageCount > 0 ? $"! {q.DeadLetterMessageCount}" : "0")</SpectreTD>
                                <SpectreTD Align="Justify.Right">@q.ScheduledMessageCount</SpectreTD>
                                <SpectreTD Align="Justify.Right">@q.TransferMessageCount</SpectreTD>
                                <SpectreTD>@if (q.IsRefreshing) { <Spinner /> }</SpectreTD>
                            </SpectreTR>
                        }
                    </SpectreTBody>
                </SpectreTable>
            </Scrollable>
        }
    </Content>
    <Footer>
        <TextInput Value="@_filter"
                   ValueChanged="ApplyFilter"
                   OnFocus="@(_ => _filterFocused = true)"
                   OnBlur="@(_ => _filterFocused = false)"
                   Placeholder="Type to filter..."
                   Expand="true"
                   FocusOrder="2" />

        <Padder Padding="@(new(1, 0, 0, 0))">
            <Columns>
                <TextButton Content="[F5] Refresh" OnClick="LoadQueues" FocusedColor="@Color.Green" FocusOrder="3" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[F9] Delete" OnClick="@(() => _deleteQueue!.Invoke(_focusedItem))" FocusedColor="@Color.Red" FocusOrder="4" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[F11] Purge DLQ" OnClick="@(() => _purgeDlq!.Invoke(_focusedItem))" FocusedColor="@Color.Red" FocusOrder="5" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[Esc] Back" OnClick="@(() => Nav.NavigateTo("/"))" FocusedColor="@Color.Yellow" FocusOrder="6" OnKeyDown="@HandleKeyDown" />
            </Columns>
        </Padder>
    </Footer>
</FullscreenPage>

<ErrorModal Message="@_error" OnDismiss="@(() => _error = string.Empty)" />

<AsyncCommand @ref="_deleteQueue" TItem="string"
              ConfirmMessage="@(n => $"Delete queue '{n}'? This cannot be undone.")"
              Execute="@(n => QueueService.DeleteQueueAsync(n!))"
              OnCompleted="@(n => { _all.RemoveAll(q => q.Name == n); UpdateFilterState(_filter); _selectedIndex = Math.Min(_selectedIndex, Math.Max(0, _filtered.Count - 1)); _focusedItem = _filtered.ElementAtOrDefault(_selectedIndex)?.Name; StateHasChanged(); return Task.CompletedTask; })" />

<AsyncCommand @ref="_purgeDlq" TItem="string"
              ConfirmMessage="@(n => $"Purge ALL messages from DLQ of '{n}'? This cannot be undone.")"
              Execute="@(n => MessageService.PurgeMessagesAsync(new MessageSource(n!, IsDlq: true)))"
              OnCompleted="@(n => { if (_all.FirstOrDefault(q => q.Name == n) is {} q) q.DeadLetterMessageCount = 0; UpdateFilterState(_filter); StateHasChanged(); return Task.CompletedTask; })" />

@code {
    private List<QueueInfo> _all = [];
    private List<QueueInfo> _filtered = [];
    private string? _filter;
    private bool _filterFocused;
    private int _selectedIndex;
    private string? _focusedItem;
    private string _error = string.Empty;
    private AsyncCommand<string>? _deleteQueue;
    private AsyncCommand<string>? _purgeDlq;
    private bool _loadFailed;
    private CancellationTokenSource _cts = new();
    private SpectreTBody? _tbody;
    private bool _tableAutoFocused;

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }


    protected override void OnInitialized()
    {
        if (Connection.CurrentNamespace is null)
            Nav.NavigateTo("/");
        _focusedItem = NavState.FocusedQueueName;
    }

    protected override async Task OnInitializedAsync() => await LoadQueues();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_tableAutoFocused && _tbody is not null && _filtered.Count > 0)
        {
            _tableAutoFocused = true;
            await FocusManager.FocusAsync(_tbody.FocusKey);
        }
    }

    private async Task LoadQueues()
    {
        var invocationId = Guid.NewGuid().ToString("N").AsSpan(0, 6).ToString();
        Logger.LogInformation("LoadQueues[{Inv}] START _all.Count={Count}", invocationId, _all.Count);
        _cts.Cancel();
        _cts = new CancellationTokenSource();
        _error = string.Empty;
        _loadFailed = false;

        var live = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var transitionRendered = false;
        var cached = 0;
        var liveCount = 0;

        try
        {
            await foreach (var q in QueueService.GetQueuesAsync(_cts.Token))
            {
                if (q.IsRefreshing) cached++; else { liveCount++; live.Add(q.Name); }
                var idx = _all.FindIndex(x => x.Name == q.Name);
                if (idx >= 0) _all[idx] = q; else _all.Add(q);

                if (!q.IsRefreshing && !transitionRendered)
                {
                    transitionRendered = true;
                    SortAndUpdateFilterState();
                    await InvokeAsync(StateHasChanged);
                }
                else if (!q.IsRefreshing)
                {
                    SortAndUpdateFilterState();
                }
            }

            if (!_cts.IsCancellationRequested)
            {
                _all.RemoveAll(q => !live.Contains(q.Name));
                SortAndUpdateFilterState();
            }
            await InvokeAsync(StateHasChanged);
            Logger.LogInformation("LoadQueues[{Inv}] END cached={Cached} live={Live} _all.Count={All} _filtered.Count={Filtered}",
                invocationId, cached, liveCount, _all.Count, _filtered.Count);
        }
        catch (OperationCanceledException) { Logger.LogInformation("LoadQueues[{Inv}] CANCELLED", invocationId); }
        catch (Exception ex) { _loadFailed = true; _error = ex.Message; await InvokeAsync(StateHasChanged); Logger.LogWarning(ex, "LoadQueues[{Inv}] FAILED", invocationId); }
    }

    private void SortAndUpdateFilterState()
    {
        _all = [.. _all.OrderByDescending(q => q.DeadLetterMessageCount).ThenBy(q => q.Name)];
        UpdateFilterState(_filter);
    }

    private void UpdateFilterState(string? value)
    {
        var currentFocus = _focusedItem;
        _filter = value;
        _filtered = string.IsNullOrWhiteSpace(value) ? [.. _all]
            : _all.Where(q => q.Name.Contains(value, StringComparison.OrdinalIgnoreCase)).ToList();
        if (currentFocus is not null)
        {
            var idx = _filtered.FindIndex(q => q.Name == currentFocus);
            if (idx >= 0) _selectedIndex = idx;
        }
        _focusedItem = _filtered.ElementAtOrDefault(_selectedIndex)?.Name;
    }

    private void ApplyFilter(string? value)
    {
        _selectedIndex = 0;
        _focusedItem = null;
        UpdateFilterState(value);
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (_deleteQueue?.HandleKey(e) == true) return;
        if (_purgeDlq?.HandleKey(e) == true) return;
        switch (e.Key)
        {
            case "Escape": Nav.NavigateTo("/"); return;
            case "F5": _ = LoadQueues(); return;
            case "F9": case "Delete": case "\\":
                if (_focusedItem is not null) _deleteQueue!.Invoke(_focusedItem);
                return;
            case "F11":
                if (_focusedItem is not null) _purgeDlq!.Invoke(_focusedItem);
                return;
            case "Backspace":
                if (!_filterFocused) ApplyFilter(string.IsNullOrEmpty(_filter) ? null : _filter[..^1]);
                return;
            default:
                if (!_filterFocused && e.Key.Length == 1 && !char.IsControl(e.Key[0]))
                    ApplyFilter((_filter ?? "") + e.Key);
                break;
        }
    }
}
