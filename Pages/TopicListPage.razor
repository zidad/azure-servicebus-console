@page "/topics"
@namespace ServiceBusConsole.Pages
@implements IDisposable

@inject NavigationManager Nav
@inject NavigationState NavState
@inject ServiceBusConnection Connection
@inject ITopicService TopicService
@inject RazorConsole.Core.Focus.FocusManager FocusManager
@inject ITerminalViewport Viewport
@inject LiveCountsOptions LiveCounts
@inject Microsoft.Extensions.Logging.ILogger<TopicListPage> Logger

<FullscreenPage OnKeyDown="HandleKeyDown">
    <Header>
        <SectionCrumb Section="@Section.Topics" Current="true" />
        @if (_all.Count > 0) { <Markup Content="@ConnectionHeader.Count(_filtered.Count, _all.Count)" Foreground="@Theme.Muted" /> }
    </Header>
    <Content>
        @if (_all.Count == 0 && _loadFailed)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="Failed to load. Press [F5] to retry." Foreground="@Theme.Danger" />
            </Padder>
        }
        else if (_all.Count == 0)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                    <Markup Content="Loading topics..." Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
                </Columns>
            </Padder>
        }
        else
        {
            <Scrollable Items="@_filtered"
                        PageSize="@FullscreenLayout.PageSizeRoundedTable(Viewport.Height)"
                        Scrollbar="new()"
                        SelectedIndex="@_selectedIndex"
                        SelectedIndexChanged="@(i => { _selectedIndex = i; _focusedItem = _filtered.ElementAtOrDefault(i)?.Name; })"
                        OnActivate="@(() => { if (_filtered.ElementAtOrDefault(_selectedIndex) is {} t) { NavState.TopicName = t.Name; Nav.NavigateTo("/topic-detail"); } })">
                <SpectreTable Expand="true" Border="TableBorder.Rounded">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH Align="Justify.Left"><Columns><SortHeader Label="Topic" Sort="_sort" OnSorted="@(() => UpdateFilterState(_filter))" /><ColumnFilter Filter="@_filter" /></Columns></SpectreTH>
                            <SpectreTH Align="Justify.Right"><SortHeader Label="Subscriptions" Icon="@Icons.Subscription" Sort="_sort" OnSorted="@(() => UpdateFilterState(_filter))" /></SpectreTH>
                            <SpectreTH Align="Justify.Right"><SortHeader Label="Scheduled" Icon="@Icons.Scheduled" Sort="_sort" OnSorted="@(() => UpdateFilterState(_filter))" /></SpectreTH>
                            <SpectreTH></SpectreTH>
                        </SpectreTR>
                    </SpectreTHead>
                    <SpectreTBody @ref="_tbody"
                                  Navigable="true"
                                  FocusOrder="1"
                                  RowCount="@context.Items.Count"
                                  OnKeyDown="@HandleKeyDown">
                        @{ var i = 0; }
                        @foreach (var t in context.Items)
                        {
                            var idx = i++;
                            <SpectreTR @key="t.Name" RowIndex="@idx">
                                <SpectreTD>@t.Name</SpectreTD>
                                <SpectreTD Align="Justify.Right"><CountCell Value="@t.SubscriptionCount" Highlight="@List.Changes.Highlight(t, "Subscriptions")" /></SpectreTD>
                                <SpectreTD Align="Justify.Right"><CountCell Value="@t.ScheduledMessageCount" Color="@Theme.Scheduled" Highlight="@List.Changes.Highlight(t, "Scheduled")" /></SpectreTD>
                                <SpectreTD>@if (t.IsRefreshing) { <Spinner /> }</SpectreTD>
                            </SpectreTR>
                        }
                    </SpectreTBody>
                </SpectreTable>
            </Scrollable>
        }
    </Content>
    <Footer>
        <Padder Padding="@(new(1, 0, 0, 0))">
            <Columns>
                <TextButton Content="[F5] 🔄 Refresh" OnClick="LoadTopics" FocusedColor="@Theme.Success" FocusOrder="3" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[F9] ❌ Delete" OnClick="@(() => _deleteTopic!.Invoke(_focusedItem))" FocusedColor="@Theme.Danger" FocusOrder="4" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[Esc] 🔙 Back" OnClick="@(() => Nav.NavigateTo("/"))" FocusedColor="@Theme.Accent" FocusOrder="5" OnKeyDown="@HandleKeyDown" />
            </Columns>
        </Padder>
    </Footer>
</FullscreenPage>

<ErrorModal Message="@_error" OnDismiss="@(() => _error = string.Empty)" />

<AsyncCommand @ref="_deleteTopic" TItem="string"
              ConfirmMessage="@(n => $"Delete topic '{n}' and all its subscriptions? This cannot be undone.")"
              Execute="@(n => TopicService.DeleteTopicAsync(n!))"
              OnCompleted="@(n => { _all.RemoveAll(t => t.Name == n); UpdateFilterState(_filter); _selectedIndex = Math.Min(_selectedIndex, Math.Max(0, _filtered.Count - 1)); _focusedItem = _filtered.ElementAtOrDefault(_selectedIndex)?.Name; StateHasChanged(); return Task.CompletedTask; })" />

@code {
    private LiveList<TopicInfo>? _live;
    private LiveList<TopicInfo> List => _live ?? throw new InvalidOperationException("Topic list not initialized");
    private List<TopicInfo> _all => List.All;
    private List<TopicInfo> _filtered = [];
    private string? _filter;
    private int _selectedIndex;
    private string? _focusedItem;
    private string _error = string.Empty;
    private AsyncCommand<string>? _deleteTopic;
    private bool _loadFailed;
    private SpectreTBody? _tbody;
    private bool _tableAutoFocused;
    private readonly TableSort<TopicInfo> _sort = new TableSort<TopicInfo>(ts => ts)
        .Add("Topic", t => t.Name, StringComparer.OrdinalIgnoreCase)
        .Add("Subscriptions", t => t.SubscriptionCount)
        .Add("Scheduled", t => t.ScheduledMessageCount);

    public void Dispose() => _live?.Dispose();


    protected override void OnInitialized()
    {
        _live = new LiveList<TopicInfo>(TopicService.GetTopicsAsync, t => t.Name, x => x.IsRefreshing,
            new(t => t.Name, ("Subscriptions", x => x.SubscriptionCount), ("Scheduled", x => x.ScheduledMessageCount)),
            LiveCounts, Logger)
        {
            Changed = () => { UpdateFilterState(_filter); return InvokeAsync(StateHasChanged); },
            Render = StateHasChanged,
            LoadFailed = ex => { _loadFailed = true; _error = ex.Message; return InvokeAsync(StateHasChanged); },
        };
        if (Connection.CurrentNamespace is null)
            Nav.NavigateTo("/");
        _focusedItem = NavState.TopicName;
    }

    protected override async Task OnInitializedAsync() => await LoadTopics();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_tableAutoFocused && _tbody is not null && _filtered.Count > 0)
        {
            _tableAutoFocused = true;
            await FocusManager.FocusAsync(_tbody.FocusKey);
        }
    }

    private Task LoadTopics()
    {
        _error = string.Empty;
        _loadFailed = false;
        return List.LoadAsync();
    }

    private void UpdateFilterState(string? value)
    {
        var currentFocus = _focusedItem;
        _filter = value;
        _filtered = _sort.Apply(string.IsNullOrWhiteSpace(value) ? _all
            : _all.Where(t => t.Name.Contains(value, StringComparison.OrdinalIgnoreCase)));
        if (currentFocus is not null)
        {
            var idx = _filtered.FindIndex(t => t.Name == currentFocus);
            if (idx >= 0) _selectedIndex = idx;
        }
        _focusedItem = _filtered.ElementAtOrDefault(_selectedIndex)?.Name;
    }

    private void ApplyFilter(string? value)
    {
        _selectedIndex = 0;
        _focusedItem = null;
        UpdateFilterState(value);
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (_deleteTopic?.HandleKey(e) == true) return;
        switch (e.Key)
        {
            case "Escape": Nav.NavigateTo("/"); return;
            case "F5": _ = LoadTopics(); return;
            case "F9": case "Delete": case "\\":
                if (_focusedItem is not null) _deleteTopic!.Invoke(_focusedItem);
                return;
            case "Backspace":
                ApplyFilter(string.IsNullOrEmpty(_filter) ? null : _filter[..^1]);
                return;
            default:
                if (e.Key.Length == 1 && !char.IsControl(e.Key[0]))
                    ApplyFilter((_filter ?? "") + e.Key);
                break;
        }
    }
}
