@page "/topics"
@namespace ServiceBusConsole.Pages
@implements IDisposable

@inject NavigationManager Nav
@inject NavigationState NavState
@inject ServiceBusConnection Connection
@inject ITopicService TopicService
@inject RazorConsole.Core.Focus.FocusManager FocusManager

<FullscreenPage OnKeyDown="HandleKeyDown">
    <Content>
        <Panel BorderColor="@Color.Grey37" Expand="true" Padding="@(new(0, 0, 0, 0))">
            <Markup Content="Topics" Foreground="@Color.DodgerBlue1" Decoration="@Decoration.Bold" />
        </Panel>

        @if (_all.Count == 0 && _loadFailed)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="Failed to load. Press [F5] to retry." Foreground="@Color.Red" />
            </Padder>
        }
        else if (_all.Count == 0)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                    <Markup Content="Loading topics..." Foreground="@Color.Grey" Decoration="@Decoration.Italic" />
                </Columns>
            </Padder>
        }
        else
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="@($"{_filtered.Count} topic(s)")" Foreground="@Color.Grey" />
            </Padder>

            <Scrollable Items="@_filtered"
                        PageSize="@FullscreenLayout.PageSizeRoundedTableWithFilter()"
                        Scrollbar="new()"
                        SelectedIndex="@_selectedIndex"
                        SelectedIndexChanged="@(i => { _selectedIndex = i; _focusedItem = _filtered.ElementAtOrDefault(i)?.Name; })"
                        OnActivate="@(() => { if (_filtered.ElementAtOrDefault(_selectedIndex) is {} t) { NavState.TopicName = t.Name; Nav.NavigateTo("/topic-detail"); } })">
                <SpectreTable Expand="true" Border="TableBorder.Rounded">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH Align="Justify.Left">Topic</SpectreTH>
                            <SpectreTH Align="Justify.Right">Subscriptions</SpectreTH>
                            <SpectreTH Align="Justify.Right">Scheduled</SpectreTH>
                            <SpectreTH></SpectreTH>
                        </SpectreTR>
                    </SpectreTHead>
                    <SpectreTBody @ref="_tbody"
                                  Navigable="true"
                                  FocusOrder="1"
                                  RowCount="@context.Items.Count"
                                  OnKeyDown="@HandleKeyDown">
                        @{ var i = 0; }
                        @foreach (var t in context.Items)
                        {
                            var idx = i++;
                            <SpectreTR @key="t.Name" RowIndex="@idx">
                                <SpectreTD>@t.Name</SpectreTD>
                                <SpectreTD Align="Justify.Right">@t.SubscriptionCount</SpectreTD>
                                <SpectreTD Align="Justify.Right">@t.ScheduledMessageCount</SpectreTD>
                                <SpectreTD>@if (t.IsRefreshing) { <Spinner /> }</SpectreTD>
                            </SpectreTR>
                        }
                    </SpectreTBody>
                </SpectreTable>
            </Scrollable>
        }
    </Content>
    <Footer>
        <TextInput Value="@_filter"
                   ValueChanged="ApplyFilter"
                   OnFocus="@(_ => _filterFocused = true)"
                   OnBlur="@(_ => _filterFocused = false)"
                   Placeholder="Type to filter..."
                   Expand="true"
                   FocusOrder="2" />

        <Padder Padding="@(new(1, 0, 0, 0))">
            <Columns>
                <TextButton Content="[F5] Refresh" OnClick="LoadTopics" FocusedColor="@Color.Green" FocusOrder="3" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[F9] Delete" OnClick="@(() => _deleteTopic!.Invoke(_focusedItem))" FocusedColor="@Color.Red" FocusOrder="4" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <TextButton Content="[Esc] Back" OnClick="@(() => Nav.NavigateTo("/"))" FocusedColor="@Color.Yellow" FocusOrder="5" OnKeyDown="@HandleKeyDown" />
            </Columns>
        </Padder>
    </Footer>
</FullscreenPage>

<ErrorModal Message="@_error" OnDismiss="@(() => _error = string.Empty)" />

<AsyncCommand @ref="_deleteTopic" TItem="string"
              ConfirmMessage="@(n => $"Delete topic '{n}' and all its subscriptions? This cannot be undone.")"
              Execute="@(n => TopicService.DeleteTopicAsync(n!))"
              OnCompleted="@(n => { _all.RemoveAll(t => t.Name == n); UpdateFilterState(_filter); _selectedIndex = Math.Min(_selectedIndex, Math.Max(0, _filtered.Count - 1)); _focusedItem = _filtered.ElementAtOrDefault(_selectedIndex)?.Name; StateHasChanged(); return Task.CompletedTask; })" />

@code {
    private List<TopicInfo> _all = [];
    private List<TopicInfo> _filtered = [];
    private string? _filter;
    private bool _filterFocused;
    private int _selectedIndex;
    private string? _focusedItem;
    private string _error = string.Empty;
    private AsyncCommand<string>? _deleteTopic;
    private bool _loadFailed;
    private CancellationTokenSource _cts = new();
    private readonly RenderThrottle _renderThrottle = new();
    private SpectreTBody? _tbody;
    private bool _tableAutoFocused;

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }


    protected override void OnInitialized()
    {
        if (Connection.CurrentNamespace is null)
            Nav.NavigateTo("/");
        _focusedItem = NavState.TopicName;
    }

    protected override async Task OnInitializedAsync() => await LoadTopics();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_tableAutoFocused && _tbody is not null && _filtered.Count > 0)
        {
            _tableAutoFocused = true;
            await FocusManager.FocusAsync(_tbody.FocusKey);
        }
    }

    private async Task LoadTopics()
    {
        // Take the token for *this* run: F5 replaces the field, and a superseded run
        // must not read the new run's token and conclude it was never cancelled.
        _cts.Cancel();
        var token = (_cts = new CancellationTokenSource()).Token;
        _error = string.Empty;
        _loadFailed = false;

        var live = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _renderThrottle.Reset();
        var transitionRendered = false;

        try
        {
            await foreach (var t in TopicService.GetTopicsAsync(token))
            {
                if (token.IsCancellationRequested) break;
                if (!t.IsRefreshing) live.Add(t.Name);
                var idx = _all.FindIndex(x => x.Name == t.Name);
                if (idx >= 0) _all[idx] = t; else _all.Add(t);

                // Cached rows arrive in one burst, so force a render when the first live
                // row lands; after that the throttle paces the (network-bound) stream.
                var firstLive = !t.IsRefreshing && !transitionRendered;
                if (firstLive) transitionRendered = true;

                if (firstLive || _renderThrottle.ShouldRender())
                {
                    UpdateFilterState(_filter);
                    await InvokeAsync(StateHasChanged);
                }
            }

            if (!token.IsCancellationRequested)
            {
                _all.RemoveAll(t => !live.Contains(t.Name));
                UpdateFilterState(_filter);
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _loadFailed = true; _error = ex.Message; await InvokeAsync(StateHasChanged); }
    }

    private void UpdateFilterState(string? value)
    {
        var currentFocus = _focusedItem;
        _filter = value;
        _filtered = string.IsNullOrWhiteSpace(value) ? [.. _all]
            : _all.Where(t => t.Name.Contains(value, StringComparison.OrdinalIgnoreCase)).ToList();
        if (currentFocus is not null)
        {
            var idx = _filtered.FindIndex(t => t.Name == currentFocus);
            if (idx >= 0) _selectedIndex = idx;
        }
        _focusedItem = _filtered.ElementAtOrDefault(_selectedIndex)?.Name;
    }

    private void ApplyFilter(string? value)
    {
        _selectedIndex = 0;
        _focusedItem = null;
        UpdateFilterState(value);
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (_deleteTopic?.HandleKey(e) == true) return;
        switch (e.Key)
        {
            case "Escape": Nav.NavigateTo("/"); return;
            case "F5": _ = LoadTopics(); return;
            case "F9": case "Delete": case "\\":
                if (_focusedItem is not null) _deleteTopic!.Invoke(_focusedItem);
                return;
            case "Backspace":
                if (!_filterFocused) ApplyFilter(string.IsNullOrEmpty(_filter) ? null : _filter[..^1]);
                return;
            default:
                if (!_filterFocused && e.Key.Length == 1 && !char.IsControl(e.Key[0]))
                    ApplyFilter((_filter ?? "") + e.Key);
                break;
        }
    }
}
