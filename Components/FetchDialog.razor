@namespace LLMAgentTUI.Components
@inject RazorConsole.Core.Focus.FocusManager FocusManager

<ModalWindow IsOpened="@IsOpened">
    <Panel Title="@(IsReceive ? "Receive messages" : "Peek messages")" BorderColor="@(IsReceive && _deleteOnReceive ? Color.Red : Color.DodgerBlue1)" Padding="@(new(2, 1, 2, 1))">
        <Rows @onkeydown="HandleKey">
            <TextInput @ref="_countInput" FillWidth="true" Label="Number of messages" Value="@_count" ValueChanged="@(v => _count = v ?? "")"
                       OnSubmit="@(_ => Submit())" FocusOrder="100" />
            @if (IsReceive)
            {
                <Padder Padding="@(new(0, 1, 0, 0))">
                    <Columns>
                        <Markup Content="Receive mode: " />
                        <TextButton Content="@(_deleteOnReceive ? "ReceiveAndDelete" : "PeekLock")"
                                    OnClick="@(() => _deleteOnReceive = !_deleteOnReceive)"
                                    FocusedColor="@(_deleteOnReceive ? Color.Red : Color.Green)" FocusOrder="101" />
                        <Markup Content="  (Enter/click to switch)" Foreground="@Color.Grey" />
                    </Columns>
                </Padder>
                @if (_deleteOnReceive)
                {
                    <Markup Content="Messages are deleted from the entity as they are received. Requeue them before you leave, or they are gone." Foreground="@Color.Red" />
                }
                else
                {
                    <Markup Content="Messages stay locked (renewed automatically) until you complete, abandon, dead-letter or requeue them." Foreground="@Color.Grey" />
                }
            }
            else
            {
                <TextInput FillWidth="true" Label="From sequence # (optional)" Value="@_from" ValueChanged="@(v => _from = v ?? "")"
                           OnSubmit="@(_ => Submit())" FocusOrder="101" />
            }
            @if (_error.Length > 0)
            {
                <Markup Content="@_error" Foreground="@Color.Red" />
            }
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <TextButton Content="[Enter] OK" OnClick="Submit" FocusedColor="@Color.Green" FocusOrder="102" />
                    <Markup Content="   " />
                    <TextButton Content="[Esc] Cancel" OnClick="Cancel" FocusedColor="@Color.Grey" FocusOrder="103" />
                </Columns>
            </Padder>
        </Rows>
    </Panel>
</ModalWindow>

@code {
    public const int MaxCount = 5000;

    public sealed record Request(int Count, long? FromSequenceNumber, bool DeleteOnReceive);

    [Parameter] public bool IsReceive { get; set; }
    [Parameter] public int DefaultCount { get; set; } = 100;
    [Parameter] public EventCallback<Request> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    public bool IsOpened { get; private set; }

    private TextInput? _countInput;
    private bool _focusPending;
    private string _count = "";
    private string _from = "";
    private bool _deleteOnReceive;
    private string _error = "";

    protected override void OnInitialized() => _count = DefaultCount.ToString();

    public void Open()
    {
        IsOpened = true;
        _deleteOnReceive = false;
        _error = "";
        _focusPending = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending || _countInput is null) return;
        _focusPending = false;
        for (var i = 0; i < 3; i++)
        {
            if (await FocusManager.FocusAsync(_countInput.FocusKey)) break;
            await Task.Delay(16);
        }
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _ = Cancel();
    }

    private async Task Submit()
    {
        if (!IsOpened) return;
        if (!int.TryParse(_count.Trim(), out var count) || count < 1 || count > MaxCount)
        {
            _error = $"Enter a number between 1 and {MaxCount}.";
            return;
        }
        long? from = null;
        if (!IsReceive && _from.Trim().Length > 0)
        {
            if (!long.TryParse(_from.Trim(), out var seq) || seq < 0)
            {
                _error = "Sequence number must be a positive number.";
                return;
            }
            from = seq;
        }
        IsOpened = false;
        await OnSubmit.InvokeAsync(new Request(count, from, IsReceive && _deleteOnReceive));
    }

    private async Task Cancel()
    {
        if (!IsOpened) return;
        IsOpened = false;
        await OnCancel.InvokeAsync();
    }
}
