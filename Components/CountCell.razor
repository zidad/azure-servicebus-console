@namespace LLMAgentTUI.Components

<Markup Content="@Text" Foreground="@(Value > 0 ? Color : Theme.Muted)" Decoration="@(Value > 0 && Bold ? Decoration.Bold : Decoration.None)" />

@code {
    /// <summary>A message count: muted when zero, in <see cref="Color"/> otherwise.</summary>
    [Parameter] public long Value { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Default;
    [Parameter] public bool Bold { get; set; }

    private string Text => Value.ToString("N0");
}
