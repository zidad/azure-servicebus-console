@namespace LLMAgentTUI.Components
@inject RazorConsole.Core.Focus.FocusManager FocusManager

@if (Operation is { Modal: true } op)
{
    var nameWidth = op.Steps.Max(s => s.Name.Length);
    <ModalWindow IsOpened="true">
        <Panel Title="@op.Title" BorderColor="@(op.Finished ? OutcomeColor(op.Outcome) : Theme.Accent)" Padding="@(new(2, 1, 2, 1))">
            <Rows>
                @foreach (var step in op.Steps)
                {
                    <Columns>
                        <Markup Content="@StateIcon(step)" Foreground="@Theme.Muted" />
                        <Markup Content="@step.Name.PadRight(nameWidth)" Foreground="@(step.State == StepState.Pending ? Theme.Muted : Color.Default)" />
                        @if (step.Total > 0)
                        {
                            <Markup Content="@Bar(step)" Foreground="@(step.State == StepState.Done ? Theme.Success : Theme.Accent)" />
                            <Markup Content="@($"{step.Done:N0}/{step.Total:N0}")" Foreground="@Theme.Muted" />
                        }
                        else if (step.Done > 0)
                        {
                            <Markup Content="@($"{step.Done:N0} so far")" Foreground="@Theme.Muted" />
                        }
                    </Columns>
                }
                <Padder Padding="@(new(0, 1, 0, 0))">
                    @if (op.Finished)
                    {
                        <Rows>
                            <Markup Content="@($"{OutcomeIcon(op.Outcome)} {op.Result}")" Foreground="@OutcomeColor(op.Outcome)" />
                            <Padder Padding="@(new(0, 1, 0, 0))">
                                <TextButton @ref="_ok" Content="[Enter] OK" OnClick="@(() => OnDismiss.InvokeAsync())"
                                            FocusedColor="@Theme.Accent" FocusOrder="1" OnKeyDown="@OkKeyDown" />
                            </Padder>
                        </Rows>
                    }
                    else
                    {
                        <Markup Content="@(op.Cancelled ? "Cancelling… finishing what is in flight" : "[Esc] Cancel")" Foreground="@(op.Cancelled ? Theme.Warning : Theme.Muted)" />
                    }
                </Padder>
            </Rows>
        </Panel>
    </ModalWindow>
}

@code {
    private const int BarWidth = 20;

    /// <summary>The batch operation to show; nothing renders while it is null.</summary>
    [Parameter] public OperationProgress? Operation { get; set; }

    /// <summary>OK (or Esc) on a finished operation.</summary>
    [Parameter] public EventCallback OnDismiss { get; set; }

    private TextButton? _ok;
    private OperationProgress? _focused;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Operation is { Modal: true, Finished: true } op && op != _focused && _ok is not null)
        {
            _focused = op;
            await FocusManager.FocusAsync(_ok.FocusKey);
        }
    }

    private void OkKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _ = OnDismiss.InvokeAsync();
    }

    private static string StateIcon(OperationStep step) => step.State switch
    {
        StepState.Done => Icons.Done,
        StepState.Running => Icons.Running,
        _ => Icons.Pending,
    };

    private static string OutcomeIcon(OperationOutcome outcome) => outcome switch
    {
        OperationOutcome.Succeeded => Icons.Done,
        OperationOutcome.Cancelled => Icons.Cancelled,
        _ => Icons.Error,
    };

    private static Color OutcomeColor(OperationOutcome outcome) => outcome switch
    {
        OperationOutcome.Succeeded => Theme.Success,
        OperationOutcome.Cancelled => Theme.Warning,
        _ => Theme.Danger,
    };

    private static string Bar(OperationStep step)
    {
        var filled = step.Total == 0 ? 0 : Math.Min(BarWidth, step.Done * BarWidth / step.Total);
        return new string('█', filled) + new string('░', BarWidth - filled);
    }
}
