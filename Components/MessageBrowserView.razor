@namespace LLMAgentTUI.Components
@implements IDisposable
@inject NavigationManager Nav
@inject MessageBrowserStore Store
@inject NavigationState NavState
@inject RazorConsole.Core.Focus.FocusManager FocusManager
@inject ITerminalViewport Viewport

<FullscreenPage OnKeyDown="HandleKeyDown">
    <Header>
        @Breadcrumb
        @if (_isDlq) { <Markup Content="@($"{Icons.DeadLetter} DLQ")" Foreground="@Theme.Danger" Decoration="@Decoration.Bold" /> }
        @if (_browser is { } header)
        {
            <Markup Content="·" Foreground="@Theme.Muted" />
            <Markup Content="@ModeLabel(header.Mode)" Foreground="@ModeColor(header.Mode)" />
        }
        @if (_isAutoForwarding) { <Markup Content="@($"· {Icons.Transfer} auto-forwarding")" Foreground="@Theme.Transfer" /> }
    </Header>
    <Content>
        @* A load shows the spinner only until its first page arrives; then the list fills in. *@
        @if (_browser is not { } browser || (_loading is not null && browser.Messages.Count == 0))
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                    <Markup Content="@(_loading ?? "Loading…")" Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
                    @if (_loading is not null) { <Markup Content="· Esc cancels" Foreground="@Theme.Muted" /> }
                </Columns>
            </Padder>
        }
        else if (browser.Messages.Count > 0)
        {
            var showChecks = browser.Selected.Count > 0;
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <Markup Content="@StatusCount(browser)" Foreground="@(browser.Mode == BrowseMode.Received ? Theme.Danger : Color.Default)" />
                    @if (browser.Selected.Count > 0)
                    {
                        <Markup Content="@($"· {Icons.Selected} {browser.Selected.Count} selected")" Foreground="@Theme.Accent" Decoration="@Decoration.Bold" />
                    }
                    @if (browser.Operation is { Modal: false } load)
                    {
                        <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                        <Markup Content="@($"{load.Title}: {load.Steps[0].Done:N0} so far · Esc cancels")" Foreground="@Theme.Warning" />
                    }
                    else
                    {
                        <Markup Content="· Space select, A all, I invert" Foreground="@Theme.Muted" />
                    }
                </Columns>
            </Padder>

            <Scrollable Items="@browser.Messages"
                        PageSize="@Split.Rows"
                        Scrollbar="new()"
                        SelectedIndex="@browser.Cursor"
                        SelectedIndexChanged="@(i => browser.Cursor = i)"
                        OnToggle="@(i => ToggleAt(i))"
                        OnActivate="@(() => { if (browser.Operation is not { Modal: true } && browser.Focused is { } m) ViewMessage(m); })">
                <SpectreTable Expand="true" Border="TableBorder.Simple">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH Width="4"><div class="check-all" @onclick="ToggleAll">@(browser.AllSelected ? Icons.Selected : Icons.Unselected)</div></SpectreTH>
                            <SpectreTH Align="Justify.Right">#</SpectreTH>
                            <SpectreTH Align="Justify.Left">Message ID</SpectreTH>
                            <SpectreTH Align="Justify.Left">Subject</SpectreTH>
                            @if (_isDlq) { <SpectreTH Align="Justify.Left">Reason</SpectreTH> }
                            <SpectreTH Align="Justify.Left">Enqueued</SpectreTH>
                            <SpectreTH Align="Justify.Right">Delivery</SpectreTH>
                            @if (browser.Mode == BrowseMode.Locked) { <SpectreTH Align="Justify.Left">Lock</SpectreTH> }
                        </SpectreTR>
                    </SpectreTHead>
                    <SpectreTBody @ref="_tbody"
                                  Navigable="true"
                                  FocusOrder="1"
                                  RowCount="@context.Items.Count"
                                  OnKeyDown="@HandleKeyDown">
                        @{ var i = 0; }
                        @foreach (var m in context.Items)
                        {
                            var idx = i++;
                            var isCursor = context.CurrentOffset + idx == browser.Cursor;
                            var selected = browser.IsSelected(m);
                            <SpectreTR @key="m.SequenceNumber" RowIndex="@idx">
                                <SpectreTD>
                                    @if (showChecks || isCursor)
                                    {
                                        <div class="check" @onclick="@ToggleHandler(m)" @onclick:stopPropagation="true">@(selected ? Icons.Selected : Icons.Unselected)</div>
                                    }
                                </SpectreTD>
                                <SpectreTD Align="Justify.Right">@m.SequenceNumber</SpectreTD>
                                <SpectreTD>@Truncate(m.MessageId, 30)</SpectreTD>
                                <SpectreTD>@Truncate(m.Subject, 25)</SpectreTD>
                                @if (_isDlq) { <SpectreTD><Markup Content="@Truncate(m.DeadLetterReason ?? "", 25)" Foreground="@Theme.Danger" /></SpectreTD> }
                                <SpectreTD>@m.EnqueuedTime.LocalDateTime.ToString("MM-dd HH:mm:ss")</SpectreTD>
                                <SpectreTD Align="Justify.Right"><Markup Content="@m.DeliveryCount.ToString()" Foreground="@(m.DeliveryCount > 1 ? Theme.Warning : Theme.Muted)" /></SpectreTD>
                                @if (browser.Mode == BrowseMode.Locked)
                                {
                                    <SpectreTD>
                                        <Markup Content="@(browser.IsLockHeld(m) ? $"{Icons.Locked} held" : $"{Icons.Unlocked} lost")"
                                                Foreground="@(browser.IsLockHeld(m) ? Theme.Success : Theme.Danger)" />
                                    </SpectreTD>
                                }
                            </SpectreTR>
                        }
                    </SpectreTBody>
                </SpectreTable>
            </Scrollable>

            @if (browser.Focused is { } focused)
            {
                <MessagePreview Message="@focused" Browser="@browser" Width="@Viewport.Width" Height="@PreviewHeight(browser)" BodyFocusOrder="2" OnKeyDown="@HandleKeyDown" />
            }
        }
        else
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="@(_isAutoForwarding ? "Auto-forwarding enabled — messages are forwarded to another entity." : EmptyText(browser.Mode))"
                        Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
            </Padder>
        }
    </Content>
    <Footer>
        <Padder Padding="@(new(1, 0, 0, 0))">
            <Columns>
                <TextButton Content="@($"[F7] {Icons.Peek} Peek…")" OnClick="@(() => _peekDialog?.Open())" FocusedColor="@Theme.Success" FocusOrder="2" OnKeyDown="@HandleKeyDown" />
                <Markup Content="  " />
                <TextButton Content="@($"[F8] {Icons.Subscription} Receive…")" OnClick="@(() => _receiveDialog?.Open())" FocusedColor="@Theme.Danger" FocusOrder="3" OnKeyDown="@HandleKeyDown" />
                <Markup Content="  " />
                <TextButton Content="@(_isDlq ? $"[F6] {Icons.Queue} View Active" : $"[F6] {Icons.DeadLetter} View DLQ")" OnClick="@(() => { _ = SwitchDlq(!_isDlq); })" FocusedColor="@Theme.Warning" FocusOrder="4" OnKeyDown="@HandleKeyDown" />
                <Markup Content="  " />
                @if (Mode == BrowseMode.Locked)
                {
                    <TextButton Content="@($"[F9] {Icons.Complete} Complete")" OnClick="@(() => Run(_complete))" FocusedColor="@Theme.Danger" FocusOrder="5" OnKeyDown="@HandleKeyDown" />
                    <Markup Content="  " />
                    <TextButton Content="@($"[F4] {Icons.Unlocked} Abandon")" OnClick="@(() => Run(_abandon))" FocusedColor="@Theme.Warning" FocusOrder="6" OnKeyDown="@HandleKeyDown" />
                    <Markup Content="  " />
                    @if (!_isDlq)
                    {
                        <TextButton Content="@($"[F3] {Icons.DeadLetter} Dead-letter")" OnClick="@(() => Run(_deadLetter))" FocusedColor="@Theme.Danger" FocusOrder="7" OnKeyDown="@HandleKeyDown" />
                        <Markup Content="  " />
                    }
                }
                @if (CanRetry)
                {
                    <TextButton Content="@($"[F10] {Icons.Retry} {RetryText.Label(_isDlq)}")" OnClick="@(() => Run(_retry))" FocusedColor="@Theme.Success" FocusOrder="8" OnKeyDown="@HandleKeyDown" />
                    <Markup Content="  " />
                }
                else if (Mode == BrowseMode.Peek)
                {
                    <TextButton Content="@($"[F10] {Icons.Send} Resend")" OnClick="@(() => Run(_resend))" FocusedColor="@Theme.Success" FocusOrder="8" OnKeyDown="@HandleKeyDown" />
                    <Markup Content="  " />
                }
                <TextButton Content="@($"[F11] {Icons.Purge} Purge")" OnClick="@(() => _purge?.Invoke())" FocusedColor="@Theme.Danger" FocusOrder="9" OnKeyDown="@HandleKeyDown" />
                <Markup Content="  " />
                <TextButton Content="@($"[Esc] {Icons.Back} Back")" OnClick="GoBack" FocusedColor="@Theme.Accent" FocusOrder="10" OnKeyDown="@HandleKeyDown" />
            </Columns>
        </Padder>
    </Footer>
</FullscreenPage>

@* Loads are not awaited by the submitting key, so keys (Esc to cancel) keep working while they run. *@
<FetchDialog @ref="_peekDialog" OnSubmit="@(r => { _ = Peek(r); })" OnCancel="FocusTable" />
<FetchDialog @ref="_receiveDialog" IsReceive="true" DefaultCount="10" OnSubmit="@(r => { _ = Receive(r); })" OnCancel="FocusTable" />

<OperationDialog Operation="@_browser?.Operation" OnDismiss="DismissOperation" />

<ErrorModal Message="@_error" OnDismiss="@(() => { _error = ""; FocusTable(); })" />

<AsyncCommand @ref="_complete" TItem="IReadOnlyList<MessageInfo>"
              ConfirmMessage="@(l => $"Complete {Count(l)}? They are removed from {Source.DisplayName}.")"
              Execute="@(l => Browser.CompleteAsync(l ?? []))" />

<AsyncCommand @ref="_abandon" TItem="IReadOnlyList<MessageInfo>"
              Execute="@(l => Browser.AbandonAsync(l ?? []))" />

<AsyncCommand @ref="_deadLetter" TItem="IReadOnlyList<MessageInfo>"
              ConfirmMessage="@(l => $"Move {Count(l)} to the dead-letter queue?")"
              Execute="@(l => Browser.DeadLetterAsync(l ?? []))" />

<AsyncCommand @ref="_retry" TItem="IReadOnlyList<MessageInfo>"
              ConfirmMessage="@(l => RetryText.Confirm(Mode, Source, Count(l)))"
              Execute="@(l => Browser.RetryAsync(l ?? []))" />

<AsyncCommand @ref="_resend" TItem="IReadOnlyList<MessageInfo>"
              ConfirmMessage="@(l => $"Send copies of {Count(l)} to {Source.SendTarget}? The originals stay in {Source.DisplayName}.{TopicNote}")"
              Execute="@(l => Browser.ResendAsync(l ?? []))" />

<AsyncCommand @ref="_purge" TItem="object"
              ConfirmMessage="@(_ => $"Purge ALL messages from {Source.DisplayName}? This cannot be undone.")"
              Execute="@(_ => Browser.PurgeAsync())" />

@code {
    /// <summary>The entity to browse; <see cref="MessageSource.IsDlq"/> is the initial view.</summary>
    [Parameter, EditorRequired] public MessageSource Entity { get; set; } = new("", true);
    [Parameter, EditorRequired] public RenderFragment Breadcrumb { get; set; } = _ => { };
    [Parameter, EditorRequired] public string BackPath { get; set; } = "/";

    private const int DefaultPeekCount = 100;

    private MessageBrowser? _browser;
    private bool _isDlq;
    private bool _isAutoForwarding;
    private string? _loading;
    private string _error = "";
    private SpectreTBody? _tbody;
    private SpectreTBody? _focusedTbody;

    private FetchDialog? _peekDialog;
    private FetchDialog? _receiveDialog;
    private AsyncCommand<IReadOnlyList<MessageInfo>>? _complete;
    private AsyncCommand<IReadOnlyList<MessageInfo>>? _abandon;
    private AsyncCommand<IReadOnlyList<MessageInfo>>? _deadLetter;
    private AsyncCommand<IReadOnlyList<MessageInfo>>? _retry;
    private AsyncCommand<IReadOnlyList<MessageInfo>>? _resend;
    private AsyncCommand<object>? _purge;

    private MessageBrowser Browser => _browser ?? throw new InvalidOperationException("Message browser not initialized");
    private MessageSource Source => Entity with { IsDlq = _isDlq };
    private BrowseMode Mode => _browser?.Mode ?? BrowseMode.Peek;
    private bool CanRetry => RetryText.CanRetry(Mode, _isDlq);
    private (int Rows, int Preview) Split => FullscreenLayout.BrowserSplit(Viewport.Height);

    // A short list leaves rows unused; the preview takes them.
    private int PreviewHeight(MessageBrowser browser) => Split.Preview + Math.Max(0, Split.Rows - browser.Messages.Count);
    private string TopicNote => Source.IsSubscription ? " Every subscription of the topic gets a copy." : "";

    private IEnumerable<AsyncCommand<IReadOnlyList<MessageInfo>>?> ListCommands => [_complete, _abandon, _deadLetter, _retry, _resend];
    private bool IsBusy => _loading is not null || ListCommands.Any(c => c?.IsBusy == true) || _purge?.IsBusy == true;
    private bool IsDialogOpen => _peekDialog?.IsOpened == true || _receiveDialog?.IsOpened == true;

    protected override async Task OnInitializedAsync()
    {
        // Coming back from the message detail page: keep the list, selection and locks.
        _isDlq = Store.Current is { } current && current.Source with { IsDlq = Entity.IsDlq } == Entity
            ? current.Source.IsDlq
            : Entity.IsDlq;
        if (Attach()) await Peek(new FetchDialog.Request(DefaultPeekCount, null, false));
        // Back from the detail page after it handled the last message: nothing left to browse.
        else if (Browser.Messages.Count == 0) GoBack();
    }

    // Nothing left after a purge or acting on every message: back to the list.
    private void DismissOperation()
    {
        Browser.Dismiss();
        if (Browser.Messages.Count == 0) GoBack();
        else FocusTable();
    }

    public void Dispose()
    {
        if (_browser is not null) _browser.Changed -= OnBrowserChanged;
    }

    private bool Attach()
    {
        if (_browser is not null) _browser.Changed -= OnBrowserChanged;
        var (browser, isNew) = Store.Open(Source);
        _browser = browser;
        _browser.Changed += OnBrowserChanged;
        return isNew;
    }

    private void OnBrowserChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_tbody is not null && _tbody != _focusedTbody && !IsDialogOpen && _browser?.Operation is not { Finished: true })
        {
            _focusedTbody = _tbody;
            await FocusManager.FocusAsync(_tbody.FocusKey);
        }
    }

    private void FocusTable()
    {
        _focusedTbody = null;
        StateHasChanged();
    }

    private async Task SwitchDlq(bool dlq)
    {
        if (IsBusy) return;
        _isDlq = dlq;
        Attach();
        await Peek(new FetchDialog.Request(DefaultPeekCount, null, false));
    }

    private Task Peek(FetchDialog.Request request) =>
        Load("Peeking messages…", () => Browser.PeekAsync(request.Count, request.FromSequenceNumber));

    private Task Receive(FetchDialog.Request request) =>
        Load(request.DeleteOnReceive ? "Receiving and deleting messages…" : "Receiving and locking messages…",
            () => Browser.ReceiveAsync(request.Count, request.DeleteOnReceive));

    private async Task Load(string label, Func<Task> load)
    {
        if (_loading is not null) return;
        _loading = label;
        _error = "";
        _isAutoForwarding = false;
        StateHasChanged();
        try { await load(); }
        catch (Exception ex) when (ex.Message.Contains("auto-forwarding", StringComparison.OrdinalIgnoreCase)) { _isAutoForwarding = true; }
        catch (Exception ex) { _error = ex.Message.Split('\n')[0]; }
        _loading = null;
        FocusTable();
    }

    private void Run(AsyncCommand<IReadOnlyList<MessageInfo>>? command)
    {
        if (command is null || IsBusy || _browser is not { } browser) return;
        var targets = browser.Targets;
        if (targets.Count > 0) command.Invoke(targets);
    }

    private void Toggle(MessageInfo m)
    {
        Browser.Toggle(m);
        StateHasChanged();
    }

    // One delegate per row keeps its event handler id stable across renders; a fresh lambda
    // gets a new id each render, and a click spanning a render would hit a stale one.
    private readonly Dictionary<long, Action> _toggleHandlers = [];

    private Action ToggleHandler(MessageInfo m)
    {
        if (!_toggleHandlers.TryGetValue(m.SequenceNumber, out var handler))
            _toggleHandlers[m.SequenceNumber] = handler = () => ToggleBySequence(m.SequenceNumber);
        return handler;
    }

    private void ToggleBySequence(long sequenceNumber)
    {
        if (Browser.Messages.Find(x => x.SequenceNumber == sequenceNumber) is { } m) Toggle(m);
    }

    private void ToggleAll()
    {
        Browser.ToggleAll();
        StateHasChanged();
    }

    private void ToggleAt(int index)
    {
        if (Browser.Messages.ElementAtOrDefault(index) is { } m) Toggle(m);
    }

    private void ViewMessage(MessageInfo msg)
    {
        NavState.Message = msg;
        NavState.MessageSource = Source;
        Nav.NavigateTo("/message");
    }

    private void GoBack()
    {
        _ = Store.CloseAsync();
        Nav.NavigateTo(BackPath);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey || IsDialogOpen) return;
        // A finished operation's dialog waits for OK, also when focus is still here.
        if (_browser?.Operation is { Finished: true })
        {
            if (e.Key is "Escape" or "Enter") DismissOperation();
            return;
        }
        if (e.Key == "Escape" && _browser?.Operation is { Finished: false } running)
        {
            running.Cancel();
            StateHasChanged();
            return;
        }
        if (ListCommands.Any(c => c?.HandleKey(e) == true) || _purge?.HandleKey(e) == true) return;
        switch (e.Key)
        {
            case "Escape":
                if (_browser is { Selected.Count: > 0 } b) { b.Selected.Clear(); StateHasChanged(); }
                else GoBack();
                return;
        }
        if (IsBusy) return;
        switch (e.Key)
        {
            case "a": case "A": Browser.SelectAll(); StateHasChanged(); return;
            case "i": case "I": Browser.InvertSelection(); StateHasChanged(); return;
            case "F6": _ = SwitchDlq(!_isDlq); return;
            case "F7": _peekDialog?.Open(); return;
            case "F8": _receiveDialog?.Open(); return;
            case "F9": case "Delete": if (Mode == BrowseMode.Locked) Run(_complete); return;
            case "F4": if (Mode == BrowseMode.Locked) Run(_abandon); return;
            case "F3": if (Mode == BrowseMode.Locked && !_isDlq) Run(_deadLetter); return;
            case "F10":
                if (CanRetry) Run(_retry);
                else if (Mode == BrowseMode.Peek) Run(_resend);
                return;
            case "F11": _purge?.Invoke(); return;
        }
    }

    private static string Count(IReadOnlyList<MessageInfo>? list) =>
        list is [var single] ? $"message #{single.SequenceNumber}" : $"{list?.Count ?? 0} messages";

    private static string ModeLabel(BrowseMode mode) => mode switch
    {
        BrowseMode.Locked => $"{Icons.Locked} locked",
        BrowseMode.Received => $"{Icons.Received} received and deleted",
        _ => $"{Icons.Peek} peek",
    };

    private static Color ModeColor(BrowseMode mode) => mode switch
    {
        BrowseMode.Locked => Theme.Warning,
        BrowseMode.Received => Theme.Danger,
        _ => Theme.Accent,
    };

    private static string EmptyText(BrowseMode mode) => mode switch
    {
        BrowseMode.Peek => "No messages. Use F7 Peek or F8 Receive to load.",
        _ => "No messages left. Use F7 Peek or F8 Receive to load more.",
    };

    private static string StatusCount(MessageBrowser b) => b.Mode switch
    {
        BrowseMode.Locked => $"{Icons.Message} {b.Messages.Count} locked message(s), {b.LockedCount} held",
        BrowseMode.Received => $"{Icons.Received} {b.Messages.Count} message(s) already deleted, requeue them or they are gone",
        _ => $"{Icons.Message} {b.Messages.Count} message(s)",
    };

    private static string Truncate(string value, int maxLength) =>
        value.Length <= maxLength ? value : value[..(maxLength - 1)] + "…";
}
