@namespace LLMAgentTUI.Components
@inject ServiceBusConnection Connection
@inject NavigationState NavState

<Panel BorderColor="@Color.Grey37" FillWidth="true" Padding="@(new(0, 0, 0, 0))">
    <Columns>
        @if (Connection.Namespace is { } ns)
        {
            <div class="pick-subscription" @onclick="OpenSubscriptions"><Markup Content="@SubscriptionName" Foreground="@Color.Grey" Decoration="@Decoration.Underline" /></div>
            <Markup Content=" › " Foreground="@Color.Grey" />
            <div class="pick-namespace" @onclick="OpenNamespaces"><Markup Content="@ns.Name" Foreground="@Color.White" Decoration="@Decoration.Underline" /></div>
            <Markup Content=" › " Foreground="@Color.Grey" />
        }
        @ChildContent
        @if (Connection.Namespace is { } details && Details(details) is { Length: > 0 } text)
        {
            <Markup Content="@text" Foreground="@Color.Grey" />
        }
    </Columns>
</Panel>

<ConnectionPicker @ref="_picker" />

@code {
    /// <summary>Page breadcrumb: Markup pieces, shown after the subscription and namespace.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ConnectionPicker? _picker;

    private string SubscriptionName => NavState.AzureSubscriptionName ?? "";

    // Panel border + padding put the subscription at x = 2; Columns adds one space around " › ".
    private const int SubscriptionX = 2;
    private int NamespaceX => SubscriptionX + SubscriptionName.Length + 1 + " › ".Length + 1;

    private void OpenSubscriptions(MouseEventArgs e) => _picker?.OpenSubscriptions(SubscriptionX - 1, (int)e.ClientY + 1);

    private void OpenNamespaces(MouseEventArgs e) => _picker?.OpenNamespaces(NamespaceX - 1, (int)e.ClientY + 1);

    /// <summary>Item count for a page header: "(3)", or "(1 of 3)" while filtered.</summary>
    public static string Count(int shown, int total) => shown == total ? $"({total})" : $"({shown} of {total})";

    private static string Details(NamespaceInfo ns)
    {
        var parts = new[] { ns.ResourceGroup, ns.Location, ns.Sku, ns.Status }.Where(p => !string.IsNullOrEmpty(p));
        var text = string.Join("  ·  ", parts);
        // Columns already adds one space before this cell.
        return text.Length == 0 ? "" : $"  │  {text}";
    }
}
