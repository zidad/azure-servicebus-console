@namespace LLMAgentTUI.Components
@inject ServiceBusConnection Connection
@inject NavigationState NavState

<Panel BorderColor="@Theme.Border" FillWidth="true" Padding="@(new(0, 0, 0, 0))">
    <Columns>
        @if (Connection.Namespace is { } ns)
        {
            <div class="pick-subscription" @onclick="OpenSubscriptions"><Markup Content="@SubscriptionLabel" Foreground="@Theme.Muted" Decoration="@Decoration.Underline" /></div>
            <Markup Content=" › " Foreground="@Theme.Muted" />
            <div class="pick-namespace" @onclick="OpenNamespaces"><Markup Content="@($"{Icons.Namespace} {ns.Name}")" Foreground="@Color.White" Decoration="@Decoration.Underline" /></div>
            <Markup Content=" › " Foreground="@Theme.Muted" />
        }
        <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
    </Columns>
</Panel>

<ConnectionPicker @ref="_picker" />

@code {
    /// <summary>Page breadcrumb: Markup pieces, shown after the subscription and namespace.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ConnectionPicker? _picker;

    private string SubscriptionName => NavState.AzureSubscription?.Name ?? "";

    private string SubscriptionIcon => Connection.IsEmulator ? Icons.Emulator : Icons.AzureSubscription;

    private string SubscriptionLabel => $"{SubscriptionIcon} {SubscriptionName}";

    // Panel border + padding put the subscription at x = 2; the icon is two cells wide;
    // Columns adds one space around " › ".
    private const int SubscriptionX = 2;
    private int NamespaceX => SubscriptionX + 3 + SubscriptionName.Length + 1 + " › ".Length + 1;

    private void OpenSubscriptions(MouseEventArgs e) => _picker?.OpenSubscriptions(SubscriptionX - 1, (int)e.ClientY + 1);

    private void OpenNamespaces(MouseEventArgs e) => _picker?.OpenNamespaces(NamespaceX - 1, (int)e.ClientY + 1);

    /// <summary>Opens the section dropdown under a clicked <see cref="SectionCrumb"/>.</summary>
    public void OpenSections(int x, int top) => _picker?.OpenSections(Math.Max(0, x - 3), top);

    /// <summary>Item count for a page header: "(3)", or "(1 of 3)" while filtered.</summary>
    public static string Count(int shown, int total) => shown == total ? $"({total})" : $"({shown} of {total})";
}
