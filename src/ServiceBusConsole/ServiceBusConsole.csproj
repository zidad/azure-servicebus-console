<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>azsb</ToolCommandName>
    <PackageId>Net.Azure.ServiceBusConsole</PackageId>
    <Authors>zidad</Authors>
    <Description>Terminal UI for browsing Azure Service Bus namespaces, queues, topics, and messages.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/zidad/azure-servicebus-console</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- A native package per platform, packed with dotnet pack -r <rid> on that OS; 'any' (framework-dependent) elsewhere. -->
    <PublishAot>true</PublishAot>
    <!-- Restores the 'any' target that a plain pack builds. -->
    <RuntimeIdentifiers>any</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64;win-x64;win-arm64;any</ToolPackageRuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <!-- Keep debug symbols and XML docs out of the tool packages and archives. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishReferencesSymbols>false</PublishReferencesSymbols>
    <!-- Blazor 10's Router.NotFoundPage setter is annotated for trimming; Router parameters are set by reflection (dotnet/aspnetcore#63951). -->
    <NoWarn>$(NoWarn);IL2110;IL2111</NoWarn>
  </PropertyGroup>
  <!-- The plain dotnet pack builds the pointer package and 'any' only, on any host; the native packages come from dotnet pack -r. -->
  <Target Name="PackAnyWithThePointer" BeforeTargets="ComputeToolPackageRuntimeIdentifiersToPack">
    <ItemGroup>
      <ToolPackageRuntimeIdentifiersToPack Include="any" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <!-- Blazor's Router finds the @page components by scanning this assembly: trimming must keep them all. -->
    <TrimmerRootAssembly Include="$(AssemblyName)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
    <ProjectReference Include="../ServiceBusConsole.Abstractions/ServiceBusConsole.Abstractions.csproj" />
    <ProjectReference Include="../ServiceBusConsole.AzureServiceBus/ServiceBusConsole.AzureServiceBus.csproj" />
    <ProjectReference Include="../ServiceBusConsole.BundledPlugins/ServiceBusConsole.BundledPlugins.csproj" />
    <ProjectReference Include="../ServiceBusConsole.Plugins/ServiceBusConsole.Plugins.csproj" />
    <ProjectReference Include="../../lib/RazorConsole/src/RazorConsole.Core/RazorConsole.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="ServiceBusConsole.Abstractions" />
    <Using Include="ServiceBusConsole.Resources" />
    <Using Include="ServiceBusConsole.PluginHost" />
    <Using Include="ServiceBusConsole.Plugins" />
    <Using Include="ServiceBusConsole.CommandLine" />
    <Using Include="ServiceBusConsole.Configuration" />
    <Using Include="ServiceBusConsole.Extensions" />
    <Using Include="ServiceBusConsole.Logging" />
    <Using Include="ServiceBusConsole.Messaging" />
    <Using Include="ServiceBusConsole.Services" />
    <Using Include="ServiceBusConsole.Services.Caching" />
    <Using Include="ServiceBusConsole.Syntax" />
    <Using Include="ServiceBusConsole.UI" />
    <Using Include="ServiceBusConsole.UI.Explorer" />
    <Using Include="Spectre.Console" />
  </ItemGroup>
</Project>
