@inject RazorConsole.Core.Focus.FocusManager FocusManager

<ModalWindow IsOpened="@IsOpened">
    <Panel Title="@($"{Icons.Confirm} Confirm")" BorderColor="@Theme.Danger" Padding="@(new(2, 1, 2, 1))">
        <Rows>
            <Markup Content="@Message" />
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <KeyButton @ref="_confirmButton"
                                Content="[Y] Yes"
                                OnClick="@(() => OnConfirm.InvokeAsync())"
                                OnKeyDown="HandleKey"
                                FocusedColor="@Theme.Danger"
                                FocusOrder="0" />
                    <Markup Content="   " />
                    <KeyButton Content="[N] No"
                                OnClick="@(() => OnCancel.InvokeAsync())"
                                OnKeyDown="HandleKey"
                                FocusedColor="@Theme.Muted"
                                FocusOrder="1" />
                </Columns>
            </Padder>
        </Rows>
    </Panel>
</ModalWindow>

@code {
    [Parameter, EditorRequired] public bool IsOpened { get; set; }
    [Parameter, EditorRequired] public string Message { get; set; } = "";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private KeyButton? _confirmButton;
    private bool _wasOpened;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpened && !_wasOpened && _confirmButton is not null)
        {
            _wasOpened = true;
            // Once: FocusAsync keeps the request until the button renders, and a retry after the modal
            // closed would replace a later request, such as the result dialog's OK.
            await FocusManager.FocusAsync(_confirmButton.FocusKey);
        }
        else if (!IsOpened)
        {
            _wasOpened = false;
        }
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Y": case "y": case "Enter": case "Return":
                _ = OnConfirm.InvokeAsync();
                break;
            case "N": case "n": case "Escape":
                _ = OnCancel.InvokeAsync();
                break;
        }
    }
}
