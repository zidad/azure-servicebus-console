@inject RazorConsole.Core.Focus.FocusManager FocusManager

<Dialog IsOpened="@IsOpened" Icon="@Icons.Confirm" Title="@ComponentStrings.ConfirmModal_Title" BorderColor="@Theme.Danger">
    <ChildContent>
        <Markup Content="@Message" />
        @if (Fields.Count > 0)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <DialogFields Fields="@Fields" />
            </Padder>
        }
        @if (MustType is { } text)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <TextInput @ref="_input" @key="_opened" Label="@ComponentStrings.FormatConfirmModal_TypeToConfirm(text)" OnInput="@(v => _typed = v ?? "")"
                           OnSubmit="@(_ => Confirm())" FocusOrder="0" @onkeydown="HandleTypingKey" FillWidth="true" />
            </Padder>
        }
    </ChildContent>
    <Buttons>
        <KeyButton @ref="_confirmButton" Key="@(MustType is null ? "y" : "⏎")" Danger="true" Content="@ComponentStrings.Dialog_Yes"
                   OnClick="Confirm" OnKeyDown="HandleKey" FocusedColor="@Theme.Danger" FocusOrder="@(MustType is null ? 0 : 1)" />
        <KeyButton Key="@(MustType is null ? "n" : "esc")" Content="@ComponentStrings.Dialog_No"
                   OnClick="@(() => OnCancel.InvokeAsync())" OnKeyDown="HandleKey" FocusedColor="@Theme.Muted" FocusOrder="2" />
    </Buttons>
</Dialog>

@code {
    [Parameter, EditorRequired] public bool IsOpened { get; set; }
    [Parameter, EditorRequired] public string Message { get; set; } = "";
    [Parameter] public IReadOnlyList<DialogField> Fields { get; set; } = [];
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Word to type before Yes works, ignoring case; y and n are typing then.</summary>
    [Parameter] public string? MustType { get; set; }

    private KeyButton? _confirmButton;
    private TextInput? _input;
    private bool _wasOpened;
    private int _opened;
    private string _typed = "";

    /// <summary>Whether Yes may run: always, or once <see cref="MustType"/> is typed.</summary>
    public bool CanConfirm => MustType is null || string.Equals(_typed.Trim(), MustType, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpened && !_wasOpened && (MustType is null ? _confirmButton?.FocusKey : _input?.FocusKey) is { } key)
        {
            _wasOpened = true;
            // Once: FocusAsync keeps the request until the button renders, and a retry after the modal
            // closed would replace a later request, such as the result dialog's OK.
            await FocusManager.FocusAsync(key);
        }
        else if (!IsOpened && _wasOpened)
        {
            _wasOpened = false;
            _opened++;
            _typed = "";
        }
    }

    private Task Confirm() => CanConfirm ? OnConfirm.InvokeAsync() : Task.CompletedTask;

    private void HandleKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Y" or "y" when MustType is null:
                _ = Confirm();
                break;
            case "N" or "n" when MustType is null:
                _ = OnCancel.InvokeAsync();
                break;
            case "Escape":
                _ = OnCancel.InvokeAsync();
                break;
        }
    }

    private void HandleTypingKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _ = OnCancel.InvokeAsync();
    }
}
