@implements IDisposable
@inject ITerminalViewport Viewport
@inject MetricsOptions Options
@inject MetricsRange Range
@inject ILogger<MetricsPanel> Logger

<Flex Direction="FlexDirection.Column" Height="@FullscreenLayout.MetricsPanel" FillWidth="true">
    @if (Metrics is null || Scope is null)
    {
        @if (Placeholder is { } placeholder)
        {
            <Markup Content="@placeholder" Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
        }
    }
    else
    {
        <Flex Direction="FlexDirection.Row" Gap="@Gap">
            <Flex Direction="FlexDirection.Row" Width="@HalfWidth">
                <Columns>
                    <Markup Content="@CellText.Fit(Label, HalfWidth - ThroughputLegendWidth - 6)" Decoration="@Decoration.Bold" />
                    <Markup Content=" " />
                    <Markup Content="──" Foreground="@Theme.Incoming" />
                    <Markup Content="incoming" Foreground="@Theme.Muted" />
                    <Markup Content="──" Foreground="@Theme.Outgoing" />
                    <Markup Content="outgoing" Foreground="@Theme.Muted" />
                </Columns>
            </Flex>
            <Flex Direction="FlexDirection.Row" Width="@HalfWidth" Justify="FlexJustify.SpaceBetween">
                <Columns>
                    <Markup Content="──" Foreground="@Theme.Backlog" />
                    <Markup Content="active" Foreground="@Theme.Muted" />
                    <Markup Content="──" Foreground="@Theme.Danger" />
                    <Markup Content="@(HalfWidth >= FullBacklogLegendWidth ? "dead-lettered" : "DLQ")" Foreground="@Theme.Muted" />
                </Columns>
                <Columns>
                    @if (_metrics?.IsRefreshing == true) { <Spinner /> } else { <Markup Content=" " /> }
                    <KeyButton Content="[-]" OnClick="@(() => { StepRange(1); })" FocusOrder="@FocusOrder" OnKeyDown="@OnKeyDown"
                               FocusedColor="@Theme.Accent" ForegroundColor="@(Range.CanWiden ? Color.Default : Theme.Muted)" />
                    <Markup Content="@MetricsRange.Label(Range.Span)" Foreground="@Theme.Muted" />
                    <KeyButton Content="[+]" OnClick="@(() => { StepRange(-1); })" FocusOrder="@FocusOrder" OnKeyDown="@OnKeyDown"
                               FocusedColor="@Theme.Accent" ForegroundColor="@(Range.CanNarrow ? Color.Default : Theme.Muted)" />
                </Columns>
            </Flex>
        </Flex>
        @if (_error is { } error)
        {
            <Markup Content="@error" Foreground="@Theme.Muted" />
        }
        else if (_metrics is { } m)
        {
            <Flex Direction="FlexDirection.Row" Gap="@Gap">
                <StepChart Width="@ChartWidth" Height="@FullscreenLayout.MetricsChartHeight"
                           AxesColor="@Theme.Border" LabelsColor="@Theme.Muted"
                           XAxisFormat="@MetricsChart.XAxisFormat(m.Window)" YAxisFormat="@MetricsChart.YAxisFormat([m.Incoming, m.Outgoing])"
                           Series="@MetricsChart.Series(m.Window, (Theme.Outgoing, m.Outgoing), (Theme.Incoming, m.Incoming))" />
                <StepChart Width="@ChartWidth" Height="@FullscreenLayout.MetricsChartHeight"
                           AxesColor="@Theme.Border" LabelsColor="@Theme.Muted"
                           XAxisFormat="@MetricsChart.XAxisFormat(m.Window)" YAxisFormat="@MetricsChart.YAxisFormat([m.Active, m.DeadLettered])"
                           Series="@MetricsChart.Series(m.Window, (Theme.Backlog, m.Active), (Theme.Danger, m.DeadLettered))" />
            </Flex>
        }
        else
        {
            <Columns>
                <Spinner />
                <Markup Content="Loading metrics..." Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
            </Columns>
        }
    }
</Flex>

@code {
    /// <summary>
    /// Azure Monitor charts of <see cref="Scope"/> from <see cref="Metrics"/> over <see cref="MetricsRange"/>: throughput
    /// on the left, backlog on the right, one point per plot column at most. Loads once the scope has stayed the same
    /// for <see cref="MetricsOptions.Debounce"/>, cached first; a failure shows as a line in the panel. Always
    /// <see cref="FullscreenLayout.MetricsPanel"/> lines, whatever it shows.
    /// </summary>
    [Parameter, EditorRequired] public required string Label { get; set; }

    /// <summary>Of the namespace charted; null when it has none, so the <see cref="Placeholder"/> shows.</summary>
    [Parameter] public IMetricsService? Metrics { get; set; }

    /// <summary>Null while nothing is selected.</summary>
    [Parameter] public MetricsScope? Scope { get; set; }

    /// <summary>Shown while <see cref="Metrics"/> or <see cref="Scope"/> is null.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Of the [-] and [+] buttons.</summary>
    [Parameter] public int FocusOrder { get; set; } = 2;

    /// <summary>The page's keys, for while a range button has focus.</summary>
    [Parameter] public Action<KeyboardEventArgs>? OnKeyDown { get; set; }

    private const int Gap = 2;

    // "── incoming ── outgoing": Columns put a space between items.
    private const int ThroughputLegendWidth = 23;

    // "── active ── dead-lettered" and " [-] last 24 h [+]", a space apart.
    private const int FullBacklogLegendWidth = 26 + 1 + 19;

    private (IMetricsService? Metrics, MetricsScope? Scope, TimeSpan Span, TimeSpan Interval) _target;
    private CancellationTokenSource? _cts;
    private MessageMetrics? _metrics;
    private string? _error;

    private int HalfWidth => (Viewport.Width - Gap) / 2;

    // The axes take two columns beyond Width.
    private int ChartWidth => HalfWidth - 2;

    protected override void OnParametersSet() => Retarget();

    /// <summary>Loads again, e.g. on F5; the charts stay until the new metrics arrive.</summary>
    public void Reload()
    {
        if (_target is not ({ }, { }, _, _)) return;
        _metrics = _metrics is { } shown ? shown with { IsRefreshing = true } : null;
        Load(Options.Debounce);
        StateHasChanged();
    }

    /// <summary>
    /// Widens (positive) or narrows (negative) the charts' range, keeping them until the new range arrives.
    /// False while nothing is charted, so the page can use the key otherwise.
    /// </summary>
    public bool StepRange(int steps)
    {
        if (_target is not ({ }, { }, _, _)) return false;
        _ = Range.StepAsync(steps);
        Retarget();
        StateHasChanged();
        return true;
    }

    public void Dispose()
    {
        Cancel();
        _target = default;
    }

    private void Retarget()
    {
        var target = (Metrics, Scope, Range.Span, MetricsChart.Interval(Range.Span, MetricsChart.PlotColumns(ChartWidth)));
        if (target == _target) return;
        var sameScope = (target.Metrics, target.Scope) == (_target.Metrics, _target.Scope);
        _target = target;
        if (sameScope)
        {
            _metrics = _metrics is { } shown ? shown with { IsRefreshing = true } : null;
            Load(Options.RangeDebounce);
        }
        else
        {
            _metrics = null;
            Load(Options.Debounce);
        }
    }

    private void Load(TimeSpan delay)
    {
        Cancel();
        _error = null;
        if (_target is ({ } metrics, { } scope, var span, var interval)) _ = LoadAsync(metrics, scope, span, interval, delay, (_cts = new()).Token);
    }

    private void Cancel()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }

    private async Task LoadAsync(IMetricsService metrics, MetricsScope scope, TimeSpan span, TimeSpan interval, TimeSpan delay, CancellationToken ct)
    {
        try
        {
            await Task.Delay(delay, ct);
            var window = MetricsWindow.Last(span, interval, DateTimeOffset.UtcNow);
            await foreach (var loaded in metrics.GetMetricsAsync(scope, window, ct))
                await InvokeAsync(() => Show(ct, loaded, null));
        }
        catch (Exception) when (ct.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Loading metrics of {Scope} failed", scope);
            await InvokeAsync(() => Show(ct, null, ErrorLine(ex)));
        }
    }

    private void Show(CancellationToken ct, MessageMetrics? metrics, string? error)
    {
        if (ct.IsCancellationRequested) return;
        _metrics = metrics;
        _error = error;
        StateHasChanged();
    }

    // Azure errors span many lines (status, content, headers); the first says what went wrong.
    private string ErrorLine(Exception ex) =>
        CellText.Fit($"Metrics unavailable: {ex.Message.Split('\n')[0].Trim()}", Viewport.Width - 1);
}
