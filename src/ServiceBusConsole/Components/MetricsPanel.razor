@implements IDisposable
@inject IMetricsService MetricsService
@inject ServiceBusConnection Connection
@inject ITerminalViewport Viewport
@inject MetricsOptions Options
@inject ILogger<MetricsPanel> Logger

<Flex Direction="FlexDirection.Column" Height="@FullscreenLayout.MetricsPanel" FillWidth="true">
    @if (Scope is not null)
    {
        <Flex Direction="FlexDirection.Row" Gap="@Gap">
            <Flex Direction="FlexDirection.Row" Width="@HalfWidth">
                <Columns>
                    <Markup Content="@CellText.Fit(Label, HalfWidth - ThroughputLegendWidth - 6)" Decoration="@Decoration.Bold" />
                    <Markup Content=" " />
                    <Markup Content="──" Foreground="@Theme.Incoming" />
                    <Markup Content="incoming" Foreground="@Theme.Muted" />
                    <Markup Content="──" Foreground="@Theme.Outgoing" />
                    <Markup Content="outgoing" Foreground="@Theme.Muted" />
                </Columns>
            </Flex>
            <Flex Direction="FlexDirection.Row" Width="@HalfWidth" Justify="FlexJustify.SpaceBetween">
                <Columns>
                    <Markup Content="──" Foreground="@Theme.Backlog" />
                    <Markup Content="active" Foreground="@Theme.Muted" />
                    <Markup Content="──" Foreground="@Theme.Danger" />
                    <Markup Content="dead-lettered" Foreground="@Theme.Muted" />
                </Columns>
                <Columns>
                    @if (_metrics?.IsRefreshing == true) { <Spinner /> }
                    <Markup Content="@($"last {Options.Span.TotalHours:0} h")" Foreground="@Theme.Muted" />
                </Columns>
            </Flex>
        </Flex>
        @if (_error is { } error)
        {
            <Markup Content="@error" Foreground="@Theme.Muted" />
        }
        else if (_metrics is { } m)
        {
            <Flex Direction="FlexDirection.Row" Gap="@Gap">
                <StepChart Width="@ChartWidth" Height="@FullscreenLayout.MetricsChartHeight"
                           AxesColor="@Theme.Border" LabelsColor="@Theme.Muted"
                           XAxisFormat="@MetricsChart.XAxisFormat" YAxisFormat="@MetricsChart.YAxisFormat([m.Incoming, m.Outgoing])"
                           Series="@MetricsChart.Series(m.Window, (Theme.Outgoing, m.Outgoing), (Theme.Incoming, m.Incoming))" />
                <StepChart Width="@ChartWidth" Height="@FullscreenLayout.MetricsChartHeight"
                           AxesColor="@Theme.Border" LabelsColor="@Theme.Muted"
                           XAxisFormat="@MetricsChart.XAxisFormat" YAxisFormat="@MetricsChart.YAxisFormat([m.Active, m.DeadLettered])"
                           Series="@MetricsChart.Series(m.Window, (Theme.Backlog, m.Active), (Theme.Danger, m.DeadLettered))" />
            </Flex>
        }
        else
        {
            <Columns>
                <Spinner />
                <Markup Content="Loading metrics..." Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
            </Columns>
        }
    }
</Flex>

@code {
    /// <summary>
    /// Azure Monitor charts of the last day for <see cref="Scope"/> in the current namespace: throughput on the left,
    /// backlog on the right. Loads once the scope has stayed the same for <see cref="MetricsOptions.Debounce"/>,
    /// cached first; a failure shows as a line in the panel. Always <see cref="FullscreenLayout.MetricsPanel"/> lines.
    /// </summary>
    [Parameter, EditorRequired] public required string Label { get; set; }

    /// <summary>Null while nothing is selected.</summary>
    [Parameter] public MetricsScope? Scope { get; set; }

    private const int Gap = 2;

    // "── incoming ── outgoing": Columns put a space between items.
    private const int ThroughputLegendWidth = 23;

    private (NamespaceInfo? Namespace, MetricsScope? Scope) _target;
    private CancellationTokenSource? _cts;
    private MessageMetrics? _metrics;
    private string? _error;

    private int HalfWidth => (Viewport.Width - Gap) / 2;

    // The axes take two columns beyond Width.
    private int ChartWidth => HalfWidth - 2;

    protected override void OnParametersSet()
    {
        // The namespace record changes when its live listing replaces a cached one without a resource ID.
        var target = (Connection.Namespace, Scope);
        if (target == _target) return;
        _target = target;
        _metrics = null;
        Load();
    }

    /// <summary>Loads again, e.g. on F5; the charts stay until the new metrics arrive.</summary>
    public void Reload()
    {
        if (_target.Scope is null) return;
        _metrics = _metrics is { } shown ? shown with { IsRefreshing = true } : null;
        Load();
        StateHasChanged();
    }

    public void Dispose()
    {
        Cancel();
        _target = default;
    }

    private void Load()
    {
        Cancel();
        _error = null;
        if (_target.Scope is { } scope) _ = LoadAsync(scope, (_cts = new()).Token);
    }

    private void Cancel()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }

    private async Task LoadAsync(MetricsScope scope, CancellationToken ct)
    {
        try
        {
            await Task.Delay(Options.Debounce, ct);
            var window = MetricsWindow.Last(Options.Span, Options.Interval, DateTimeOffset.UtcNow);
            await foreach (var metrics in MetricsService.GetMetricsAsync(scope, window, ct))
                await InvokeAsync(() => Show(ct, metrics, null));
        }
        catch (Exception) when (ct.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Loading metrics of {Scope} failed", scope);
            await InvokeAsync(() => Show(ct, null, ErrorLine(ex)));
        }
    }

    private void Show(CancellationToken ct, MessageMetrics? metrics, string? error)
    {
        if (ct.IsCancellationRequested) return;
        _metrics = metrics;
        _error = error;
        StateHasChanged();
    }

    // Azure errors span many lines (status, content, headers); the first says what went wrong.
    private string ErrorLine(Exception ex) =>
        CellText.Fit($"Metrics unavailable: {ex.Message.Split('\n')[0].Trim()}", Viewport.Width - 1);
}
