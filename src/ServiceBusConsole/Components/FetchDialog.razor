@inject RazorConsole.Core.Focus.FocusManager FocusManager

<ModalWindow IsOpened="@IsOpened">
    <Panel Border="BoxBorder.Rounded" Title="@(IsReceive ? $"{Icons.Subscription} {ComponentStrings.FetchDialog_ReceiveTitle}" : $"{Icons.Peek} {ComponentStrings.FetchDialog_PeekTitle}")" BorderColor="@(IsReceive && _deleteOnReceive ? Theme.Danger : Theme.Accent)" Padding="@(new(2, 1, 2, 1))">
        @* Keys reach only the focused element, so each one handles Escape. *@
        <Flex Class="rows" Direction="FlexDirection.Column">
            <TextInput @ref="_countInput" FillWidth="true" Label="@ComponentStrings.FetchDialog_Count" Value="@_count" ValueChanged="@(v => _count = v ?? "")"
                       OnSubmit="@(_ => Submit())" FocusOrder="100" @onkeydown="HandleKey" />
            @if (IsReceive)
            {
                <Padder Padding="@(new(0, 1, 0, 0))">
                    <Columns>
                        <Markup Content="@ComponentStrings.FetchDialog_ReceiveMode" />
                        <KeyButton Content="@(_deleteOnReceive ? ComponentStrings.FetchDialog_ReceiveAndDelete : Strings.PeekLock)"
                                    OnClick="@(() => _deleteOnReceive = !_deleteOnReceive)"
                                    FocusedColor="@(_deleteOnReceive ? Theme.Danger : Theme.Success)" FocusOrder="101" OnKeyDown="HandleKey" />
                        <Markup Content="@ComponentStrings.FetchDialog_SwitchHint" Foreground="@Theme.Muted" />
                    </Columns>
                </Padder>
                @if (_deleteOnReceive)
                {
                    <Markup Content="@ComponentStrings.FetchDialog_DeleteWarning" Foreground="@Theme.Danger" />
                }
                else
                {
                    <Markup Content="@ComponentStrings.FetchDialog_LockNote" Foreground="@Theme.Muted" />
                }
            }
            else
            {
                <TextInput FillWidth="true" Label="@ComponentStrings.FetchDialog_FromSequence" Value="@_from" ValueChanged="@(v => _from = v ?? "")"
                           OnSubmit="@(_ => Submit())" FocusOrder="101" @onkeydown="HandleKey" />
            }
            @if (_error.Length > 0)
            {
                <Markup Content="@_error" Foreground="@Theme.Danger" />
            }
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <KeyButton Key="⏎" Content="@ComponentStrings.Dialog_Ok" OnClick="Submit" FocusedColor="@Theme.Success" FocusOrder="102" OnKeyDown="HandleKey" />
                    <Markup Content="   " />
                    <KeyButton Key="esc" Content="@ComponentStrings.Dialog_Cancel" OnClick="Cancel" FocusedColor="@Theme.Muted" FocusOrder="103" OnKeyDown="HandleKey" />
                </Columns>
            </Padder>
        </Flex>
    </Panel>
</ModalWindow>

@code {
    public const int MaxCount = 5000;

    public sealed record Request(int Count, long? FromSequenceNumber, bool DeleteOnReceive);

    [Parameter] public bool IsReceive { get; set; }
    [Parameter] public int DefaultCount { get; set; } = 100;
    [Parameter] public EventCallback<Request> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    public bool IsOpened { get; private set; }

    private TextInput? _countInput;
    private bool _focusPending;
    private string _count = "";
    private string _from = "";
    private bool _deleteOnReceive;
    private string _error = "";

    protected override void OnInitialized() => _count = DefaultCount.ToString();

    public void Open()
    {
        IsOpened = true;
        _deleteOnReceive = false;
        _error = "";
        _focusPending = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending || _countInput is null) return;
        _focusPending = false;
        // Once, as in ConfirmModal: a retry after submit would replace the browser's request to focus the table.
        await FocusManager.FocusAsync(_countInput.FocusKey);
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _ = Cancel();
    }

    private async Task Submit()
    {
        if (!IsOpened) return;
        if (!int.TryParse(_count.Trim(), out var count) || count < 1 || count > MaxCount)
        {
            _error = ComponentStrings.FormatFetchDialog_CountInvalid(MaxCount);
            return;
        }
        long? from = null;
        if (!IsReceive && _from.Trim().Length > 0)
        {
            if (!long.TryParse(_from.Trim(), out var seq) || seq < 0)
            {
                _error = ComponentStrings.FetchDialog_SequenceInvalid;
                return;
            }
            from = seq;
        }
        IsOpened = false;
        await OnSubmit.InvokeAsync(new Request(count, from, IsReceive && _deleteOnReceive));
    }

    private async Task Cancel()
    {
        if (!IsOpened) return;
        IsOpened = false;
        // Escape on a KeyButton arrives through its OnKeyDown action, which doesn't re-render this dialog.
        StateHasChanged();
        await OnCancel.InvokeAsync();
    }
}
