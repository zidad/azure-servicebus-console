@inject ActivityLog Activity

<Dialog IsOpened="@IsOpened" Icon="@Icons.Error" Title="@ComponentStrings.ErrorModal_Title" BorderColor="@Theme.Danger">
    <ChildContent>
        <Markup Content="@Message" Foreground="@Theme.Danger" />
    </ChildContent>
    <Buttons>
        <KeyButton Key="⏎" Content="@ComponentStrings.ErrorModal_Dismiss" OnClick="@(() => OnDismiss.InvokeAsync())"
                   FocusedColor="@Theme.Muted" FocusOrder="1" AutoFocus="true" />
    </Buttons>
</Dialog>

@code {
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public EventCallback OnDismiss { get; set; }

    private bool _wasOpened;

    private bool IsOpened => !string.IsNullOrEmpty(Message);

    protected override void OnAfterRender(bool firstRender)
    {
        if (IsOpened && !_wasOpened) Activity.Record(ActivityKind.Error, Message);
        _wasOpened = IsOpened;
    }
}
