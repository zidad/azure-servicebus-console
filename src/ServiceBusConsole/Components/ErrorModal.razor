@inject RazorConsole.Core.Focus.FocusManager FocusManager
@inject ActivityLog Activity

<ModalWindow IsOpened="@IsOpened">
    <Panel Title="@($"{Icons.Error} Error")" BorderColor="@Theme.Danger" Padding="@(new(2, 1, 2, 1))">
        <Rows>
            <Markup Content="@Message" Foreground="@Theme.Danger" />
            <Padder Padding="@(new(0, 1, 0, 0))">
                <KeyButton @ref="_dismissButton"
                            Content="Dismiss"
                            OnClick="@(() => OnDismiss.InvokeAsync())"
                            FocusedColor="@Theme.Muted"
                            FocusOrder="1" />
            </Padder>
        </Rows>
    </Panel>
</ModalWindow>

@code {
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public EventCallback OnDismiss { get; set; }

    private KeyButton? _dismissButton;
    private bool _wasOpened;

    private bool IsOpened => !string.IsNullOrEmpty(Message);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var opened = IsOpened && !_wasOpened;
        _wasOpened = IsOpened;
        if (!opened) return;
        Activity.Record(ActivityKind.Error, Message);
        if (_dismissButton is not null) await FocusManager.FocusAsync(_dismissButton.FocusKey);
    }
}
