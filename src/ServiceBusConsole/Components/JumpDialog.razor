@inject RazorConsole.Core.Focus.FocusManager FocusManager
@inject ServiceBusConnection Connection
@inject FileCache Cache
@inject NavigationState NavState
@inject SubscriptionCatalog Catalog
@inject NamespaceSwitcher Switcher

<Dialog IsOpened="@IsOpened" Icon="@Icons.Filter" Title="@ComponentStrings.JumpDialog_Title" Width="@Width" Padding="@(new(1, 0, 1, 0))">
    <ChildContent>
        @* No Value binding: a render that lags behind typing would overwrite it. A new input each time it opens starts empty.
           preventDefault leaves Tab and Enter to HandleKey; on a div, since Razor rejects it on a component. *@
        <div @onkeydown:preventDefault="true">
            <TextInput @ref="_input" @key="_opened" OnInput="@OnQuery"
                       Placeholder="@ComponentStrings.JumpDialog_Placeholder" FocusOrder="100" @onkeydown="HandleKey" FillWidth="true" />
        </div>
        @if (Connection.Current is { } here)
        {
            <Markup Content="@((_everywhere ? ComponentStrings.FormatJumpDialog_ScopeAll(here.Info.Name) : ComponentStrings.FormatJumpDialog_ScopeHere(here.Info.Name)).PadLeft(Width - 4))"
                    Foreground="@Theme.Muted" />
        }
        @if (_loading)
        {
            <Markup Content="@ComponentStrings.JumpDialog_Listing" Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
        }
        else if (_results.Count == 0)
        {
            <Markup Content="@ComponentStrings.JumpDialog_NoMatches" Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
        }
        @{ var index = 0; }
        @foreach (var group in _groups)
        {
            <Markup Content="@($" {group.Title.ToUpper(System.Globalization.CultureInfo.CurrentCulture)}")" Foreground="@Theme.Muted" Decoration="@Decoration.Bold" />
            @foreach (var target in group.Targets)
            {
                var current = index++ == _cursor;
                <div class="jump-result" @onclick="@(() => Open(target, deadLetters: false))">
                    <Markup Content="@Line(target)" Background="@(current ? Theme.Selection : Color.Default)" Foreground="@(current ? Theme.OnSelection : Color.Default)" />
                </div>
            }
        }
        @if (Actions is { Count: > 0 } actions)
        {
            <Markup Content="@($" {ComponentStrings.JumpDialog_Actions.ToUpper(System.Globalization.CultureInfo.CurrentCulture)}")" Foreground="@Theme.Muted" Decoration="@Decoration.Bold" />
            @foreach (var action in actions)
            {
                var current = index++ == _cursor;
                <div class="jump-result" @onclick="@action.Run">
                    <Markup Content="@Line(action)" Background="@(current ? Theme.Selection : Color.Default)" Foreground="@(current ? Theme.OnSelection : Color.Default)" />
                </div>
            }
        }
    </ChildContent>
    <Buttons>
        <Markup Content="@ComponentStrings.JumpDialog_Hints" Foreground="@Theme.Muted" />
    </Buttons>
</Dialog>

@code {
    /// <summary>
    /// Opened with <c>:</c>: finds a queue, topic or subscription of the current namespace by name (<see cref="JumpIndex"/>)
    /// and opens it, or with Tab its dead-letter queue. Lists from the cached listings, or live when one isn't cached yet.
    /// The match under the cursor with dead letters adds actions on them, run by the dead-letter browser it opens.
    /// Other namespaces are matches too, and <c>^a</c> adds their cached entities; opening one switches the connection.
    /// </summary>
    public bool IsOpened { get; private set; }

    /// <summary>Gives focus back when closed without opening anything.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private const int Width = 84;

    private TextInput? _input;
    private bool _focusPending;
    private bool _loading;
    private string _query = "";
    private int _opened;
    private int _cursor;
    private IReadOnlyList<JumpTarget> _targets = [];
    private IReadOnlyList<JumpNamespace> _namespaces = [];
    // The other namespaces' entities, loaded on the first ^a.
    private IReadOnlyList<JumpTarget>? _elsewhere;
    private bool _everywhere;
    private IReadOnlyList<JumpGroup> _groups = [];
    // In display order, which the cursor follows.
    private IReadOnlyList<JumpTarget> _results = [];
    // The match the actions are for: the one under the cursor, kept while the cursor is on an action.
    private int _subject;

    private sealed record JumpAction(string Icon, string Text, string Key, Action Run);

    private IReadOnlyList<JumpAction> Actions => _results.ElementAtOrDefault(_subject) is { DeadLetters: > 0 } t and not JumpTarget.Topic
        ? [new(Icons.DeadLetter, ComponentStrings.FormatJumpDialog_OpenDeadLetter(t.Name), "⇥", () => Open(t, deadLetters: true)),
           new(Icons.Purge, ComponentStrings.FormatJumpDialog_PurgeDeadLetter(t.Name), "^p", () => Run(t, BrowserCommand.Purge)),
           new(Icons.Retry, ComponentStrings.FormatJumpDialog_RetryDeadLetter(t.Name), "^r", () => Run(t, BrowserCommand.Retry))]
        : [];

    public async Task OpenAsync()
    {
        IsOpened = true;
        _opened++;
        _query = "";
        _cursor = _subject = 0;
        _focusPending = true;
        _loading = true;
        (_everywhere, _elsewhere) = (false, null);
        StateHasChanged();
        _targets = await LoadAsync();
        var here = Here;
        _namespaces = [.. (await JumpTargets.NamespacesAsync(Catalog.Subscriptions, Cache))
            .Where(ns => !ns.Is(here?.Subscription, here?.Info.FullyQualifiedNamespace))];
        _loading = false;
        Search();
        StateHasChanged();
    }

    private JumpNamespace? Here => Connection.Current is { } current && NavState.AzureSubscription is { } subscription ? new(subscription, current.Info) : null;

    private Task<IReadOnlyList<JumpTarget>> LoadAsync() =>
        Connection.Current is { } current ? JumpTargets.LoadAsync(current, Cache) : Task.FromResult<IReadOnlyList<JumpTarget>>([]);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending || _input is null) return;
        _focusPending = false;
        await FocusManager.FocusAsync(_input.FocusKey);
    }

    private void OnQuery(string? query)
    {
        // The : that opened the dialog can reach the input when focus moves first.
        _query = (query ?? "").TrimStart(':');
        _cursor = _subject = 0;
        Search();
    }

    private void Search()
    {
        _groups = JumpIndex.Grouped(_query, [.. _targets, .. _everywhere ? _elsewhere ?? [] : [], .. _namespaces.Select(ns => new JumpTarget.Namespace(ns))]);
        _results = [.. _groups.SelectMany(g => g.Targets)];
    }

    // Kind, or for another namespace's entity that namespace, or for a namespace its subscription.
    private static string Line(JumpTarget t)
    {
        var info = t.DeadLetters > 0 ? $"{Icons.DeadLetter} {t.DeadLetters:N0}" : "";
        var where = t is JumpTarget.Namespace n ? n.Place.Subscription.Name : t.Elsewhere?.Info.Name ?? t.Kind;
        return $" {Fit(t.Label, 46)}{Fit(where, 22)}{info}".PadRight(Width - 4);
    }

    private static string Fit(string text, int width) => (text.Length < width ? text : text[..(width - 2)] + "…").PadRight(width);

    private static string Line(JumpAction a)
    {
        var text = $"{a.Icon} {a.Text}";
        return $" {(text.Length > 70 ? text[..69] + "…" : text).PadRight(Width - 9)}{a.Key,3}";
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape": _ = Close(); return;
            case "Enter": Activate(); return;
            case "Tab": Open(deadLetters: true); return;
            case "ArrowDown": Move(+1); return;
            case "ArrowUp": Move(-1); return;
            case "P" when e.CtrlKey: RunOnSubject(BrowserCommand.Purge); return;
            case "R" when e.CtrlKey: RunOnSubject(BrowserCommand.Retry); return;
            case "A" when e.CtrlKey: _ = ToggleEverywhereAsync(); return;
        }
    }

    private async Task ToggleEverywhereAsync()
    {
        _everywhere = !_everywhere;
        if (_everywhere && _elsewhere is null)
            _elsewhere = [.. (await Task.WhenAll(_namespaces.Select(ns => JumpTargets.CachedAsync(ns, Cache)))).SelectMany(t => t)];
        _cursor = _subject = 0;
        Search();
        StateHasChanged();
    }

    private void Move(int by)
    {
        _cursor = Math.Clamp(_cursor + by, 0, Math.Max(0, _results.Count + Actions.Count - 1));
        if (_cursor < _results.Count) _subject = _cursor;
        StateHasChanged();
    }

    private void Activate()
    {
        if (_cursor < _results.Count) Open(deadLetters: false);
        else Actions.ElementAtOrDefault(_cursor - _results.Count)?.Run();
    }

    private void Open(bool deadLetters)
    {
        if (_results.ElementAtOrDefault(_subject) is { } target) Open(target, deadLetters);
    }

    private void RunOnSubject(BrowserCommand command)
    {
        if (Actions.Count > 0 && _results.ElementAtOrDefault(_subject) is { } target) Run(target, command);
    }

    /// <summary>Opens the dead-letter browser, which runs its own purge or retry (confirm, progress, activity log) on what it peeked.</summary>
    private void Run(JumpTarget target, BrowserCommand command)
    {
        NavState.StartCommand = command;
        Open(target, deadLetters: true);
    }

    private void Open(JumpTarget target, bool deadLetters) => _ = OpenAsync(target, deadLetters);

    /// <summary>
    /// A queue or subscription on its Active tab, or its dead-letter queue; a topic has none and opens itself. In another
    /// namespace, or a namespace itself (its queues), switches to it first, as the header's picker does.
    /// </summary>
    private async Task OpenAsync(JumpTarget target, bool deadLetters)
    {
        IsOpened = false;
        var route = NavState.RouteTo(target, active: !deadLetters);
        if (target.OtherNamespace is { } place) await Switcher.OpenAsync(place.Subscription, place.Info, route);
        else Switcher.Show(route);
    }

    private async Task Close()
    {
        if (!IsOpened) return;
        IsOpened = false;
        StateHasChanged();
        await OnCancel.InvokeAsync();
    }
}
