
<div class="pick-section" @onclick="HandleClick"><Markup Content="@Section.Label" Foreground="@(Current ? Theme.Accent : Theme.Muted)" Decoration="@(Current ? Decoration.Bold | Decoration.Underline : Decoration.Underline)" /></div>

@code {
    /// <summary>Breadcrumb entry for a section; a click opens the section dropdown.</summary>
    [Parameter, EditorRequired] public required Section Section { get; set; }

    /// <summary>True on the section's own list page (accent), false deeper in (muted).</summary>
    [Parameter] public bool Current { get; set; }

    [CascadingParameter] public ConnectionHeader? Header { get; set; }

    private void HandleClick(MouseEventArgs e) => Header?.OpenSections((int)e.ClientX, (int)e.ClientY + 1);
}
