@typeparam TItem where TItem : notnull
@inject ActivityLog ActivityLog

<ConfirmModal IsOpened="@(_pending is not null)"
              Message="@(_pending?.Text ?? "")"
              MustType="@_pending?.MustType"
              OnConfirm="ExecuteConfirmed"
              OnCancel="Cancel" />

<ErrorModal Message="@_error" OnDismiss="ClearError" />

@code {
    /// <summary>Confirm prompt for the item; without it the command runs at once.</summary>
    [Parameter] public Func<TItem, string>? ConfirmMessage { get; set; }

    /// <summary>The user types yes to confirm (purges); y alone doesn't confirm then.</summary>
    [Parameter] public bool ConfirmByTyping { get; set; }
    [Parameter, EditorRequired] public required Func<TItem, Task> Execute { get; set; }
    [Parameter] public Func<TItem, Task>? OnCompleted { get; set; }
    [Parameter] public Func<Exception, string>? FormatError { get; set; }
    /// <summary>What a successful run did, for the session's activity log; commands that record their own outcome omit it.</summary>
    [Parameter] public Func<TItem, string>? Activity { get; set; }

    private sealed record Pending(TItem Item, string Text, string? MustType);

    private Pending? _pending;
    private bool _running;
    private string _error = "";

    public bool IsBusy => _running;
    public bool IsPending => _pending is not null;

    public void Invoke(TItem item)
    {
        if (_running || _pending is not null) return;
        if (ConfirmMessage is null)
        {
            _ = RunAsync(item);
            return;
        }
        _pending = new(item, ConfirmMessage(item), ConfirmByTyping ? "yes" : null);
        StateHasChanged();
    }

    public void Cancel()
    {
        if (_pending is null) return;
        _pending = null;
        StateHasChanged();
    }

    public bool HandleKey(KeyboardEventArgs e)
    {
        if (_pending is null) return false;
        // Typing to confirm: the keys are text in the modal's input, only Escape cancels from here.
        if (_pending.MustType is not null)
        {
            if (e.Key != "Escape") return false;
            Cancel();
            return true;
        }
        switch (e.Key)
        {
            case "Y" or "y" or "Enter": ExecuteConfirmed(); return true;
            case "N" or "n" or "Escape": Cancel(); return true;
            default: return false;
        }
    }

    // Not awaited: the key or click that confirmed must not hold up input (e.g. Esc to cancel) while it runs.
    private void ExecuteConfirmed()
    {
        if (_pending is not { Item: var item }) return;
        _pending = null;
        _ = RunAsync(item);
    }

    private async Task RunAsync(TItem item)
    {
        _running = true;
        _error = "";
        StateHasChanged();
        try
        {
            await Execute(item);
            if (Activity is not null) ActivityLog.Record(ActivityKind.Operation, Activity(item));
            if (OnCompleted is not null) await OnCompleted(item);
        }
        catch (Exception ex)
        {
            _error = FormatError?.Invoke(ex) ?? ErrorText.Of(ex).Split('\n')[0];
        }
        _running = false;
        StateHasChanged();
    }

    private void ClearError()
    {
        _error = "";
        StateHasChanged();
    }
}
