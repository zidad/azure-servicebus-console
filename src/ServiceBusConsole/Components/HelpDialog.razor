<Dialog IsOpened="@IsOpened" Icon="@Icons.Help" Title="@ComponentStrings.HelpDialog_Title">
    <ChildContent>
        <Markup Content="@ComponentStrings.HelpDialog_Intro" Foreground="@Theme.Muted" />
        <Newline />
        @foreach (var binding in _bindings)
        {
            <Columns>
                <Markup Content="@($" {binding.Display} ".PadLeft(8))" Background="@(binding.Danger ? Theme.Danger : Theme.Chip)" Foreground="@(binding.Danger ? Theme.OnDanger : Theme.OnChip)" Decoration="@Decoration.Bold" />
                <Markup Content="@binding.Label" />
                @if (binding.Aliases.Count > 0) { <Markup Content="@string.Join(" ", binding.Aliases)" Foreground="@Theme.Muted" /> }
            </Columns>
        }
        <Newline />
        <Markup Content="@ComponentStrings.HelpDialog_ShiftNote" Foreground="@Theme.Muted" />
    </ChildContent>
    <Buttons>
        <KeyButton Key="esc" Content="@ComponentStrings.Dialog_Close" OnClick="Close" FocusOrder="1" OnKeyDown="HandleKey" AutoFocus="true" />
    </Buttons>
</Dialog>

@code {
    /// <summary>The page's keys, opened with <c>?</c>: every <see cref="KeyBinding"/>, also those not in the footer.</summary>
    public bool IsOpened { get; private set; }

    /// <summary>Gets focus back when closed.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private IReadOnlyList<KeyBinding> _bindings = [];

    public void Open(IEnumerable<KeyBinding> bindings)
    {
        _bindings = [.. bindings];
        IsOpened = true;
        StateHasChanged();
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Enter" or "?") _ = Close();
    }

    private Task Close()
    {
        IsOpened = false;
        StateHasChanged();
        return OnClose.InvokeAsync();
    }
}
