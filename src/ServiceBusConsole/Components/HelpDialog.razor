@inject RazorConsole.Core.Focus.FocusManager FocusManager

<ModalWindow IsOpened="@IsOpened">
    <Panel Border="BoxBorder.Rounded" Title="❓ Keys" BorderColor="@Theme.Accent" Padding="@(new(2, 1, 2, 1))">
        <Rows>
            <Markup Content="Letters act on the page; / filters. F-keys from earlier versions still work." Foreground="@Theme.Muted" />
            <Newline />
            @foreach (var binding in _bindings)
            {
                <Columns>
                    <Markup Content="@($" {binding.Display} ".PadLeft(8))" Background="@(binding.Danger ? Theme.Danger : Theme.Chip)" Foreground="@(binding.Danger ? Theme.OnDanger : Theme.OnChip)" Decoration="@Decoration.Bold" />
                    <Markup Content="@binding.Label" />
                    @if (binding.Aliases.Count > 0) { <Markup Content="@string.Join(" ", binding.Aliases)" Foreground="@Theme.Muted" /> }
                </Columns>
            }
            <Newline />
            <Markup Content="Shift marks the keys that delete or move messages." Foreground="@Theme.Muted" />
            <Padder Padding="@(new(0, 1, 0, 0))">
                <KeyButton @ref="_close" Key="esc" Content="Close" OnClick="Close" FocusOrder="1" OnKeyDown="HandleKey" />
            </Padder>
        </Rows>
    </Panel>
</ModalWindow>

@code {
    /// <summary>The page's keys, opened with <c>?</c>: every <see cref="KeyBinding"/>, also those not in the footer.</summary>
    public bool IsOpened { get; private set; }

    /// <summary>Gets focus back when closed.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private IReadOnlyList<KeyBinding> _bindings = [];
    private KeyButton? _close;
    private bool _focusPending;

    public void Open(IEnumerable<KeyBinding> bindings)
    {
        _bindings = [.. bindings];
        IsOpened = true;
        _focusPending = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending || _close is null) return;
        _focusPending = false;
        await FocusManager.FocusAsync(_close.FocusKey);
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Enter" or "?") _ = Close();
    }

    private Task Close()
    {
        IsOpened = false;
        StateHasChanged();
        return OnClose.InvokeAsync();
    }
}
