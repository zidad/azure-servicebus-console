@inject ServiceBusConnection Connection
@inject NavigationState NavState

<Panel BorderColor="@Theme.Border" FillWidth="true" Padding="@(new(0, 0, 0, 0))">
    <Columns>
        @if (Connection.Current is { Info: var ns })
        {
            <div class="pick-subscription" @onclick="OpenSubscriptions"><Markup Content="@SubscriptionLabel" Foreground="@Theme.Muted" Decoration="@Decoration.Underline" /></div>
            <Markup Content=" › " Foreground="@Theme.Muted" />
            <div class="pick-namespace" @onclick="OpenNamespaces"><Markup Content="@($"{Icons.Namespace} {ns.Name}")" Decoration="@Decoration.Underline" /></div>
            <Markup Content=" › " Foreground="@Theme.Muted" />
        }
        <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
    </Columns>
</Panel>

<ConnectionPicker @ref="_picker" />

@code {
    /// <summary>Page breadcrumb: Markup pieces, shown after the subscription and namespace.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ConnectionPicker? _picker;

    private string SubscriptionName => NavState.AzureSubscription?.Name ?? "";

    private string SubscriptionIcon => NavState.AzureSubscription?.IsEmulator == true ? Icons.Emulator : Icons.AzureSubscription;

    private string SubscriptionLabel => $"{SubscriptionIcon} {SubscriptionName}";

    // Panel border + padding put the subscription at x = 2; the dropdown opens there, whichever crumb was clicked.
    private const int SubscriptionX = 2;

    private ExplorerNode.Subscription? SubscriptionNode => NavState.AzureSubscription is { } s ? new(s) : null;

    private ExplorerNode.Namespace? NamespaceNode =>
        SubscriptionNode is { } s && Connection.Current is { Info: var ns } ? new(s, ns) : null;

    private void OpenSubscriptions(MouseEventArgs e) => _picker?.Open(SubscriptionX - 1, (int)e.ClientY + 1, SubscriptionNode?.Key);

    private void OpenNamespaces(MouseEventArgs e) => _picker?.Open(SubscriptionX - 1, (int)e.ClientY + 1, NamespaceNode?.Key);

    /// <summary>Opens the dropdown under a clicked <see cref="SectionCrumb"/>, at that section of the current namespace.</summary>
    public void OpenSections(Section section, int top) =>
        _picker?.Open(SubscriptionX - 1, top, NamespaceNode is { } ns ? new ExplorerNode.Page(ns, section).Key : null);

    /// <summary>Item count for a page header: "(3)", or "(1 of 3)" while filtered.</summary>
    public static string Count(int shown, int total) => shown == total ? $"({total})" : $"({shown} of {total})";
}
