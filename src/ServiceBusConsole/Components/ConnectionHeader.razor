@inject CurrentBroker Current
@inject NavigationState NavState
@inject ITerminalViewport Viewport

<Rows FillWidth="true">
    <Flex Justify="FlexJustify.SpaceBetween" FillWidth="true">
        <Columns>
            <Markup Content="azsb" Foreground="@Theme.Accent" Decoration="@Decoration.Bold" />
            <Markup Content=" │ " Foreground="@Theme.Border" />
            @if (Current.Broker is { Info: var ns })
            {
                <div class="pick-subscription" @onclick="OpenConnections"><Markup Content="@ConnectionLabel" Foreground="@Theme.Muted" Decoration="@Decoration.Underline" /></div>
                <Markup Content=" › " Foreground="@Theme.Muted" />
                <div class="pick-namespace" @onclick="OpenBrokers"><Markup Content="@($"{Terms.Broker.Icon} {ns.Name}")" Decoration="@Decoration.Underline" /></div>
                <Markup Content=" › " Foreground="@Theme.Muted" />
            }
            <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
        </Columns>
        @Status
    </Flex>
    <Markup Content="@(new string('─', Math.Max(1, Viewport.Width)))" Foreground="@Theme.Border" />
</Rows>

<ConnectionPicker @ref="_picker" />

@code {
    /// <summary>Page breadcrumb: Markup pieces, shown after the subscription and namespace.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Right-aligned status, e.g. <see cref="LiveStatus{T}"/>.</summary>
    [Parameter] public RenderFragment? Status { get; set; }

    private ConnectionPicker? _picker;

    private string SubscriptionName => NavState.Connection?.Name ?? "";

    private string ConnectionIcon => NavState.Connection?.IsEmulator == true ? Icons.Emulator : Terms.Connection.Icon;

    private string ConnectionLabel => $"{ConnectionIcon} {SubscriptionName}";

    // "azsb │ " puts the subscription at x = 7; the dropdown opens there, whichever crumb was clicked.
    private const int ConnectionX = 7;

    private ExplorerNode.Connection? ConnectionNode => NavState.Connection is { } s ? new(s) : null;

    private ExplorerNode.Broker? BrokerNode =>
        ConnectionNode is { } s && Current.Broker is { Info: var ns } ? new(s, ns) : null;

    private void OpenConnections(MouseEventArgs e) => _picker?.Open(ConnectionX - 1, (int)e.ClientY + 1, ConnectionNode?.Key);

    private void OpenBrokers(MouseEventArgs e) => _picker?.Open(ConnectionX - 1, (int)e.ClientY + 1, BrokerNode?.Key);

    /// <summary>Opens the dropdown under a clicked <see cref="SectionCrumb"/>, at the current namespace; the tabs switch sections.</summary>
    public void OpenSections(int top) => _picker?.Open(ConnectionX - 1, top, BrokerNode?.Key);

    /// <summary>Item count for a page header: "(3)", or "(1 of 3)" while filtered.</summary>
    public static string Count(int shown, int total) => shown == total ? ComponentStrings.FormatConnectionHeader_Count(total) : ComponentStrings.FormatConnectionHeader_CountFiltered(shown, total);
}
