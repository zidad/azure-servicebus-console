@using System.Globalization
@implements IDisposable
@inject NavigationManager Nav
@inject MessageBrowserStore Store
@inject NavigationState NavState
@inject RazorConsole.Core.Focus.FocusManager FocusManager
@inject ITerminalViewport Viewport
@inject PluginActions PluginActions
@inject SessionContext Session

<FullscreenPage OnKeyDown="HandleKeyDown">
    <Header>
        @Breadcrumb
        @if (_isDlq) { <Markup Content="@($"{Icons.DeadLetter} {Strings.Dlq}")" Foreground="@Theme.Danger" Decoration="@Decoration.Bold" /> }
        @if (_browser is { } header)
        {
            <Markup Content="·" Foreground="@Theme.Muted" />
            <Markup Content="@ModeLabel(header.Mode)" Foreground="@ModeColor(header.Mode)" />
        }
        @if (_isAutoForwarding) { <Markup Content="@($"· {Icons.Transfer} {ComponentStrings.MessageBrowserView_AutoForwarding}")" Foreground="@Theme.Transfer" /> }
    </Header>
    <Content>
        <SourceTabs Entity="@Entity" IsDlq="@_isDlq" OnSwitch="@(dlq => { _ = SwitchDlq(dlq); })">
            <Columns>
                <Markup Content="@($" {ModeBadge(Mode)} ")" Background="@ModeColor(Mode)" Foreground="@OnModeColor(Mode)" Decoration="@Decoration.Bold" />
                <Markup Content="@ModeNote(Mode)" Foreground="@Theme.Muted" />
            </Columns>
        </SourceTabs>
        @* A load shows the spinner only until its first page arrives; then the list fills in. *@
        @if (_browser is not { } browser || (_loading is not null && browser.Messages.Count == 0))
        {
            <Columns>
                <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                <Markup Content="@(_loading ?? ComponentStrings.MessageBrowserView_Loading)" Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
                @if (_loading is not null) { <Markup Content="@ComponentStrings.MessageBrowserView_EscCancels" Foreground="@Theme.Muted" /> }
            </Columns>
        }
        else if (browser.Messages.Count > 0)
        {
            var showChecks = browser.Selected.Count > 0;
            @if (browser.Mode != BrowseMode.Peek && browser.Operation is not { Modal: false })
            {
                @* Locked or already deleted: a full-width strip, hard to miss. *@
                <Markup Content="@ModeStrip(browser).PadRight(Math.Max(0, Viewport.Width - 2))" Background="@ModeColor(browser.Mode)" Foreground="@OnModeColor(browser.Mode)" Decoration="@Decoration.Bold" />
            }
            else
            {
                <Columns>
                    <Markup Content="@StatusCount(browser)" />
                    @if (browser.Selected.Count > 0)
                    {
                        <Markup Content="@($"· {Icons.Selected} {ComponentStrings.FormatMessageBrowserView_Selected(browser.Selected.Count)}")" Foreground="@Theme.Accent" Decoration="@Decoration.Bold" />
                    }
                    @if (browser.Operation is { Modal: false } load)
                    {
                        <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                        <Markup Content="@ComponentStrings.FormatMessageBrowserView_LoadProgress(load.Title, load.Steps[0].Done.ToString("N0"))" Foreground="@Theme.Warning" />
                    }
                    else
                    {
                        <Markup Content="@ComponentStrings.MessageBrowserView_SelectHints" Foreground="@Theme.Muted" />
                    }
                </Columns>
            }

            <SelectableList Items="@browser.Messages"
                        PageSize="@Split.Rows"
                        Scrollbar="@Theme.Scrollbar()"
                        SelectedIndex="@browser.Cursor"
                        SelectedIndexChanged="@(i => browser.Cursor = i)"
                        OnToggle="@(i => ToggleAt(i))"
                        OnActivate="@(() => { if (browser.Operation is not { Modal: true } && browser.Focused is { } m) ViewMessage(m); })">
                <SpectreTable BorderColor="@Theme.Border" Expand="true" Border="TableBorder.Rounded" ColumnSeparators="false">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH Width="@Gutter.Width" Padding="@Gutter.Header"><div class="check-all" @onclick="ToggleAll"><RowCheck Checked="@browser.AllSelected" /></div></SpectreTH>
                            <SpectreTH Align="Justify.Right" Width="@SequenceWidth(browser)">#</SpectreTH>
                            <SpectreTH Align="Justify.Left">@Strings.MessageId</SpectreTH>
                            <SpectreTH Align="Justify.Left">@Strings.Subject</SpectreTH>
                            @if (_isDlq) { <SpectreTH Align="Justify.Left">@ComponentStrings.MessageBrowserView_Reason</SpectreTH> }
                            <SpectreTH Align="Justify.Left">@Strings.Enqueued</SpectreTH>
                            <SpectreTH Align="Justify.Right">@ComponentStrings.MessageBrowserView_Delivery</SpectreTH>
                            @if (browser.Mode == BrowseMode.Locked) { <SpectreTH Align="Justify.Left">@ComponentStrings.MessageBrowserView_Lock</SpectreTH> }
                        </SpectreTR>
                    </SpectreTHead>
                    <NavigableTBody @ref="_tbody"
                                  FocusOrder="1"
                                  OnKeyDown="@HandleKeyDown">
                        @{ var i = 0; }
                        @foreach (var m in context.Items)
                        {
                            var idx = i++;
                            var isCursor = context.CurrentOffset + idx == browser.Cursor;
                            var selected = browser.IsSelected(m);
                            <SelectableRow @key="m.SequenceNumber" RowIndex="@idx">
                                <SpectreTD data-padding="@Gutter.Cell">
                                    @if (showChecks || isCursor)
                                    {
                                        <div class="check" @onclick="@ToggleHandler(m)" @onclick:stopPropagation="true"><RowCheck Checked="@selected" /></div>
                                    }
                                </SpectreTD>
                                <SpectreTD Align="Justify.Right">@m.SequenceNumber</SpectreTD>
                                <SpectreTD>@Truncate(m.MessageId, 30)</SpectreTD>
                                <SpectreTD>@Truncate(m.Subject, 25)</SpectreTD>
                                @if (_isDlq) { <SpectreTD><Markup Content="@Truncate(m.DeadLetterReason ?? "", 25)" Foreground="@Theme.Danger" /></SpectreTD> }
                                <SpectreTD><Markup Content="@RelativeTime.Ago(m.EnqueuedTime, DateTimeOffset.UtcNow)" Foreground="@Theme.Muted" /></SpectreTD>
                                <SpectreTD Align="Justify.Right"><Markup Content="@m.DeliveryCount.ToString()" Foreground="@(m.DeliveryCount > 1 ? Theme.Warning : Theme.Muted)" /></SpectreTD>
                                @if (browser.Mode == BrowseMode.Locked)
                                {
                                    <SpectreTD>
                                        <Markup Content="@(browser.IsLockHeld(m) ? $"{Icons.Locked} {ComponentStrings.MessageBrowserView_LockHeld}" : $"{Icons.Unlocked} {ComponentStrings.MessageBrowserView_LockLost}")"
                                                Foreground="@(browser.IsLockHeld(m) ? Theme.Success : Theme.Danger)" />
                                    </SpectreTD>
                                }
                            </SelectableRow>
                        }
                    </NavigableTBody>
                </SpectreTable>
            </SelectableList>

            @if (browser.Focused is { } focused)
            {
                <MessagePreview Message="@focused" Browser="@browser" Width="@Viewport.Width" Height="@PreviewHeight(browser)" BodyFocusOrder="2" OnKeyDown="@HandleKeyDown"
                                Title="@($"{Icons.Message} {ComponentStrings.FormatMessageBrowserView_PreviewTitle(focused.SequenceNumber, browser.Cursor + 1, browser.Messages.Count)}")" />
            }
        }
        else
        {
            <Markup Content="@(_isAutoForwarding ? ComponentStrings.MessageBrowserView_AutoForwardingEnabled : EmptyText(browser.Mode))"
                    Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
        }
    </Content>
    <Footer>
        <KeyHints Bindings="@Keys" FirstFocusOrder="3" OnKeyDown="@HandleKeyDown" />
    </Footer>
</FullscreenPage>

@* Loads are not awaited by the submitting key, so keys (Esc to cancel) keep working while they run. *@
<FetchDialog @ref="_peekDialog" OnSubmit="@(r => { _ = Peek(r); })" OnCancel="FocusTable" />
<FetchDialog @ref="_receiveDialog" IsReceive="true" DefaultCount="10" OnSubmit="@(r => { _ = Receive(r); })" OnCancel="FocusTable" />

<OperationDialog Operation="@_browser?.Operation" OnDismiss="DismissOperation" />

<ErrorModal Message="@_error" OnDismiss="@(() => { _error = ""; FocusTable(); })" />

<MessageActionsDialog @ref="_actions" OnClosed="StateHasChanged" />
<HelpDialog @ref="_help" OnClose="@(() => _tbody is { } t ? FocusManager.FocusAsync(t.FocusKey) : Task.CompletedTask)" />
<JumpDialog @ref="_jump" OnCancel="FocusTable" />

<AsyncCommand @ref="_complete" TItem="IReadOnlyList<MessageInfo>"
              ConfirmMessage="@(l => ComponentStrings.FormatMessageBrowserView_ConfirmComplete(Count(l), Source.DisplayName))"
              Execute="@(l => Browser.CompleteAsync(l))" />

<AsyncCommand @ref="_abandon" TItem="IReadOnlyList<MessageInfo>"
              Execute="@(l => Browser.AbandonAsync(l))" />

<AsyncCommand @ref="_deadLetter" TItem="IReadOnlyList<MessageInfo>"
              ConfirmMessage="@(l => ComponentStrings.FormatMessageBrowserView_ConfirmDeadLetter(Count(l)))"
              Execute="@(l => Browser.DeadLetterAsync(l))" />

<AsyncCommand @ref="_retry" TItem="IReadOnlyList<MessageInfo>"
              ConfirmMessage="@(l => RetryText.Confirm(Mode, Source, Count(l), Browser.Namespace is IHasTransactions))"
              Execute="@(l => Browser.RetryAsync(l))" />

<AsyncCommand @ref="_resend" TItem="IReadOnlyList<MessageInfo>"
              ConfirmMessage="@(l => ComponentStrings.FormatMessageBrowserView_ConfirmResend(Count(l), Source.SendTarget, Source.DisplayName, TopicNote))"
              Execute="@(l => Browser.ResendAsync(l))" />

<AsyncCommand @ref="_purge" TItem="MessageSource"
              ConfirmMessage="@(source => ComponentStrings.FormatMessageBrowserView_ConfirmPurge(source.DisplayName))"
              ConfirmByTyping="true"
              Execute="@(_ => Browser.PurgeAsync())" />

@code {
    /// <summary>The # column fits the longest sequence number: a fixed width takes no share of the spare space.</summary>
    private int SequenceWidth(MessageBrowser browser) => 2 + browser.Messages.Select(m => m.SequenceNumber.ToString(CultureInfo.InvariantCulture).Length).DefaultIfEmpty(1).Max();

    /// <summary>The entity to browse; <see cref="MessageSource.IsDlq"/> is the initial view.</summary>
    [Parameter, EditorRequired] public required MessageSource Entity { get; set; }
    [Parameter, EditorRequired] public RenderFragment Breadcrumb { get; set; } = _ => { };
    [Parameter, EditorRequired] public string BackPath { get; set; } = "/";

    private const int DefaultPeekCount = 100;

    private MessageBrowser? _browser;
    private bool _isDlq;
    private bool _isAutoForwarding;
    private string? _loading;
    private string _error = "";
    private NavigableTBody? _tbody;
    private NavigableTBody? _focusedTbody;

    private FetchDialog? _peekDialog;
    private FetchDialog? _receiveDialog;
    private MessageActionsDialog? _actions;
    private HelpDialog? _help;
    private JumpDialog? _jump;
    private AsyncCommand<IReadOnlyList<MessageInfo>>? _complete;
    private AsyncCommand<IReadOnlyList<MessageInfo>>? _abandon;
    private AsyncCommand<IReadOnlyList<MessageInfo>>? _deadLetter;
    private AsyncCommand<IReadOnlyList<MessageInfo>>? _retry;
    private AsyncCommand<IReadOnlyList<MessageInfo>>? _resend;
    private AsyncCommand<MessageSource>? _purge;

    private MessageBrowser Browser => _browser ?? throw new InvalidOperationException("Message browser not initialized");
    private MessageSource Source => Entity with { IsDlq = _isDlq };
    private BrowseMode Mode => _browser?.Mode ?? BrowseMode.Peek;
    private bool CanRetry => RetryText.CanRetry(Mode, _isDlq);
    private BrowserSplit Split => FullscreenLayout.Browser(Viewport.Height);

    // A short list leaves rows unused; the preview takes them.
    private int PreviewHeight(MessageBrowser browser) => Split.Preview + Math.Max(0, Split.Rows - browser.Messages.Count);
    private string TopicNote => Source is MessageSource.Subscription ? ComponentStrings.MessageBrowserView_TopicNote : "";

    private IEnumerable<AsyncCommand<IReadOnlyList<MessageInfo>>?> ListCommands => [_complete, _abandon, _deadLetter, _retry, _resend];
    private bool IsBusy => _loading is not null || ListCommands.Any(c => c?.IsBusy == true) || _purge?.IsBusy == true;
    private bool IsDialogOpen => _peekDialog?.IsOpened == true || _receiveDialog?.IsOpened == true || _actions?.IsOpened == true || _help?.IsOpened == true || _jump?.IsOpened == true;

    protected override async Task OnInitializedAsync()
    {
        // Coming back from the message detail page: keep the list, selection and locks.
        _isDlq = Store.Current is { } current && current.Source with { IsDlq = Entity.IsDlq } == Entity
            ? current.Source.IsDlq
            : Entity.IsDlq;
        if (Attach()) await Peek(new FetchDialog.Request(DefaultPeekCount, null, false));
        // Back from the detail page after it handled the last message: nothing left to browse.
        else if (Browser.Messages.Count == 0) GoBack();
    }

    // Nothing left after a purge or acting on every message: back to the list.
    private void DismissOperation()
    {
        Browser.Dismiss();
        if (Browser.Messages.Count == 0) GoBack();
        else FocusTable();
    }

    public void Dispose()
    {
        if (_browser is not null) _browser.Changed -= OnBrowserChanged;
    }

    private bool Attach()
    {
        if (_browser is not null) _browser.Changed -= OnBrowserChanged;
        var (browser, isNew) = Store.Open(Source);
        _browser = browser;
        _browser.Changed += OnBrowserChanged;
        return isNew;
    }

    private void OnBrowserChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_tbody is not null && _tbody != _focusedTbody && !IsDialogOpen && _browser?.Operation is not { Finished: true })
        {
            _focusedTbody = _tbody;
            await FocusManager.FocusAsync(_tbody.FocusKey);
        }
    }

    private void FocusTable()
    {
        _focusedTbody = null;
        StateHasChanged();
    }

    private async Task SwitchDlq(bool dlq)
    {
        if (IsBusy) return;
        _isDlq = dlq;
        Attach();
        await Peek(new FetchDialog.Request(DefaultPeekCount, null, false));
    }

    private Task Peek(FetchDialog.Request request) =>
        Load(ComponentStrings.MessageBrowserView_Peeking, () => Browser.PeekAsync(request.Count, request.FromSequenceNumber));

    private Task Receive(FetchDialog.Request request) =>
        Load(request.DeleteOnReceive ? ComponentStrings.MessageBrowserView_ReceivingAndDeleting : ComponentStrings.MessageBrowserView_ReceivingAndLocking,
            () => Browser.ReceiveAsync(request.Count, request.DeleteOnReceive));

    private async Task Load(string label, Func<Task> load)
    {
        if (_loading is not null) return;
        _loading = label;
        _error = "";
        _isAutoForwarding = false;
        StateHasChanged();
        try { await load(); }
        catch (Exception ex) when (ex.Message.Contains("auto-forwarding", StringComparison.OrdinalIgnoreCase)) { _isAutoForwarding = true; }
        catch (Exception ex) { _error = ErrorText.Of(ex).Split('\n')[0]; }
        _loading = null;
        FocusTable();
    }

    private void Run(AsyncCommand<IReadOnlyList<MessageInfo>>? command)
    {
        if (command is null || IsBusy || _browser is not { } browser) return;
        var targets = browser.Targets;
        if (targets.Count > 0) command.Invoke(targets);
    }

    private void Toggle(MessageInfo m)
    {
        Browser.Toggle(m);
        StateHasChanged();
    }

    // One delegate per row keeps its event handler id stable across renders; a fresh lambda
    // gets a new id each render, and a click spanning a render would hit a stale one.
    private readonly Dictionary<long, Action> _toggleHandlers = [];

    private Action ToggleHandler(MessageInfo m)
    {
        if (!_toggleHandlers.TryGetValue(m.SequenceNumber, out var handler))
            _toggleHandlers[m.SequenceNumber] = handler = () => ToggleBySequence(m.SequenceNumber);
        return handler;
    }

    private void ToggleBySequence(long sequenceNumber)
    {
        if (Browser.Messages.FirstOrDefault(x => x.SequenceNumber == sequenceNumber) is { } m) Toggle(m);
    }

    private void ToggleAll()
    {
        Browser.ToggleAll();
        StateHasChanged();
    }

    private void ToggleAt(int index)
    {
        if (Browser.Messages.ElementAtOrDefault(index) is { } m) Toggle(m);
    }

    /// <summary>How many messages the selection commands act on, after their label: " 2"; none for the message under the cursor.</summary>
    private string Targets => _browser is { Selected.Count: > 0 and var n } ? $" {n}" : "";

    private IReadOnlyList<KeyBinding> Keys =>
    [
        new("Enter", $"{Icons.Message} {ComponentStrings.Dialog_Open}", () => { if (_browser?.Focused is { } m) ViewMessage(m); }) { InFooter = false },
        new("p", $"{Icons.Peek} {ComponentStrings.MessageBrowserView_Peek}", () => _peekDialog?.Open()) { Aliases = ["F7"] },
        new("r", $"{Icons.Subscription} {ComponentStrings.MessageBrowserView_Receive}", () => _receiveDialog?.Open()) { Aliases = ["F8"] },
        new("1", $"{Icons.Queue} {Strings.Active}", () => { if (_isDlq) _ = SwitchDlq(false); }) { InFooter = _isDlq, Aliases = _isDlq ? ["F6"] : [] },
        new("2", $"{Icons.DeadLetter} {Strings.Dlq}", () => { if (!_isDlq) _ = SwitchDlq(true); }) { InFooter = !_isDlq, Aliases = _isDlq ? [] : ["F6"] },
        .. Mode == BrowseMode.Locked
            ? [new KeyBinding("c", $"{Icons.Complete} {Strings.Complete}{Targets}", () => Run(_complete)) { Danger = true, Aliases = ["F9", "Delete"] },
               new KeyBinding("a", $"{Icons.Unlocked} {Strings.Abandon}{Targets}", () => Run(_abandon)) { Aliases = ["F4"] },
               .. _isDlq ? Array.Empty<KeyBinding>()
                   : [new KeyBinding("X", $"{Icons.DeadLetter} {ComponentStrings.SourceTabs_DeadLetter}{Targets}", () => Run(_deadLetter)) { Danger = true, Aliases = ["F3"] }]]
            : Array.Empty<KeyBinding>(),
        .. CanRetry
            ? [new KeyBinding("R", $"{Icons.Retry} {RetryText.Label(_isDlq)}{Targets}", () => Run(_retry)) { Danger = true, Aliases = ["F10"] }]
            : Mode == BrowseMode.Peek
                ? [new KeyBinding("R", $"{Icons.Send} {Strings.Resend}{Targets}", () => Run(_resend)) { Danger = true, Aliases = ["F10"] }]
                : Array.Empty<KeyBinding>(),
        new("P", $"{Icons.Purge} {Strings.Purge}", () => _purge?.Invoke(Source)) { Danger = true, Aliases = ["F11"] },
        .. _browser?.Focused is { } target && PluginActions.Any(target, Source, Session.Snapshot)
            ? [new KeyBinding(".", $"{Icons.Actions} {Strings.Actions}", OpenActions) { Aliases = ["F2"] }]
            : Array.Empty<KeyBinding>(),
        new(" ", ComponentStrings.MessageBrowserView_Select, () => { }) { InFooter = false },
        new("a", ComponentStrings.MessageBrowserView_SelectAll, () => { Browser.SelectAll(); StateHasChanged(); }) { Ctrl = true, InFooter = false },
        new("i", ComponentStrings.MessageBrowserView_InvertSelection, () => { Browser.InvertSelection(); StateHasChanged(); }) { InFooter = false },
        new(":", $"{Icons.Filter} {Strings.Jump}", () => _ = _jump?.OpenAsync()) { InFooter = false },
        new("?", $"{Icons.Confirm} {Strings.Help}", () => _help?.Open(Keys)),
        new("Escape", $"{Icons.Back} {Strings.Back}", GoBack),
    ];

    private void OpenActions()
    {
        if (_browser?.Focused is { } message) _actions?.Open(message, Source);
    }

    private void ViewMessage(MessageInfo msg)
    {
        NavState.Message = msg;
        NavState.MessageSource = Source;
        Nav.NavigateTo("/message");
    }

    private void GoBack()
    {
        _ = Store.CloseAsync();
        Nav.NavigateTo(BackPath);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.AltKey || e.MetaKey || IsDialogOpen) return;
        // A finished operation's dialog waits for OK, also when focus is still here.
        if (_browser?.Operation is { Finished: true })
        {
            if (e.Key is "Escape" or "Enter") DismissOperation();
            return;
        }
        if (e.Key == "Escape" && _browser?.Operation is { Finished: false } running)
        {
            running.Cancel();
            StateHasChanged();
            return;
        }
        if (ListCommands.Any(c => c?.HandleKey(e) == true) || _purge?.HandleKey(e) == true) return;
        if (e.Key == "Escape")
        {
            if (_browser is { Selected.Count: > 0 } b) { b.Selected.Clear(); StateHasChanged(); }
            else GoBack();
            return;
        }
        if (IsBusy) return;
        KeyBinding.Dispatch(Keys, e);
    }

    private static string Count(IReadOnlyList<MessageInfo> list) =>
        list is [var single] ? Strings.FormatOneMessage(single.SequenceNumber) : Strings.FormatMessages(list.Count);

    private static string ModeLabel(BrowseMode mode) => mode switch
    {
        BrowseMode.Locked => $"{Icons.Locked} {ComponentStrings.MessageBrowserView_ModeLocked}",
        BrowseMode.Received => $"{Icons.Received} {ComponentStrings.MessageBrowserView_ModeReceived}",
        _ => $"{Icons.Peek} {ComponentStrings.MessageBrowserView_ModePeek}",
    };

    private static string ModeBadge(BrowseMode mode) => mode switch
    {
        BrowseMode.Locked => $"{Icons.Locked} {ComponentStrings.MessageBrowserView_BadgeLocked}",
        BrowseMode.Received => $"{Icons.Received} {ComponentStrings.MessageBrowserView_BadgeReceived}",
        _ => $"{Icons.Peek} {ComponentStrings.MessageBrowserView_BadgePeek}",
    };

    private string ModeNote(BrowseMode mode) => mode switch
    {
        BrowseMode.Peek => _browser is { Messages.Count: var n } ? ComponentStrings.FormatMessageBrowserView_ReadOnlyLoaded(n.ToString("N0")) : ComponentStrings.MessageBrowserView_ReadOnly,
        _ => "",
    };

    private static Color OnModeColor(BrowseMode mode) => mode switch
    {
        BrowseMode.Locked => Theme.OnWarning,
        BrowseMode.Received => Theme.OnDanger,
        _ => Theme.OnAccent,
    };

    private static string ModeStrip(MessageBrowser b) => b.Mode switch
    {
        BrowseMode.Locked => $" {ModeBadge(b.Mode)}  {ComponentStrings.FormatMessageBrowserView_LockedStrip(b.Messages.Count.ToString("N0"), b.LockedCount.ToString("N0"))}",
        _ => $" {ModeBadge(b.Mode)}  {ComponentStrings.FormatMessageBrowserView_ReceivedCount(b.Messages.Count.ToString("N0"))}",
    } + (b.Selected.Count > 0 ? $" · {Icons.Selected} {ComponentStrings.FormatMessageBrowserView_Selected(b.Selected.Count)}" : "");

    private static Color ModeColor(BrowseMode mode) => mode switch
    {
        BrowseMode.Locked => Theme.Warning,
        BrowseMode.Received => Theme.Danger,
        _ => Theme.Accent,
    };

    private static string EmptyText(BrowseMode mode) => mode switch
    {
        BrowseMode.Peek => ComponentStrings.MessageBrowserView_Empty,
        _ => ComponentStrings.MessageBrowserView_EmptyLeft,
    };

    private static string StatusCount(MessageBrowser b) => b.Mode switch
    {
        BrowseMode.Locked => $"{Icons.Message} {ComponentStrings.FormatMessageBrowserView_LockedCount(b.Messages.Count, b.LockedCount)}",
        BrowseMode.Received => $"{Icons.Received} {ComponentStrings.FormatMessageBrowserView_ReceivedCount(b.Messages.Count)}",
        _ => $"{Icons.Message} {ComponentStrings.FormatMessageBrowserView_Count(b.Messages.Count)}",
    };

    private static string Truncate(string value, int maxLength) =>
        value.Length <= maxLength ? value : value[..(maxLength - 1)] + "…";
}
