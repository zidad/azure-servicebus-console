<tr data-selected-bg="@(IsSelected ? SelectedBackground.ToMarkup() : null)" data-selected-fg="@(IsSelected ? SelectedForeground.ToMarkup() : null)" @onclick="OnClick" @attributes="AdditionalAttributes">
    @ChildContent
</tr>

@code {
    /// <summary>A row of a <see cref="NavigableTBody"/>: highlighted when selected, selects (or activates) on click.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Index of this row within the visible page.</summary>
    [Parameter, EditorRequired] public int RowIndex { get; set; }

    [Parameter] public Color SelectedBackground { get; set; } = Theme.Selection;

    /// <summary>All text of the selected row: accent, muted and status colors would vanish on the bar.</summary>
    [Parameter] public Color SelectedForeground { get; set; } = Theme.OnSelection;

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object?>? AdditionalAttributes { get; set; }

    [CascadingParameter(Name = "RowNavSelectedIndex")] private int? SelectedIndex { get; set; }
    [CascadingParameter(Name = "RowNavClick")] private Func<int, Task>? RowClick { get; set; }

    private bool IsSelected => SelectedIndex == RowIndex;

    private Task OnClick() => RowClick?.Invoke(RowIndex) ?? Task.CompletedTask;
}
