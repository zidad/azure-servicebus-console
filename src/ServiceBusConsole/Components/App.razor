@using Microsoft.AspNetCore.Components.Routing
@using RazorConsole.Components
@implements IDisposable
@inject NavigationState NavState

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView @key="NavState.PageVersion" RouteData="routeData" />
    </Found>
    <NotFound>
        <Markup Content="Page not found." Foreground="@Theme.Danger" />
    </NotFound>
</Router>

@code {
    protected override void OnInitialized() => NavState.Reloaded += OnReloaded;

    public void Dispose() => NavState.Reloaded -= OnReloaded;

    private void OnReloaded() => _ = InvokeAsync(StateHasChanged);
}
