@using Microsoft.AspNetCore.Components.Routing
@using RazorConsole.Components
@implements IDisposable
@inject NavigationState NavState
@inject NavigationManager Nav
@inject SessionContext Session

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView @key="NavState.PageVersion" RouteData="routeData" />
    </Found>
    <NotFound>
        <Markup Content="@ComponentStrings.App_NotFound" Foreground="@Theme.Danger" />
    </NotFound>
</Router>

@code {
    protected override void OnInitialized()
    {
        NavState.Reloaded += OnReloaded;
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        NavState.Reloaded -= OnReloaded;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void OnReloaded()
    {
        Session.Navigated(Nav.ToBaseRelativePath(Nav.Uri));
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Session.Navigated(Nav.ToBaseRelativePath(e.Location));
}
