@if (Filter.Editing)
{
    <Markup Content="@($"{Icons.Filter} {Filter.Text}▏")" Foreground="@Theme.Accent" Decoration="@Decoration.Bold" />
}
else if (!Filter.IsEmpty)
{
    <Markup Content="@($"{Icons.Filter} {Filter.Text}")" Foreground="@Theme.Accent" Decoration="@Decoration.Bold" />
}
else
{
    <Markup Content="@($"{Icons.Filter} {(Filter.TypeToFilter ? ComponentStrings.ColumnFilter_TypeToFilter : ComponentStrings.ColumnFilter_SlashToFilter)}")" Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
}

@code {
    /// <summary>The list filter, shown in the name column's header: a cursor while it is being edited.</summary>
    [Parameter, EditorRequired] public required ListFilter Filter { get; set; }
}
