
@if (string.IsNullOrEmpty(Filter))
{
    <Markup Content="@($"{Icons.Filter} type to filter")" Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
}
else
{
    <Markup Content="@($"{Icons.Filter} {Filter}")" Foreground="@Theme.Accent" Decoration="@Decoration.Bold" />
}

@code {
    /// <summary>
    /// The list filter, shown in the name column's header. Typing while the table has focus edits it;
    /// Backspace removes a character.
    /// </summary>
    [Parameter] public string? Filter { get; set; }
}
