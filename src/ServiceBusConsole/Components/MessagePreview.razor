
@if (SideBySide)
{
    <Flex Direction="FlexDirection.Row" Gap="@Gap" FillWidth="true">
        @PropertiesPanel(PropertiesWidth, Height)
        @BodyPanel(Width - PropertiesWidth - Gap, Height)
    </Flex>
}
else
{
    <Flex Direction="FlexDirection.Column" FillWidth="true">
        @PropertiesPanel(Width, StackedPropertiesHeight)
        @BodyPanel(Width, Height - StackedPropertiesHeight)
    </Flex>
}

@code {
    /// <summary>Wide enough to put properties and body side by side.</summary>
    private const int SideBySideMinWidth = 100;
    private const int Gap = 1;

    /// <summary>
    /// A message's properties and body in a fixed area of <see cref="Width"/> by <see cref="Height"/> cells:
    /// side by side when wide enough, stacked otherwise. Both scroll when they do not fit.
    /// </summary>
    [Parameter, EditorRequired] public required MessageInfo Message { get; set; }

    /// <summary>Lock state for locked messages; null when unknown.</summary>
    [Parameter] public MessageBrowser? Browser { get; set; }

    [Parameter, EditorRequired] public int Width { get; set; }
    [Parameter, EditorRequired] public int Height { get; set; }

    /// <summary>Tab order of the body's scroll area, so Tab reaches it right after the list.</summary>
    [Parameter] public int? BodyFocusOrder { get; set; }

    /// <summary>Keys the body does not handle while it has focus (arrows scroll it).</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    private bool SideBySide => Width >= SideBySideMinWidth;
    private int PropertiesWidth => Width * 2 / 5;
    private int StackedPropertiesHeight => Math.Max(3, Height * 2 / 5);

    // Panel borders take two lines.
    private static int Inner(int height) => Math.Max(1, height - 2);

    private RenderFragment PropertiesPanel(int width, int height) =>
        @<Panel Title="@($"{Icons.Properties} Properties")" BorderColor="@Theme.Border" Width="@width" Height="@height" Padding="@(new(1, 0, 1, 0))">
            <ViewHeightScrollable LinesToRender="@Inner(height)" Scrollbar="new()" OnKeyDown="@OnKeyDown">
                <SpectreTable Expand="true" Border="TableBorder.None">
                    <SpectreTBody>
                        @foreach (var (name, value, color) in Properties())
                        {
                            <SpectreTR>
                                <SpectreTD><Markup Content="@name" Foreground="@Theme.Muted" /></SpectreTD>
                                <SpectreTD><Markup Content="@value" Foreground="@color" /></SpectreTD>
                            </SpectreTR>
                        }
                    </SpectreTBody>
                </SpectreTable>
            </ViewHeightScrollable>
        </Panel>;

    private RenderFragment BodyPanel(int width, int height) =>
        @<Panel Title="@($"{Icons.Body} Body")" BorderColor="@Theme.Border" Width="@width" Height="@height" Padding="@(new(1, 0, 1, 0))">
            <ViewHeightScrollable LinesToRender="@Inner(height)" Scrollbar="new()" FocusOrder="@BodyFocusOrder" OnKeyDown="@OnKeyDown">
                @if (FormatJson(Message.BodyText) is { } json)
                {
                    <SyntaxHighlighter Code="@json" Language="json" />
                }
                else
                {
                    <Markup Content="@Message.BodyText" />
                }
            </ViewHeightScrollable>
        </Panel>;

    private IEnumerable<(string Name, string Value, Color Color)> Properties()
    {
        var m = Message;
        yield return ("Message ID", m.MessageId, Color.Default);
        yield return ("Sequence #", m.SequenceNumber.ToString(), Color.Default);
        yield return ("Subject", m.Subject, Color.Default);
        yield return ("Content Type", m.ContentType, Color.Default);
        yield return ("Enqueued", m.EnqueuedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss"), Color.Default);
        yield return ("Delivery Count", m.DeliveryCount.ToString(), m.DeliveryCount > 1 ? Theme.Warning : Color.Default);
        yield return ("State", StateText(m), StateColor(m));
        if (m.DeadLetterReason is { } reason) yield return ("Dead-letter reason", reason, Theme.Danger);
        foreach (var (key, value) in m.Properties)
            yield return (key, value, Color.Default);
    }

    private string StateText(MessageInfo m) => m.State switch
    {
        MessageState.Locked => Browser?.IsLockHeld(m) == true ? $"{Icons.Locked} Locked by this console" : $"{Icons.Unlocked} Lock lost (back on the queue)",
        MessageState.Received => $"{Icons.Received} Received and deleted; requeue it or it is gone",
        _ => $"{Icons.Peek} Peeked (read-only)",
    };

    private Color StateColor(MessageInfo m) => m.State switch
    {
        MessageState.Locked => Browser?.IsLockHeld(m) == true ? Theme.Warning : Theme.Danger,
        MessageState.Received => Theme.Danger,
        _ => Theme.Accent,
    };

    private static readonly System.Text.Json.JsonSerializerOptions IndentedJson = new()
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
    };

    /// <summary>The body as indented JSON, or null when it is not JSON.</summary>
    private static string? FormatJson(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            // Bodies sent as AMQP strings arrive JSON-encoded; unwrap one level.
            if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.String)
                return FormatJson(doc.RootElement.GetString() ?? body);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, IndentedJson);
        }
        catch (System.Text.Json.JsonException) { return null; }
    }
}
