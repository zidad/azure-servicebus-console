@inject NavigationState NavState
@inject ServiceBusConnection Connection
@inject ExplorerTree Tree
@inject ITerminalViewport Viewport
@inject RazorConsole.Core.Focus.FocusManager FocusManager

@if (_open)
{
    <div class="connection-picker" position="absolute" left="@_left" top="@_top" data-opaque="true" z-index="100">
        <Panel Title="@(string.IsNullOrEmpty(_filter) ? "Go to" : $"Go to {Icons.Filter} {_filter}")" BorderColor="@Theme.Accent" Padding="@(new(0, 0, 0, 0))">
            <ConnectionTree Compact="true"
                            MaxRows="@Math.Max(3, Viewport.Height - _top - 3)"
                            SelectKey="@_selectKey"
                            OnKeyDown="@HandleKeyDown"
                            FilterChanged="@(f => _filter = f)"
                            OnPicked="Picked" />
        </Panel>
    </div>
}

@code {
    /// <summary>The header's dropdown: the connection tree, opened at the current subscription, namespace and section.</summary>
    private bool _open;
    private int _left;
    private int _top;
    private string? _selectKey;
    private string? _returnFocusKey;
    private string? _filter;

    /// <summary>Opens below a clicked breadcrumb with <paramref name="selectKey"/> (a tree node key) selected.</summary>
    public void Open(int left, int top, string? selectKey)
    {
        if (!_open) _returnFocusKey = FocusManager.CurrentFocusKey;
        if (NavState.AzureSubscription is { } subscription) Tree.Reveal(subscription, Connection.Current?.Info);
        (_open, _left, _top, _selectKey, _filter) = (true, left, top, selectKey, null);
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close(restoreFocus: true);
    }

    private void Picked(bool navigated) => Close(restoreFocus: !navigated);

    private void Close(bool restoreFocus)
    {
        _open = false;
        StateHasChanged();
        if (restoreFocus && _returnFocusKey is { } key) _ = FocusManager.FocusAsync(key);
    }
}
