@implements IDisposable
@inject NavigationManager Nav
@inject NavigationState NavState
@inject ServiceBusConnection Connection
@inject INamespaceService NamespaceService
@inject SubscriptionCatalog Catalog
@inject MessageBrowserStore Store
@inject RazorConsole.Core.Focus.FocusManager FocusManager

@if (_mode != PickerMode.Closed)
{
    <div class="connection-picker" position="absolute" left="@_left" top="@_top" data-opaque="true" z-index="100">
        <Panel Title="@Title" BorderColor="@Theme.Accent" Padding="@(new(0, 0, 0, 0))">
            @if (_mode == PickerMode.Sections)
            {
                <SelectableList Items="@Section.All"
                            PageSize="@Section.All.Count"
                            SelectedIndex="@_index"
                            SelectedIndexChanged="@(i => _index = i)"
                            ActivateOnClick="true"
                            OnActivate="PickSection">
                    <SpectreTable Border="TableBorder.None">
                        <NavigableTBody @ref="_body" OnKeyDown="@HandleKeyDown">
                            @{ var i = 0; }
                            @foreach (var section in context.Items)
                            {
                                var idx = i++;
                                <SelectableRow @key="section.Route" RowIndex="@idx"><SpectreTD>@section.Label</SpectreTD></SelectableRow>
                            }
                        </NavigableTBody>
                    </SpectreTable>
                </SelectableList>
            }
            else if (_mode == PickerMode.Subscriptions)
            {
                <SelectableList Items="@_subscriptions"
                            PageSize="@Math.Clamp(_subscriptions.Count, 1, 10)"
                            Scrollbar="new()"
                            SelectedIndex="@_index"
                            SelectedIndexChanged="@(i => _index = i)"
                            ActivateOnClick="true"
                            OnActivate="PickSubscription">
                    <SpectreTable Border="TableBorder.None">
                        <NavigableTBody @ref="_body" OnKeyDown="@HandleKeyDown">
                            @{ var i = 0; }
                            @foreach (var sub in context.Items)
                            {
                                var idx = i++;
                                <SelectableRow @key="@(sub.Id ?? "")" RowIndex="@idx"><SpectreTD>@($"{(sub.IsEmulator ? Icons.Emulator : Icons.AzureSubscription)} {sub.Name}")</SpectreTD></SelectableRow>
                            }
                        </NavigableTBody>
                    </SpectreTable>
                </SelectableList>
            }
            else if (_namespaces.Count == 0)
            {
                <Columns>
                    @if (_loading)
                    {
                        <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                        <Markup Content="Discovering namespaces..." Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
                    }
                    else
                    {
                        <Markup Content="@(_error ?? "No namespaces.")" Foreground="@Theme.Danger" />
                    }
                    <KeyButton @ref="_closeButton" Content="[Esc] Close" OnClick="Close" FocusedColor="@Theme.Muted" OnKeyDown="@HandleKeyDown" />
                </Columns>
            }
            else
            {
                <SelectableList Items="@_namespaces"
                            PageSize="@Math.Min(_namespaces.Count, 10)"
                            Scrollbar="new()"
                            SelectedIndex="@_index"
                            SelectedIndexChanged="@(i => _index = i)"
                            ActivateOnClick="true"
                            OnActivate="PickNamespace">
                    <SpectreTable Border="TableBorder.None">
                        <NavigableTBody @ref="_body" OnKeyDown="@HandleKeyDown">
                            @{ var i = 0; }
                            @foreach (var ns in context.Items)
                            {
                                var idx = i++;
                                <SelectableRow @key="ns.Name" RowIndex="@idx"><SpectreTD>@($"{Icons.Namespace} {ns.Name}")</SpectreTD></SelectableRow>
                            }
                        </NavigableTBody>
                    </SpectreTable>
                </SelectableList>
            }
        </Panel>
    </div>
}

@code {
    private enum PickerMode { Closed, Sections, Subscriptions, Namespaces }

    private PickerMode _mode;
    private int _left;
    private int _top;
    private int _index;
    private AzureSubscription? _subscription;
    private List<AzureSubscription> _subscriptions = [AzureSubscription.Emulator];
    private List<NamespaceInfo> _namespaces = [];
    private bool _loading;
    private string? _error;
    private CancellationTokenSource _cts = new();
    private NavigableTBody? _body;
    private KeyButton? _closeButton;
    private string? _returnFocusKey;
    private bool _focusPending;

    private string Title => _mode switch
    {
        PickerMode.Sections => "Go to",
        PickerMode.Subscriptions => "Azure subscription",
        _ => $"Namespaces in {_subscription?.Name}",
    };

    public void Dispose()
    {
        Catalog.Changed -= OnCatalogChanged;
        _cts.Cancel();
        _cts.Dispose();
    }

    /// <summary>Opens the subscription list at a screen position (just below the clicked text).</summary>
    public void OpenSubscriptions(int left, int top)
    {
        Open(left, top);
        _cts.Cancel();
        _mode = PickerMode.Subscriptions;
        RefreshSubscriptions(keepHighlight: false);
        _ = Catalog.EnsureLoadedAsync();
        StateHasChanged();
    }

    protected override void OnInitialized() => Catalog.Changed += OnCatalogChanged;

    private void OnCatalogChanged() => _ = InvokeAsync(() =>
    {
        if (_mode != PickerMode.Subscriptions) return;
        RefreshSubscriptions(keepHighlight: true);
        StateHasChanged();
    });

    // Same rule as the connection page: hide subscriptions known to have no Service Bus namespaces.
    private void RefreshSubscriptions(bool keepHighlight)
    {
        var highlighted = keepHighlight ? _subscriptions.ElementAtOrDefault(_index) : null;
        _subscriptions = [.. Catalog.Subscriptions.Where(s => s == NavState.AzureSubscription || Catalog.HasNamespaces(s) != false)];
        _index = Math.Max(0, _subscriptions.IndexOf(highlighted ?? NavState.AzureSubscription ?? AzureSubscription.Emulator));
    }

    /// <summary>Opens the namespace list of the current subscription.</summary>
    public void OpenSections(int left, int top)
    {
        Open(left, top);
        _cts.Cancel();
        _mode = PickerMode.Sections;
        var root = SectionRoot();
        _index = Math.Max(0, Section.All.ToList().FindIndex(s => s.Route == root));
        StateHasChanged();
    }

    private void PickSection()
    {
        var section = Section.All[_index];
        var onIt = "/" + Nav.ToBaseRelativePath(Nav.Uri) == section.Route;
        _returnFocusKey = onIt ? _returnFocusKey : null;
        Close();
        if (!onIt) Nav.NavigateTo(section.Route);
    }

    public void OpenNamespaces(int left, int top)
    {
        Open(left, top);
        _ = ShowNamespaces(NavState.AzureSubscription ?? AzureSubscription.Emulator);
    }

    private void Open(int left, int top)
    {
        if (_mode == PickerMode.Closed) _returnFocusKey = FocusManager.CurrentFocusKey;
        _left = left;
        _top = top;
        _focusPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        var key = _mode == PickerMode.Closed ? null
            : _namespaces.Count == 0 && _mode == PickerMode.Namespaces ? _closeButton?.FocusKey
            : _body?.FocusKey;
        if (key is null) return;
        _focusPending = false;
        await FocusManager.FocusAsync(key);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    private void Close()
    {
        _cts.Cancel();
        _mode = PickerMode.Closed;
        StateHasChanged();
        if (_returnFocusKey is { } key) _ = FocusManager.FocusAsync(key);
    }

    private Task PickSubscription() => ShowNamespaces(_subscriptions[_index]);

    private async Task ShowNamespaces(AzureSubscription subscription)
    {
        _cts.Cancel();
        var token = (_cts = new CancellationTokenSource()).Token;
        _mode = PickerMode.Namespaces;
        _subscription = subscription;
        _namespaces = [];
        _index = 0;
        _error = null;
        _loading = true;
        _focusPending = true;
        StateHasChanged();

        try
        {
            await foreach (var ns in NamespaceService.GetNamespacesAsync(subscription, token))
            {
                if (token.IsCancellationRequested) return;
                var idx = _namespaces.Upsert(ns, x => x.Name == ns.Name);
                if (ns.FullyQualifiedNamespace == Connection.CurrentNamespace) _index = idx;
                // The list replaces the spinner, so focus moves from the close button to it.
                if (_namespaces.Count == 1) _focusPending = true;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) { _error = ex.Message; }

        _loading = false;
        StateHasChanged();
    }

    private async Task PickNamespace()
    {
        if (_subscription is not { } subscription || _namespaces.ElementAtOrDefault(_index) is not { } ns) return;
        _cts.Cancel();
        _mode = PickerMode.Closed;
        _returnFocusKey = null;
        if (ns.FullyQualifiedNamespace == Connection.CurrentNamespace && subscription == NavState.AzureSubscription)
        {
            Close();
            return;
        }

        // The store keys browsers by queue name only; a same-named queue elsewhere must not reuse its locks.
        await Store.CloseAsync();
        NavState.AzureSubscription = subscription;
        var section = SectionRoot();
        Connection.SetNamespace(ns);
        if (Nav.ToBaseRelativePath(Nav.Uri) == section.TrimStart('/')) NavState.Reload();
        else Nav.NavigateTo(section);
    }

    // Names below the section (a queue, topic, message) belong to the old namespace.
    private string SectionRoot()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        if (path.StartsWith("queues")) return "/queues";
        if (path.StartsWith("subscriptions")) return "/subscriptions";
        if (path.StartsWith("message")) return NavState.MessageSource is MessageSource.Subscription ? "/topics" : "/queues";
        if (path.StartsWith("subscription-browser") && NavState.ReturnPath == "/subscriptions") return "/subscriptions";
        return "/topics";
    }
}
