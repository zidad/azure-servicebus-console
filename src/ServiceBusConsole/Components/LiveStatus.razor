@typeparam T

@if (List.UpdatedAt is { } at)
{
    <Columns>
        <Markup Content="●" Foreground="@Theme.Success" />
        <Markup Content="@ComponentStrings.FormatLiveStatus_Live(at.ToLocalTime().ToString("HH:mm:ss"))" Foreground="@Theme.Muted" />
    </Columns>
}
else if (List.All.Count > 0)
{
    <Columns>
        <Markup Content="◐" Foreground="@Theme.Muted" />
        <Markup Content="@ComponentStrings.LiveStatus_Cached" Foreground="@Theme.Muted" />
    </Columns>
}

@code {
    /// <summary>Header status of a list page: when its rows were last loaded live, or that they are cached.</summary>
    [Parameter, EditorRequired] public required LiveList<T> List { get; set; }
}
