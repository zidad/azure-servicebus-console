@page "/topics"

@inject NavigationManager Nav
@inject NavigationState NavState
@inject ServiceBusConnection Connection

<EntityList @ref="_list" TItem="TopicInfo"
            Section="@Section.Topics"
            LoadingText="@PageStrings.TopicList_Loading"
            Load="@(ct => Topics.GetTopicsAsync(ct))"
            Key="@(t => t.Name)"
            IsRefreshing="@(t => t.IsRefreshing)"
            Stale="@(t => t with { IsRefreshing = false })"
            Changes="@_changes"
            Sort="@_sort"
            Matches="@((t, text) => t.Name.Contains(text, StringComparison.OrdinalIgnoreCase))"
            Focus="@NavState.TopicName"
            TrafficEntity="@(t => t.Name)"
            MetricsEntity="@(view => view.FocusedKey)"
            MetricsLabel="@(t => $"{Icons.Topic} {PageStrings.FormatList_MetricsTopic(t)}")"
            OpenLabel="@($"{Icons.Subscription} {Strings.Subscriptions}")"
            OnOpen="@Open"
            Commands="@Commands"
            CommandKey="@(e => _deleteTopic?.HandleKey(e) == true)">
    <Crumb><SectionCrumb Section="@Section.Topics" Current="true" /></Crumb>
    <Headers Context="list">
        <SpectreTH Align="Justify.Left"><Columns><SortHeader Label="@PageStrings.List_ColumnTopic" Sort="_sort" OnSorted="@list.Sorted" /><ColumnFilter Filter="@list.Filter" /></Columns></SpectreTH>
        <SpectreTH Align="Justify.Right"><SortHeader Label="@Strings.Subscriptions" Icon="@Icons.Subscription" Sort="_sort" OnSorted="@list.Sorted" /></SpectreTH>
        <SpectreTH Align="Justify.Right"><SortHeader Label="@PageStrings.List_ColumnScheduled" Icon="@Icons.Scheduled" Sort="_sort" OnSorted="@list.Sorted" /></SpectreTH>
    </Headers>
    <Row Context="t">
        <SpectreTD>@t.Name</SpectreTD>
        <SpectreTD Align="Justify.Right"><CountCell Value="@t.SubscriptionCount" Highlight="@_changes.Highlight(t, "Subscriptions")" /></SpectreTD>
        <SpectreTD Align="Justify.Right"><CountCell Value="@t.ScheduledMessageCount" Color="@Theme.Scheduled" Highlight="@_changes.Highlight(t, "Scheduled")" /></SpectreTD>
    </Row>
</EntityList>

@if (Connection.Current is IHasDeletion { Deletion: var deletion })
{
    <AsyncCommand @ref="_deleteTopic" TItem="string"
                  ConfirmMessage="@(n => PageStrings.FormatTopicList_DeleteConfirm(n))"
                  Execute="@(n => deletion.DeleteTopicAsync(n))"
                  Activity="@(n => PageStrings.FormatTopicList_Deleted(n))"
                  OnCompleted="@(n => { _list?.Remove(n); return Task.CompletedTask; })" />
}

@code {
    private ITopicService Topics => Connection.Current is IHasTopics { Topics: var topics } ? topics : throw new InvalidOperationException(PageStrings.List_NoTopics);

    private EntityList<TopicInfo>? _list;
    private AsyncCommand<string>? _deleteTopic;

    private readonly CountChanges<TopicInfo> _changes = new(t => t.Name,
        ("Subscriptions", t => t.SubscriptionCount), ("Scheduled", t => t.ScheduledMessageCount));

    private readonly TableSort<TopicInfo> _sort = new TableSort<TopicInfo>(ts => ts)
        .Add(PageStrings.List_ColumnTopic, t => t.Name, StringComparer.OrdinalIgnoreCase)
        .Add(Strings.Subscriptions, t => t.SubscriptionCount)
        .Add(PageStrings.List_ColumnScheduled, t => t.ScheduledMessageCount);

    protected override void OnInitialized()
    {
        if (Connection.Current is not IHasTopics)
            Nav.NavigateTo("/");
    }

    private IEnumerable<KeyBinding> Commands => Connection.Current is IHasDeletion
        ? [ListKeys.Delete(() => { if (_list?.View.FocusedKey is { } name) _deleteTopic?.Invoke(name); })]
        : [];

    private void Open(TopicInfo t)
    {
        NavState.TopicName = t.Name;
        Nav.NavigateTo("/topic-detail");
    }
}
