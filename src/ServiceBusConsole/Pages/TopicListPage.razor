@page "/topics"
@implements IDisposable

@inject NavigationManager Nav
@inject NavigationState NavState
@inject ServiceBusConnection Connection
@inject RazorConsole.Core.Focus.FocusManager FocusManager
@inject ITerminalViewport Viewport
@inject LiveCountsOptions LiveCounts
@inject MetricsVisibility MetricsVisibility
@inject Microsoft.Extensions.Logging.ILogger<TopicListPage> Logger

<FullscreenPage OnKeyDown="HandleKeyDown">
    <Header>
        <SectionCrumb Section="@Section.Topics" Current="true" />
        @if (_all.Count > 0) { <Markup Content="@ConnectionHeader.Count(_filtered.Count, _all.Count)" Foreground="@Theme.Muted" /> }
    </Header>
    <Status>@if (_live is { } live) { <LiveStatus List="@live" /> }</Status>
    <Content>
        <SectionTabs Current="@Section.Topics" Count="@(_all.Count > 0 ? _all.Count : null)" />
        @if (_all.Count == 0 && _loadFailed)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="Failed to load. Press ^r to retry." Foreground="@Theme.Danger" />
            </Padder>
        }
        else if (_all.Count == 0)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                    <Markup Content="Loading topics..." Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
                </Columns>
            </Padder>
        }
        else
        {
            <SelectableList Items="@_filtered"
                        PageSize="@FullscreenLayout.PageSizeRoundedTable(Viewport.Height, ShowMetrics, tabs: true)"
                        Scrollbar="@Theme.Scrollbar()"
                        SelectedIndex="@_selectedIndex"
                        SelectedIndexChanged="@(i => { _selectedIndex = i; _focusedItem = _filtered.ElementAtOrDefault(i)?.Name; })"
                        OnActivate="OpenFocused">
                <SpectreTable BorderColor="@Theme.Border" Expand="true" Border="TableBorder.Rounded" ColumnSeparators="false">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH Align="Justify.Left"><Columns><SortHeader Label="Topic" Sort="_sort" OnSorted="@(() => UpdateFilterState(_filter.Text))" /><ColumnFilter Filter="@_filter" /></Columns></SpectreTH>
                            <SpectreTH Align="Justify.Right"><SortHeader Label="Subscriptions" Icon="@Icons.Subscription" Sort="_sort" OnSorted="@(() => UpdateFilterState(_filter.Text))" /></SpectreTH>
                            <SpectreTH Align="Justify.Right"><SortHeader Label="Scheduled" Icon="@Icons.Scheduled" Sort="_sort" OnSorted="@(() => UpdateFilterState(_filter.Text))" /></SpectreTH>
                            @if (_traffic is not null) { <SpectreTH Align="Justify.Left">Incoming · 24 h</SpectreTH> }
                            <SpectreTH></SpectreTH>
                        </SpectreTR>
                    </SpectreTHead>
                    <NavigableTBody @ref="_tbody" TakeKey="@EndsFilterEdit"
                                  FocusOrder="1"
                                  OnKeyDown="@HandleKeyDown">
                        @{ var i = 0; }
                        @foreach (var t in context.Items)
                        {
                            var idx = i++;
                            <SelectableRow @key="t.Name" RowIndex="@idx">
                                <SpectreTD>@t.Name</SpectreTD>
                                <SpectreTD Align="Justify.Right"><CountCell Value="@t.SubscriptionCount" Highlight="@List.Changes.Highlight(t, "Subscriptions")" /></SpectreTD>
                                <SpectreTD Align="Justify.Right"><CountCell Value="@t.ScheduledMessageCount" Color="@Theme.Scheduled" Highlight="@List.Changes.Highlight(t, "Scheduled")" /></SpectreTD>
                                @if (_traffic is { } traffic) { <SpectreTD><Sparkline Points="@traffic.Of(t.Name)" /></SpectreTD> }
                                <SpectreTD>@if (t.IsRefreshing) { <Spinner /> }</SpectreTD>
                            </SelectableRow>
                        }
                        <FillerRows Count="@(FullscreenLayout.PageSizeRoundedTable(Viewport.Height, ShowMetrics, tabs: true) - context.Items.Count)" />
                    </NavigableTBody>
                </SpectreTable>
            </SelectableList>
        }
    </Content>
    <Footer>
        @if (ShowMetrics && Connection.Current is IHasMetrics { Metrics: var metrics })
        {
            <MetricsPanel @ref="_metricsPanel" Metrics="@metrics" Label="@($"{Icons.Topic} topic {_focusedItem}")" Scope="@(_focusedItem is { } t ? new MetricsScope.Entity(t) : null)" OnKeyDown="@HandleKeyDown" />
        }
        <KeyHints Bindings="@Keys" FirstFocusOrder="3" OnKeyDown="@HandleKeyDown" />
    </Footer>
</FullscreenPage>

<ErrorModal Message="@_error" OnDismiss="@(() => _error = string.Empty)" />
<HelpDialog @ref="_help" OnClose="FocusTable" />
<JumpDialog @ref="_jump" OnCancel="FocusTable" />

@if (Connection.Current is IHasDeletion { Deletion: var deletion })
{
    <AsyncCommand @ref="_deleteTopic" TItem="string"
                  ConfirmMessage="@(n => $"Delete topic '{n}' and all its subscriptions? This cannot be undone.")"
                  Execute="@(n => deletion.DeleteTopicAsync(n))"
                  Activity="@(n => $"Deleted topic '{n}' and its subscriptions")"
                  OnCompleted="@(n => { _all.RemoveAll(t => t.Name == n); UpdateFilterState(_filter.Text); _selectedIndex = Math.Min(_selectedIndex, Math.Max(0, _filtered.Count - 1)); _focusedItem = _filtered.ElementAtOrDefault(_selectedIndex)?.Name; StateHasChanged(); return Task.CompletedTask; })" />
}

@code {
    private ITopicService Topics => Connection.Current is IHasTopics { Topics: var topics } ? topics : throw new InvalidOperationException("This namespace has no topics.");

    private LiveList<TopicInfo>? _live;
    private LiveList<TopicInfo> List => _live ?? throw new InvalidOperationException("Topic list not initialized");
    private List<TopicInfo> _all => List.All;
    private List<TopicInfo> _filtered = [];
    private readonly ListFilter _filter = new();
    private HelpDialog? _help;
    private JumpDialog? _jump;
    private int _selectedIndex;
    private string? _focusedItem;
    private string _error = string.Empty;
    private AsyncCommand<string>? _deleteTopic;
    private bool _loadFailed;
    private NavigableTBody? _tbody;
    private bool _tableAutoFocused;
    private readonly TableSort<TopicInfo> _sort = new TableSort<TopicInfo>(ts => ts)
        .Add("Topic", t => t.Name, StringComparer.OrdinalIgnoreCase)
        .Add("Subscriptions", t => t.SubscriptionCount)
        .Add("Scheduled", t => t.ScheduledMessageCount);

    private MetricsPanel? _metricsPanel;
    private bool ShowMetrics => Connection.Current is IHasMetrics && MetricsVisibility.IsVisible(Viewport.Height);

    public void Dispose()
    {
        _live?.Dispose();
        _traffic?.Dispose();
    }

    private IncomingTraffic? _traffic;

    /// <summary>The sparkline column: with Azure Monitor metrics and room for it.</summary>
    private void StartTraffic()
    {
        if (Connection.Current is not IHasMetrics { Metrics: var metrics } || Viewport.Width < MinTrafficWidth) return;
        _traffic = new IncomingTraffic(metrics, LiveCounts, Logger) { Changed = () => InvokeAsync(StateHasChanged) };
        _ = _traffic.RunAsync();
    }

    private const int MinTrafficWidth = 110;


    protected override void OnInitialized()
    {
        StartTraffic();
        _live = new LiveList<TopicInfo>(ct => Topics.GetTopicsAsync(ct), t => t.Name, x => x.IsRefreshing,
            new(t => t.Name, ("Subscriptions", x => x.SubscriptionCount), ("Scheduled", x => x.ScheduledMessageCount)),
            LiveCounts, Logger)
        {
            Changed = () => { UpdateFilterState(_filter.Text); return InvokeAsync(StateHasChanged); },
            Render = StateHasChanged,
            LoadFailed = ex => { _loadFailed = true; _error = ErrorText.Of(ex); return InvokeAsync(StateHasChanged); },
        };
        if (Connection.Current is not IHasTopics)
            Nav.NavigateTo("/");
        _focusedItem = NavState.TopicName;
    }

    protected override async Task OnInitializedAsync() => await LoadTopics();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_tableAutoFocused && _tbody is not null && _filtered.Count > 0)
        {
            _tableAutoFocused = true;
            await FocusManager.FocusAsync(_tbody.FocusKey);
        }
    }

    private Task LoadTopics()
    {
        _error = string.Empty;
        _loadFailed = false;
        _metricsPanel?.Reload();
        return List.LoadAsync();
    }

    private void UpdateFilterState(string? value)
    {
        var currentFocus = _focusedItem;
        _filtered = _sort.Apply(string.IsNullOrWhiteSpace(value) ? _all
            : _all.Where(t => t.Name.Contains(value, StringComparison.OrdinalIgnoreCase)));
        if (currentFocus is not null)
        {
            var idx = _filtered.FindIndex(t => t.Name == currentFocus);
            if (idx >= 0) _selectedIndex = idx;
        }
        _focusedItem = _filtered.ElementAtOrDefault(_selectedIndex)?.Name;
    }

    private void ApplyFilter(string? value)
    {
        _selectedIndex = 0;
        _focusedItem = null;
        UpdateFilterState(value);
        StateHasChanged();
    }

    private void OnFocused(AsyncCommand<string>? command)
    {
        if (_focusedItem is { } item) command?.Invoke(item);
    }

    private void ToggleMetrics()
    {
        if (Connection.Current is not IHasMetrics) return;
        _ = MetricsVisibility.ToggleAsync(Viewport.Height);
        StateHasChanged();
    }

    private IReadOnlyList<KeyBinding> Keys =>
    [
        new("Enter", $"{Icons.Subscription} Subscriptions", OpenFocused) { InFooter = false },
        new("/", $"{Icons.Filter} Filter", () => { _filter.Edit(); StateHasChanged(); }) { InFooter = false },
        new("r", $"{Icons.Refresh} Refresh", () => _ = LoadTopics()) { Ctrl = true, Aliases = ["F5"] },
        .. Connection.Current is IHasDeletion
            ? [new KeyBinding("D", $"{Icons.Delete} Delete", () => OnFocused(_deleteTopic)) { Danger = true, Aliases = ["F9", "Delete", "\\"] }]
            : Array.Empty<KeyBinding>(),
        .. Connection.Current is IHasMetrics
            ? [new KeyBinding("m", $"{Icons.Metrics} Metrics", ToggleMetrics) { Aliases = ["F12"] }]
            : Array.Empty<KeyBinding>(),
        .. SectionTabs.Bindings(Connection.Current, Section.Topics, Nav),
        new(":", $"{Icons.Filter} Jump", () => _ = _jump?.OpenAsync()),
        new("?", $"{Icons.Confirm} Help", () => _help?.Open(Keys)),
        new("Escape", $"{Icons.Back} Back", () => Nav.NavigateTo("/")),
    ];

    private void OpenFocused()
    {
        if (_filtered.ElementAtOrDefault(_selectedIndex) is not { } t) return;
        NavState.TopicName = t.Name;
        Nav.NavigateTo("/topic-detail");
    }

    private bool EndsFilterEdit(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || !_filter.Editing) return false;
        _filter.Handle(e);
        StateHasChanged();
        return true;
    }

    private Task FocusTable() => _tbody is { } table ? FocusManager.FocusAsync(table.FocusKey) : Task.CompletedTask;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (_deleteTopic?.HandleKey(e) == true) return;
        switch (_filter.Handle(e))
        {
            case FilterKey.Changed: ApplyFilter(_filter.Text); return;
            case FilterKey.Handled: StateHasChanged(); return;
        }
        if (MetricsRange.StepOf(e) is { } step && _metricsPanel?.StepRange(step) == true) return;
        KeyBinding.Dispatch(Keys, e);
    }
}
