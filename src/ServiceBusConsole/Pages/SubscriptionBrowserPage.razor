@page "/subscription-browser"

@inject NavigationManager Nav
@inject ServiceBusConnection Connection
@inject NavigationState NavState

<MessageBrowserView Entity="@(new MessageSource.Subscription(TopicName, SubscriptionName, IsDlq: _dlq))" BackPath="@BackPath">
    <Breadcrumb>
        <SectionCrumb Section="@(NavState.ReturnPath == "/subscriptions" ? Section.AllSubscriptions : Section.Topics)" />
        <Markup Content=" › " Foreground="@Theme.Muted" />
        <Markup Content="@TopicName" Foreground="@Theme.Muted" />
        <Markup Content=" › " Foreground="@Theme.Muted" />
        <Markup Content="@($"{Icons.Subscription} {SubscriptionName}")" Foreground="@Theme.Accent" Decoration="@Decoration.Bold" />
    </Breadcrumb>
</MessageBrowserView>

@code {
    private string TopicName => NavState.TopicName ?? "";
    private string SubscriptionName => NavState.SubscriptionName ?? "";

    private string BackPath => NavState.ReturnPath ?? (string.IsNullOrEmpty(TopicName) ? "/topics" : "/topic-detail");

    private bool _dlq = true;

    protected override void OnInitialized()
    {
        _dlq = !NavState.StartActive;
        NavState.StartActive = false;
        if (Connection.CurrentNamespace is null)
            Nav.NavigateTo("/");
    }
}
