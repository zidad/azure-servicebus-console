@page "/queues/{QueueName}"

@inject NavigationManager Nav
@inject ServiceBusConnection Connection
@inject NavigationState NavState

<MessageBrowserView Entity="@(new MessageSource.Queue(QueueName, IsDlq: _dlq))" BackPath="/queues">
    <Breadcrumb>
        <SectionCrumb Section="@Section.Queues" />
        <Markup Content=" › " Foreground="@Theme.Muted" />
        <Markup Content="@QueueName" Foreground="@Theme.Accent" Decoration="@Decoration.Bold" />
    </Breadcrumb>
</MessageBrowserView>

@code {
    [Parameter] public string QueueName { get; set; } = "";

    private bool _dlq = true;

    protected override void OnInitialized()
    {
        _dlq = !NavState.StartActive;
        NavState.StartActive = false;
        if (Connection.CurrentNamespace is null)
            Nav.NavigateTo("/");
    }
}
