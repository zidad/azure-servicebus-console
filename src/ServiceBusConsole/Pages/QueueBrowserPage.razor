@page "/queues/{QueueName}"

@inject NavigationManager Nav
@inject ServiceBusConnection Connection

<MessageBrowserView Entity="@(new MessageSource.Queue(QueueName, IsDlq: true))" BackPath="/queues">
    <Breadcrumb>
        <SectionCrumb Section="@Section.Queues" />
        <Markup Content=" › " Foreground="@Theme.Muted" />
        <Markup Content="@QueueName" Foreground="@Theme.Accent" Decoration="@Decoration.Bold" />
    </Breadcrumb>
</MessageBrowserView>

@code {
    [Parameter] public string QueueName { get; set; } = "";

    protected override void OnInitialized()
    {
        if (Connection.CurrentNamespace is null)
            Nav.NavigateTo("/");
    }
}
