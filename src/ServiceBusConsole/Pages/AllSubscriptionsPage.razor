@page "/subscriptions"

@inject NavigationManager Nav
@inject NavigationState NavState
@inject ServiceBusConnection Connection

<EntityList @ref="_list" TItem="SubscriptionInfo"
            Section="@Section.AllSubscriptions"
            LoadingText="@PageStrings.List_LoadingSubscriptions"
            Load="@(ct => Topics.GetAllSubscriptionsAsync(ct))"
            Key="@Key"
            IsRefreshing="@(s => s.IsRefreshing)"
            Stale="@(s => s with { IsRefreshing = false })"
            Changes="@_changes"
            Sort="@_sort"
            Matches="@((s, text) => s.TopicName.Contains(text, StringComparison.OrdinalIgnoreCase) || s.Name.Contains(text, StringComparison.OrdinalIgnoreCase))"
            Focus="@(NavState is { TopicName: { } topic, SubscriptionName: { } name } ? $"{topic}/{name}" : null)"
            TrafficEntity="@(s => s.TopicName)"
            MetricsEntity="@(view => view.Focused?.TopicName)"
            MetricsLabel="@(t => $"{Icons.Topic} {PageStrings.FormatList_MetricsTopic(t)}")"
            OpenLabel="@($"{Icons.Message} {PageStrings.Key_Messages}")"
            OnOpen="@Open"
            Commands="@Commands"
            CommandKey="@(e => _deleteSub?.HandleKey(e) == true || _purgeDlq?.HandleKey(e) == true)">
    <Crumb><SectionCrumb Section="@Section.AllSubscriptions" Current="true" /></Crumb>
    <Headers Context="list">
        <SpectreTH Width="@Gutter.Width" Padding="@Gutter.Header"></SpectreTH>
        <SpectreTH Align="Justify.Left" Padding="@Gutter.NextHeader"><Columns><SortHeader Label="@PageStrings.List_ColumnTopic" Sort="_sort" OnSorted="@list.Sorted" /><ColumnFilter Filter="@list.Filter" /></Columns></SpectreTH>
        <SpectreTH Align="Justify.Left"><SortHeader Label="@PageStrings.List_ColumnSubscription" Sort="_sort" OnSorted="@list.Sorted" /></SpectreTH>
        <SpectreTH Align="Justify.Right"><SortHeader Label="@Strings.Active" Sort="_sort" OnSorted="@list.Sorted" /></SpectreTH>
        <SpectreTH Align="Justify.Right"><SortHeader Label="@Strings.Dlq" Icon="@Icons.DeadLetter" Sort="_sort" OnSorted="@list.Sorted" /></SpectreTH>
        <SpectreTH Align="Justify.Right"><SortHeader Label="@PageStrings.List_ColumnTransfer" Icon="@Icons.Transfer" Sort="_sort" OnSorted="@list.Sorted" /></SpectreTH>
    </Headers>
    <Row Context="s">
        <SpectreTD data-padding="@Gutter.Cell"><DeadLetterMark Count="@s.DeadLetterMessageCount" /></SpectreTD>
        <SpectreTD data-padding="@Gutter.NextCell">@s.TopicName</SpectreTD>
        <SpectreTD>@s.Name</SpectreTD>
        <SpectreTD Align="Justify.Right"><CountCell Value="@s.ActiveMessageCount" Highlight="@_changes.Highlight(s, "Active")" /></SpectreTD>
        <SpectreTD Align="Justify.Right"><CountCell Value="@s.DeadLetterMessageCount" Color="@Theme.Danger" Bold="true" Highlight="@_changes.Highlight(s, "DLQ")" /></SpectreTD>
        <SpectreTD Align="Justify.Right"><CountCell Value="@s.TransferMessageCount" Color="@Theme.Transfer" Highlight="@_changes.Highlight(s, "Transfer")" /></SpectreTD>
    </Row>
</EntityList>

@if (Connection.Current is IHasDeletion { Deletion: var deletion })
{
    <AsyncCommand @ref="_deleteSub" TItem="SubscriptionInfo"
                  ConfirmMessage="@(s => PageStrings.FormatList_DeleteSubscriptionConfirm(s.Name, s.TopicName))"
                  Execute="@(s => deletion.DeleteSubscriptionAsync(s.TopicName, s.Name))"
                  Activity="@(s => PageStrings.FormatList_DeletedSubscription(s.Name, s.TopicName))"
                  OnCompleted="@(s => { _list?.Remove(Key(s)); return Task.CompletedTask; })" />
}

<AsyncCommand @ref="_purgeDlq" TItem="SubscriptionInfo"
              ConfirmMessage="@(s => PageStrings.FormatList_PurgeDlqConfirm(Key(s)))"
              ConfirmByTyping="true"
              Execute="@(s => Connection.Namespace.Messages.PurgeAsync(new MessageSource.Subscription(s.TopicName, s.Name, IsDlq: true)).LastOrDefaultAsync().AsTask())"
              Activity="@(s => PageStrings.FormatList_PurgedDlq(Key(s)))"
              OnCompleted="@(s => { _list?.Update(Key(s), x => x with { DeadLetterMessageCount = 0 }); return Task.CompletedTask; })" />

@code {
    private ITopicService Topics => Connection.Current is IHasTopics { Topics: var topics } ? topics : throw new InvalidOperationException(PageStrings.List_NoTopics);

    private EntityList<SubscriptionInfo>? _list;
    private AsyncCommand<SubscriptionInfo>? _deleteSub;
    private AsyncCommand<SubscriptionInfo>? _purgeDlq;

    private readonly CountChanges<SubscriptionInfo> _changes = new(Key,
        ("Active", s => s.ActiveMessageCount), ("DLQ", s => s.DeadLetterMessageCount), ("Transfer", s => s.TransferMessageCount));

    private readonly TableSort<SubscriptionInfo> _sort = new TableSort<SubscriptionInfo>(ss => ss.OrderBy(s => s.TopicName).ThenBy(s => s.Name))
        .Add(PageStrings.List_ColumnTopic, s => s.TopicName, StringComparer.OrdinalIgnoreCase)
        .Add(PageStrings.List_ColumnSubscription, s => s.Name, StringComparer.OrdinalIgnoreCase)
        .Add(Strings.Active, s => s.ActiveMessageCount)
        .Add(Strings.Dlq, s => s.DeadLetterMessageCount)
        .Add(PageStrings.List_ColumnTransfer, s => s.TransferMessageCount)
        .SortBy(Strings.Dlq, SortDirection.Descending);

    private static string Key(SubscriptionInfo s) => $"{s.TopicName}/{s.Name}";

    protected override void OnInitialized()
    {
        if (Connection.Current is not IHasTopics)
            Nav.NavigateTo("/");
    }

    private IEnumerable<KeyBinding> Commands =>
    [
        .. Connection.Current is IHasDeletion ? [ListKeys.Delete(() => OnFocused(_deleteSub))] : Array.Empty<KeyBinding>(),
        ListKeys.PurgeDlq(() => OnFocused(_purgeDlq)),
    ];

    private void OnFocused(AsyncCommand<SubscriptionInfo>? command)
    {
        if (_list?.View.Focused is { } item) command?.Invoke(item);
    }

    private void Open(SubscriptionInfo s)
    {
        NavState.TopicName = s.TopicName;
        NavState.SubscriptionName = s.Name;
        NavState.ReturnPath = "/subscriptions";
        Nav.NavigateTo("/subscription-browser");
    }
}
