@page "/queues"
@implements IDisposable

@inject NavigationManager Nav
@inject NavigationState NavState
@inject ServiceBusConnection Connection
@inject IQueueService QueueService
@inject IMessageService MessageService
@inject RazorConsole.Core.Focus.FocusManager FocusManager
@inject Microsoft.Extensions.Logging.ILogger<QueueListPage> Logger
@inject ITerminalViewport Viewport
@inject LiveCountsOptions LiveCounts

<FullscreenPage OnKeyDown="HandleKeyDown">
    <Header>
        <SectionCrumb Section="@Section.Queues" Current="true" />
        @if (_all.Count > 0) { <Markup Content="@ConnectionHeader.Count(_filtered.Count, _all.Count)" Foreground="@Theme.Muted" /> }
    </Header>
    <Content>
        @if (_all.Count == 0 && _loadFailed)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Markup Content="Failed to load. Press [F5] to retry." Foreground="@Theme.Danger" />
            </Padder>
        }
        else if (_all.Count == 0)
        {
            <Padder Padding="@(new(0, 1, 0, 0))">
                <Columns>
                    <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                    <Markup Content="Loading queues..." Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
                </Columns>
            </Padder>
        }
        else
        {
            <SelectableList Items="@_filtered"
                        PageSize="@FullscreenLayout.PageSizeRoundedTable(Viewport.Height)"
                        Scrollbar="new()"
                        SelectedIndex="@_selectedIndex"
                        SelectedIndexChanged="@(i => { _selectedIndex = i; _focusedItem = _filtered.ElementAtOrDefault(i)?.Name; })"
                        OnActivate="@(() => { if (_filtered.ElementAtOrDefault(_selectedIndex) is {} q) { NavState.FocusedQueueName = q.Name; Nav.NavigateTo($"/queues/{Uri.EscapeDataString(q.Name)}"); } })">
                <SpectreTable Expand="true" Border="TableBorder.Rounded">
                    <SpectreTHead>
                        <SpectreTR>
                            <SpectreTH Align="Justify.Left"><Columns><SortHeader Label="Queue" Sort="_sort" OnSorted="@(() => UpdateFilterState(_filter))" /><ColumnFilter Filter="@_filter" /></Columns></SpectreTH>
                            <SpectreTH Align="Justify.Right"><SortHeader Label="Active" Sort="_sort" OnSorted="@(() => UpdateFilterState(_filter))" /></SpectreTH>
                            <SpectreTH Align="Justify.Right"><SortHeader Label="DLQ" Icon="@Icons.DeadLetter" Sort="_sort" OnSorted="@(() => UpdateFilterState(_filter))" /></SpectreTH>
                            <SpectreTH Align="Justify.Right"><SortHeader Label="Scheduled" Icon="@Icons.Scheduled" Sort="_sort" OnSorted="@(() => UpdateFilterState(_filter))" /></SpectreTH>
                            <SpectreTH Align="Justify.Right"><SortHeader Label="Transfer" Icon="@Icons.Transfer" Sort="_sort" OnSorted="@(() => UpdateFilterState(_filter))" /></SpectreTH>
                            <SpectreTH></SpectreTH>
                        </SpectreTR>
                    </SpectreTHead>
                    <NavigableTBody @ref="_tbody"
                                  FocusOrder="1"
                                  OnKeyDown="@HandleKeyDown">
                        @{ var i = 0; }
                        @foreach (var q in context.Items)
                        {
                            var idx = i++;
                            <SelectableRow @key="q.Name" RowIndex="@idx">
                                <SpectreTD>@q.Name</SpectreTD>
                                <SpectreTD Align="Justify.Right"><CountCell Value="@q.ActiveMessageCount" Highlight="@_changes.Highlight(q, "Active")" /></SpectreTD>
                                <SpectreTD Align="Justify.Right"><CountCell Value="@q.DeadLetterMessageCount" Color="@Theme.Danger" Bold="true" Highlight="@_changes.Highlight(q, "DLQ")" /></SpectreTD>
                                <SpectreTD Align="Justify.Right"><CountCell Value="@q.ScheduledMessageCount" Color="@Theme.Scheduled" Highlight="@_changes.Highlight(q, "Scheduled")" /></SpectreTD>
                                <SpectreTD Align="Justify.Right"><CountCell Value="@q.TransferMessageCount" Color="@Theme.Transfer" Highlight="@_changes.Highlight(q, "Transfer")" /></SpectreTD>
                                <SpectreTD>@if (q.IsRefreshing) { <Spinner /> }</SpectreTD>
                            </SelectableRow>
                        }
                    </NavigableTBody>
                </SpectreTable>
            </SelectableList>
        }
    </Content>
    <Footer>
        <Padder Padding="@(new(1, 0, 0, 0))">
            <Columns>
                <KeyButton Content="[F5] 🔄 Refresh" OnClick="LoadQueues" FocusedColor="@Theme.Success" FocusOrder="3" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <KeyButton Content="[F9] ❌ Delete" OnClick="@(() => OnFocused(_deleteQueue))" FocusedColor="@Theme.Danger" FocusOrder="4" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <KeyButton Content="[F11] 🧹 Purge DLQ" OnClick="@(() => OnFocused(_purgeDlq))" FocusedColor="@Theme.Danger" FocusOrder="5" OnKeyDown="@HandleKeyDown" />
                <Markup Content="   " />
                <KeyButton Content="[Esc] 🔙 Back" OnClick="@(() => Nav.NavigateTo("/"))" FocusedColor="@Theme.Accent" FocusOrder="6" OnKeyDown="@HandleKeyDown" />
            </Columns>
        </Padder>
    </Footer>
</FullscreenPage>

<ErrorModal Message="@_error" OnDismiss="@(() => _error = string.Empty)" />

<AsyncCommand @ref="_deleteQueue" TItem="string"
              ConfirmMessage="@(n => $"Delete queue '{n}'? This cannot be undone.")"
              Execute="@(n => QueueService.DeleteQueueAsync(n))"
              OnCompleted="@(n => { _all.RemoveAll(q => q.Name == n); UpdateFilterState(_filter); _selectedIndex = Math.Min(_selectedIndex, Math.Max(0, _filtered.Count - 1)); _focusedItem = _filtered.ElementAtOrDefault(_selectedIndex)?.Name; StateHasChanged(); return Task.CompletedTask; })" />

<AsyncCommand @ref="_purgeDlq" TItem="string"
              ConfirmMessage="@(n => $"Purge ALL messages from DLQ of '{n}'? This cannot be undone.")"
              Execute="@(n => MessageService.PurgeMessagesAsync(new MessageSource(n, IsDlq: true), _ => { }))"
              OnCompleted="@(n => { List.Update(n, q => q with { DeadLetterMessageCount = 0 }); UpdateFilterState(_filter); StateHasChanged(); return Task.CompletedTask; })" />

@code {
    private LiveList<QueueInfo>? _live;
    private LiveList<QueueInfo> List => _live ?? throw new InvalidOperationException("Queue list not initialized");
    private List<QueueInfo> _all => List.All;
    private CountChanges<QueueInfo> _changes => List.Changes;
    private List<QueueInfo> _filtered = [];
    private string? _filter;
    private int _selectedIndex;
    private string? _focusedItem;
    private string _error = string.Empty;
    private AsyncCommand<string>? _deleteQueue;
    private AsyncCommand<string>? _purgeDlq;
    private bool _loadFailed;
    private NavigableTBody? _tbody;
    private bool _tableAutoFocused;
    private readonly TableSort<QueueInfo> _sort = new TableSort<QueueInfo>(qs => qs.OrderBy(q => q.Name))
        .Add("Queue", q => q.Name, StringComparer.OrdinalIgnoreCase)
        .Add("Active", q => q.ActiveMessageCount)
        .Add("DLQ", q => q.DeadLetterMessageCount)
        .Add("Scheduled", q => q.ScheduledMessageCount)
        .Add("Transfer", q => q.TransferMessageCount)
        .SortBy("DLQ", SortDirection.Descending);

    public void Dispose() => _live?.Dispose();


    protected override void OnInitialized()
    {
        _live = new LiveList<QueueInfo>(QueueService.GetQueuesAsync, q => q.Name, q => q.IsRefreshing,
            new(q => q.Name,
                ("Active", q => q.ActiveMessageCount), ("DLQ", q => q.DeadLetterMessageCount),
                ("Scheduled", q => q.ScheduledMessageCount), ("Transfer", q => q.TransferMessageCount)),
            LiveCounts, Logger)
        {
            Changed = () => { UpdateFilterState(_filter); return InvokeAsync(StateHasChanged); },
            Render = StateHasChanged,
            LoadFailed = ex => { _loadFailed = true; _error = ex.Message; return InvokeAsync(StateHasChanged); },
        };
        if (Connection.CurrentNamespace is null)
            Nav.NavigateTo("/");
        _focusedItem = NavState.FocusedQueueName;
    }

    protected override async Task OnInitializedAsync() => await LoadQueues();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_tableAutoFocused && _tbody is not null && _filtered.Count > 0)
        {
            _tableAutoFocused = true;
            await FocusManager.FocusAsync(_tbody.FocusKey);
        }
    }

    private Task LoadQueues()
    {
        _error = string.Empty;
        _loadFailed = false;
        return List.LoadAsync();
    }

    private void UpdateFilterState(string? value)
    {
        var currentFocus = _focusedItem;
        _filter = value;
        _filtered = _sort.Apply(string.IsNullOrWhiteSpace(value) ? _all
            : _all.Where(q => q.Name.Contains(value, StringComparison.OrdinalIgnoreCase)));
        if (currentFocus is not null)
        {
            var idx = _filtered.FindIndex(q => q.Name == currentFocus);
            if (idx >= 0) _selectedIndex = idx;
        }
        _focusedItem = _filtered.ElementAtOrDefault(_selectedIndex)?.Name;
    }

    private void ApplyFilter(string? value)
    {
        _selectedIndex = 0;
        _focusedItem = null;
        UpdateFilterState(value);
        StateHasChanged();
    }

    private void OnFocused(AsyncCommand<string>? command)
    {
        if (_focusedItem is { } item) command?.Invoke(item);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (_deleteQueue?.HandleKey(e) == true) return;
        if (_purgeDlq?.HandleKey(e) == true) return;
        switch (e.Key)
        {
            case "Escape": Nav.NavigateTo("/"); return;
            case "F5": _ = LoadQueues(); return;
            case "F9": case "Delete": case "\\":
                OnFocused(_deleteQueue);
                return;
            case "F11":
                OnFocused(_purgeDlq);
                return;
            default:
                if (FilterEdit.From(_filter, e) is { } edit) ApplyFilter(edit.Filter);
                return;
        }
    }
}
