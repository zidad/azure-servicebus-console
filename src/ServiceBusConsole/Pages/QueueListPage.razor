@page "/queues"

@inject NavigationManager Nav
@inject NavigationState NavState
@inject ServiceBusConnection Connection

<EntityList @ref="_list" TItem="QueueInfo"
            Section="@Section.Queues"
            LoadingText="@PageStrings.QueueList_Loading"
            Load="@(ct => Connection.Namespace.Queues.GetQueuesAsync(ct))"
            Key="@(q => q.Name)"
            IsRefreshing="@(q => q.IsRefreshing)"
            Stale="@(q => q with { IsRefreshing = false })"
            Changes="@_changes"
            Sort="@_sort"
            Matches="@((q, text) => q.Name.Contains(text, StringComparison.OrdinalIgnoreCase))"
            Focus="@NavState.FocusedQueueName"
            TrafficEntity="@(q => q.Name)"
            MetricsEntity="@(view => view.FocusedKey)"
            MetricsLabel="@(q => $"{Icons.Queue} {PageStrings.FormatQueueList_MetricsLabel(q)}")"
            OpenLabel="@($"{Icons.Message} {PageStrings.Key_Messages}")"
            OnOpen="@Open"
            Commands="@Commands"
            CommandKey="@(e => _deleteQueue?.HandleKey(e) == true || _purgeDlq?.HandleKey(e) == true)">
    <Crumb><SectionCrumb Section="@Section.Queues" Current="true" /></Crumb>
    <Headers Context="list">
        <SpectreTH Width="@Gutter.Width" Padding="@Gutter.Header"></SpectreTH>
        <SpectreTH Align="Justify.Left" Padding="@Gutter.NextHeader"><Columns><SortHeader Label="@PageStrings.List_ColumnQueue" Sort="_sort" OnSorted="@list.Sorted" /><ColumnFilter Filter="@list.Filter" /></Columns></SpectreTH>
        <SpectreTH Align="Justify.Right"><SortHeader Label="@Strings.Active" Sort="_sort" OnSorted="@list.Sorted" /></SpectreTH>
        <SpectreTH Align="Justify.Right"><SortHeader Label="@Strings.Dlq" Icon="@Icons.DeadLetter" Sort="_sort" OnSorted="@list.Sorted" /></SpectreTH>
        <SpectreTH Align="Justify.Right"><SortHeader Label="@PageStrings.List_ColumnScheduled" Icon="@Icons.Scheduled" Sort="_sort" OnSorted="@list.Sorted" /></SpectreTH>
        <SpectreTH Align="Justify.Right"><SortHeader Label="@PageStrings.List_ColumnTransfer" Icon="@Icons.Transfer" Sort="_sort" OnSorted="@list.Sorted" /></SpectreTH>
    </Headers>
    <Row Context="q">
        <SpectreTD data-padding="@Gutter.Cell"><DeadLetterMark Count="@q.DeadLetterMessageCount" /></SpectreTD>
        <SpectreTD data-padding="@Gutter.NextCell">@q.Name</SpectreTD>
        <SpectreTD Align="Justify.Right"><CountCell Value="@q.ActiveMessageCount" Highlight="@_changes.Highlight(q, "Active")" /></SpectreTD>
        <SpectreTD Align="Justify.Right"><CountCell Value="@q.DeadLetterMessageCount" Color="@Theme.Danger" Bold="true" Highlight="@_changes.Highlight(q, "DLQ")" /></SpectreTD>
        <SpectreTD Align="Justify.Right"><CountCell Value="@q.ScheduledMessageCount" Color="@Theme.Scheduled" Highlight="@_changes.Highlight(q, "Scheduled")" /></SpectreTD>
        <SpectreTD Align="Justify.Right"><CountCell Value="@q.TransferMessageCount" Color="@Theme.Transfer" Highlight="@_changes.Highlight(q, "Transfer")" /></SpectreTD>
    </Row>
</EntityList>

@if (Connection.Current is IHasDeletion { Deletion: var deletion })
{
    <AsyncCommand @ref="_deleteQueue" TItem="string"
                  ConfirmMessage="@(n => PageStrings.FormatQueueList_DeleteConfirm(n))"
                  Execute="@(n => deletion.DeleteQueueAsync(n))"
                  Activity="@(n => PageStrings.FormatQueueList_Deleted(n))"
                  OnCompleted="@(n => { _list?.Remove(n); return Task.CompletedTask; })" />
}

<AsyncCommand @ref="_purgeDlq" TItem="string"
              ConfirmMessage="@(n => PageStrings.FormatList_PurgeDlqConfirm(n))"
              ConfirmByTyping="true"
              Execute="@(n => Connection.Namespace.Messages.PurgeAsync(new MessageSource.Queue(n, IsDlq: true)).LastOrDefaultAsync().AsTask())"
              Activity="@(n => PageStrings.FormatList_PurgedDlq(n))"
              OnCompleted="@(n => { _list?.Update(n, q => q with { DeadLetterMessageCount = 0 }); return Task.CompletedTask; })" />

@code {
    private EntityList<QueueInfo>? _list;
    private AsyncCommand<string>? _deleteQueue;
    private AsyncCommand<string>? _purgeDlq;

    private readonly CountChanges<QueueInfo> _changes = new(q => q.Name,
        ("Active", q => q.ActiveMessageCount), ("DLQ", q => q.DeadLetterMessageCount),
        ("Scheduled", q => q.ScheduledMessageCount), ("Transfer", q => q.TransferMessageCount));

    private readonly TableSort<QueueInfo> _sort = new TableSort<QueueInfo>(qs => qs.OrderBy(q => q.Name))
        .Add(PageStrings.List_ColumnQueue, q => q.Name, StringComparer.OrdinalIgnoreCase)
        .Add(Strings.Active, q => q.ActiveMessageCount)
        .Add(Strings.Dlq, q => q.DeadLetterMessageCount)
        .Add(PageStrings.List_ColumnScheduled, q => q.ScheduledMessageCount)
        .Add(PageStrings.List_ColumnTransfer, q => q.TransferMessageCount)
        .SortBy(Strings.Dlq, SortDirection.Descending);

    protected override void OnInitialized()
    {
        if (Connection.CurrentNamespace is null)
            Nav.NavigateTo("/");
    }

    private IEnumerable<KeyBinding> Commands =>
    [
        .. Connection.Current is IHasDeletion ? [ListKeys.Delete(() => OnFocused(_deleteQueue))] : Array.Empty<KeyBinding>(),
        ListKeys.PurgeDlq(() => OnFocused(_purgeDlq)),
    ];

    private void OnFocused(AsyncCommand<string>? command)
    {
        if (_list?.View.FocusedKey is { } name) command?.Invoke(name);
    }

    private void Open(QueueInfo q)
    {
        NavState.FocusedQueueName = q.Name;
        Nav.NavigateTo($"/queues/{Uri.EscapeDataString(q.Name)}");
    }
}
