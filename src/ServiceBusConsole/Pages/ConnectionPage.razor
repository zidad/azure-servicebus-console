@page "/"
@implements IDisposable

@inject NavigationManager Nav
@inject NavigationState NavState
@inject INamespaceService NamespaceService
@inject SubscriptionCatalog Catalog
@inject ServiceBusConnection Connection
@inject FileCache FileCache
@inject ITerminalViewport Viewport
@inject MetricsVisibility MetricsVisibility
@inject ExplorerTree Tree
@inject MessageBrowserStore Store

@* With the metrics panel, a column of the terminal's height keeps it at the bottom, wherever the lists end. *@
<Flex Direction="FlexDirection.Column" Height="@(ShowMetrics ? Viewport.Height - 1 : null)" Justify="FlexJustify.SpaceBetween" FillWidth="true">
    <Rows FillWidth="true">
        <Columns>
            <Markup Content="azsb" Foreground="@Theme.Accent" Decoration="@Decoration.Bold" />
            <Markup Content=" │ " Foreground="@Theme.Border" />
            <Markup Content="@($"{Icons.Connection} {PageStrings.Connection_Title}")" Decoration="@Decoration.Bold" />
        </Columns>
        <Markup Content="@(new string('─', Math.Max(1, Viewport.Width)))" Foreground="@Theme.Border" />

            <Rows>
                <ConnectionTree @ref="_tree"
                                MaxRows="@TreeRows"
                                FocusOrder="1"
                                SelectKey="@_selectKey"
                                DefaultSubscriptionId="@_azDefaultId"
                                SelectedChanged="@Follow"
                                TakeKey="@StepRange"
                                OnKeyDown="@HandleKeyDown" />

                @if (_startupError is { } startupError)
                {
                    <Markup Content="@startupError" Foreground="@Theme.Danger" />
                }

                @if (Catalog.Error is { } listError)
                {
                    <Markup Content="@(PageStrings.FormatConnection_ListSubscriptionsFailed(listError))" Foreground="@Theme.Danger" />
                }
                else if (Catalog.Loading)
                {
                    <Columns>
                        <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                        <Markup Content="@PageStrings.Connection_ListingSubscriptions" Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
                    </Columns>
                }

                <Padder Padding="@(new(0, 1, 0, 0))">
                    <KeyHints Bindings="@Keys" FirstFocusOrder="4" OnKeyDown="@HandleKeyDown" />
                </Padder>
            </Rows>

        <Padder Padding="@(new(0, 1, 0, 0))">
            <Columns>
                <Markup Content="@(PageStrings.FormatConnection_CacheDirectory(FileCache.CacheDirectory))" Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
                <Markup Content="   " />
                @if (_cacheStatus is null)
                {
                    <KeyButton Content="@($"{Icons.Purge} {PageStrings.Connection_ClearCache}")" OnClick="ClearCache" FocusedColor="@Theme.Danger" FocusOrder="8" OnKeyDown="@HandleKeyDown" />
                }
                else
                {
                    <Markup Content="@_cacheStatus" Foreground="@(_cacheClearFailed ? Theme.Danger : Theme.Success)" />
                }
            </Columns>
        </Padder>
    </Rows>

    @if (ShowMetrics)
    {
        <MetricsPanel @ref="_metricsPanel"
                      Label="@($"{Icons.Namespace} {PageStrings.FormatConnection_MetricsLabel(ChosenNamespace?.Name)}")"
                      Metrics="@ChartedMetrics"
                      Scope="@(ChartedMetrics is null ? null : new MetricsScope.Namespace())"
                      Placeholder="@(ChosenNamespace is { } chosen ? PageStrings.FormatConnection_MetricsUnavailable(chosen.Name) : PageStrings.Connection_MetricsChooseNamespace)"
                      FocusOrder="9"
                      OnKeyDown="@HandleKeyDown" />
    }
</Flex>

<HelpDialog @ref="_help" OnClose="@(() => _tree?.FocusAsync() ?? Task.CompletedTask)" />

@code {
    // Title line and rule 2; tree table chrome 4 + buttons 2 + cache row 2.
    private const int LogoLines = FullscreenLayout.Header;
    private const int ChromeLines = 8;
    private const int MinTreeRows = 8;

    // The metrics panel, and the line the terminal-high column leaves free.
    private const int MetricsLines = FullscreenLayout.MetricsPanel + 1;

    private int TreeRows => Math.Max(3, Viewport.Height - LogoLines - ChromeLines - (ShowMetrics ? MetricsLines : 0)
        - (_startupError is null ? 0 : 1) - (Catalog.Error is not null || Catalog.Loading ? 1 : 0));

    private ConnectionTree? _tree;
    private string? _selectKey;
    private ExplorerNode? _selected;
    private MetricsPanel? _metricsPanel;
    private StartupTarget? _startup;
    private bool _leaving;
    private string? _startupError;
    private string? _azDefaultId;

    private NamespaceInfo? ChosenNamespace => _selected?.InNamespace?.Info;

    // When the tree keeps a few rows next to it: by the terminal only, never by the selection, so choosing moves nothing.
    private bool ShowMetrics => MetricsVisibility.IsVisible(Viewport.Height, LogoLines + ChromeLines + MinTreeRows + MetricsLines);

    // Only once the chosen namespace is open.
    private IMetricsService? ChartedMetrics =>
        Connection.Current is { Info: var open } and IHasMetrics { Metrics: var metrics } && open == ChosenNamespace ? metrics : null;

    protected override async Task OnInitializedAsync()
    {
        Catalog.Changed += OnChanged;
        Tree.Changed += OnChanged;
        _startup = NavState.Startup;
        NavState.Startup = null;
        var fromCommandLine = _startup is not null;
        var returning = NavState.AzureSubscription is not null;
        var subscription = NavState.AzureSubscription ?? AzureSubscription.Emulator;
        var ns = returning ? Connection.Current?.Info : NamespaceInfo.Emulator;
        Tree.Reveal(subscription);
        _selectKey = KeyOf(subscription, ns);
        _ = Catalog.EnsureLoadedAsync();
        _azDefaultId = await NamespaceService.GetCurrentSubscriptionIdAsync();
        if (!returning && !fromCommandLine && _azDefaultId is { } current)
            _startup = new StartupTarget(current) { IsAzureCliDefault = true };
        ApplyStartup();
    }

    public void Dispose()
    {
        Catalog.Changed -= OnChanged;
        Tree.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        ApplyStartup();
        StateHasChanged();
    });

    private static string KeyOf(AzureSubscription subscription, NamespaceInfo? ns)
    {
        var node = new ExplorerNode.Subscription(subscription);
        return ns is null ? node.Key : new ExplorerNode.Namespace(node, ns).Key;
    }

    private void SelectNode(AzureSubscription subscription, NamespaceInfo? ns)
    {
        Tree.Reveal(subscription);
        _selectKey = KeyOf(subscription, ns);
        _tree?.SelectNode(_selectKey);
    }

    // The command line's (or az's) subscription and namespace, once listed, cached entries first.
    private void ApplyStartup()
    {
        if (_startup is not { } startup) return;
        // Before the list: the catalog loads on another thread, and a list read first may predate the end of loading.
        var loading = Catalog.Loading;
        if (Catalog.Subscriptions.FirstOrDefault(startup.Matches) is not { } subscription)
        {
            if (loading) return;
            _startup = null;
            if (!startup.IsAzureCliDefault) _startupError = PageStrings.FormatConnection_SubscriptionNotFound(startup.Subscription);
            SelectNode(AzureSubscription.Emulator, NamespaceInfo.Emulator);
            return;
        }
        Tree.Reveal(subscription);
        var (namespaces, done) = Tree.NamespacesOf(subscription);
        if (startup.Namespace is not null && namespaces.FirstOrDefault(startup.Matches) is { } ns)
        {
            _startup = null;
            _leaving = true;
            NavState.AzureSubscription = subscription;
            Connection.SetNamespace(ns);
            if (startup.Open is { } path) _ = OpenAsync(subscription, ns, path);
            else Nav.NavigateTo(Section.Queues.Route);
            return;
        }
        // Without a namespace, its first one is selected, ready for F1.
        if (startup.Namespace is null && namespaces is [var first, ..])
        {
            _startup = null;
            SelectNode(subscription, first);
            return;
        }
        if (!done) return;
        _startup = null;
        if (startup.Namespace is { } missing) _startupError = PageStrings.FormatConnection_NamespaceNotFound(missing, subscription.Name);
        SelectNode(subscription, namespaces.FirstOrDefault());
    }

    // --open: what it names, else the namespace stays selected here with the error.
    private async Task OpenAsync(AzureSubscription subscription, NamespaceInfo ns, string path)
    {
        try
        {
            if (Connection.Current is not { } current) return;
            if (StartupDestination.Find(path, await JumpTargets.LoadAsync(current, FileCache), Section.Of(current)) is { } destination)
            {
                Nav.NavigateTo(destination.Match(e => NavState.RouteTo(e.Target, e.Active), l => l.Section.Route));
                return;
            }
            _startupError = PageStrings.FormatConnection_OpenNotFound(path, ns.Name);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _startupError = PageStrings.FormatConnection_OpenListFailed(ns.Name, ErrorText.Of(ex));
        }
        _leaving = false;
        SelectNode(subscription, ns);
        StateHasChanged();
    }

    // The selection is the connection: its namespace opens (without connecting), so metrics and F1-F3 act on it.
    private async Task Follow(ExplorerNode? node)
    {
        // The tree may first report its initial row after the startup target opened.
        if (_leaving) return;
        _selected = node;
        if (node is ExplorerNode.Subscription s) NavState.AzureSubscription = s.Value;
        if (node?.InNamespace is { } ns)
        {
            NavState.AzureSubscription = ns.Parent.Value;
            if (Connection.CurrentNamespace is var before && before != ns.Info.FullyQualifiedNamespace)
            {
                // The store keys browsers by queue name only; a same-named queue elsewhere must not reuse its locks.
                await Store.CloseAsync();
                // A later selection, or the startup target, switched while closing: that one wins.
                if (_selected != node || Connection.CurrentNamespace != before) return;
                Connection.SetNamespace(ns.Info);
            }
        }
        StateHasChanged();
    }

    private void ToggleMetrics()
    {
        _ = MetricsVisibility.ToggleAsync(Viewport.Height);
        StateHasChanged();
    }

    private Task Open(Section section) => _tree?.OpenSelectedAsync(section) ?? Task.CompletedTask;

    private bool StepRange(KeyboardEventArgs e) =>
        MetricsRange.StepOf(e) is { } step && _metricsPanel?.StepRange(step) == true;

    private IReadOnlyList<KeyBinding> Keys =>
    [
        .. ChosenNamespace is null ? Array.Empty<KeyBinding>() :
        [
            new("1", $"{Icons.Queue} {Strings.Queues}", () => _ = Open(Section.Queues)) { Aliases = ["F1"] },
            .. Connection.Current is IHasTopics
                ? [new KeyBinding("2", $"{Icons.Topic} {Strings.Topics}", () => _ = Open(Section.Topics)) { Aliases = ["F2"] },
                   new KeyBinding("3", $"{Icons.Subscription} {Strings.AllSubscriptions}", () => _ = Open(Section.AllSubscriptions)) { Aliases = ["F3"] }]
                : Array.Empty<KeyBinding>(),
        ],
        new("/", $"{Icons.Filter} {PageStrings.Key_Filter}", () => _ = _tree?.EditFilterAsync()),
        new("m", $"{Icons.Metrics} {PageStrings.Key_Metrics}", ToggleMetrics) { Aliases = ["F12"] },
        new("C", $"{Icons.Purge} {PageStrings.Connection_ClearCache}", ClearCache) { InFooter = false },
        new("?", $"{Icons.Confirm} {Strings.Help}", () => _help?.Open(Keys)),
    ];

    private HelpDialog? _help;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (StepRange(e)) return;
        KeyBinding.Dispatch(Keys, e);
    }

    private string? _cacheStatus;
    private bool _cacheClearFailed;

    private void ClearCache()
    {
        try
        {
            var count = FileCache.Clear();
            _cacheStatus = count switch
            {
                0 => PageStrings.Connection_CacheEmpty,
                1 => PageStrings.FormatConnection_CacheClearedOne(count),
                _ => PageStrings.FormatConnection_CacheClearedMany(count),
            };
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _cacheClearFailed = true;
            _cacheStatus = PageStrings.FormatConnection_ClearFailed(ex.Message);
        }
        StateHasChanged();
    }
}
