@page "/"
@implements IDisposable

@inject NavigationManager Nav
@inject NavigationState NavState
@inject INamespaceService NamespaceService
@inject SubscriptionCatalog Catalog
@inject ServiceBusConnection Connection
@inject FileCache FileCache
@inject RazorConsole.Core.Focus.FocusManager FocusManager
@inject ITerminalViewport Viewport
@inject MetricsVisibility MetricsVisibility

@* With the metrics panel, a column of the terminal's height keeps it at the bottom, wherever the lists end. *@
<Flex Direction="FlexDirection.Column" Height="@(ShowMetrics ? Viewport.Height - 1 : null)" Justify="FlexJustify.SpaceBetween" FillWidth="true">
    <Rows FillWidth="true">
        <Figlet Content="SB Console" Color="@Theme.Accent" Justify="Justify.Left" />

        <Panel Title="⚠ Work In Progress" BorderColor="@Theme.Warning" FillWidth="true" Padding="@(new(1, 0, 1, 0))">
            <Rows>
                <Markup Content="This application is still in early development. Many features are unstable or incomplete." Foreground="@Theme.Warning" Decoration="@Decoration.Bold" />
                <Markup Content="Use with caution — especially destructive operations (delete, receive)." Foreground="@Theme.Muted" />
            </Rows>
        </Panel>

        <Panel Title="@($"{Icons.Connection} Connection")" BorderColor="@Theme.Border" FillWidth="true" Padding="@(new(1, 0, 1, 0))">
            <Rows>
                <SelectableList Items="@_visible"
                            PageSize="@SubscriptionPageSize"
                            Scrollbar="new()"
                            SelectedIndex="@_subscriptionIndex"
                            SelectedIndexChanged="@(i => { _subscriptionIndex = i; _ = SelectSubscription(_visible[i]); })"
                            OnActivate="FocusNamespaces">
                    <SpectreTable Expand="true" Border="TableBorder.Rounded">
                        <SpectreTHead>
                            <SpectreTR>
                                <SpectreTH Align="Justify.Left"><Columns><Markup Content="Azure subscription" /><ColumnFilter Filter="@_filter" /></Columns></SpectreTH>
                                <SpectreTH Align="Justify.Left">ID</SpectreTH>
                            </SpectreTR>
                        </SpectreTHead>
                        <NavigableTBody @ref="_subscriptionBody"
                                      FocusOrder="1"
                                      OnKeyDown="@HandleSubscriptionKeyDown">
                            @{ var i = 0; }
                            @foreach (var sub in context.Items)
                            {
                                var idx = i++;
                                <SelectableRow @key="@(sub.Id ?? "")" RowIndex="@idx">
                                    <SpectreTD>@($"{(sub.IsEmulator ? Icons.Emulator : Icons.AzureSubscription)} {sub.Name}")</SpectreTD>
                                    <SpectreTD><Markup Content="@(sub.Id is { } id ? (id == _azDefaultId ? $"{id}  (az default)" : id) : "localhost:5672")" Foreground="@Theme.Muted" /></SpectreTD>
                                </SelectableRow>
                            }
                        </NavigableTBody>
                    </SpectreTable>
                </SelectableList>

                @if (_startupError is { } startupError)
                {
                    <Markup Content="@startupError" Foreground="@Theme.Danger" />
                }

                @if (Catalog.Error is { } listError)
                {
                    <Markup Content="@($"Could not list Azure subscriptions (az login?): {listError}")" Foreground="@Theme.Danger" />
                }
                else if (Catalog.Loading)
                {
                    <Columns>
                        <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                        <Markup Content="Listing Azure subscriptions..." Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
                    </Columns>
                }

                @if (_namespacesLoading)
                {
                    <Padder Padding="@(new(0, 1, 0, 0))">
                        <Columns>
                            <RazorConsole.Components.Spinner SpinnerType="@Spectre.Console.Spinner.Known.Dots" />
                            <Markup Content="Discovering namespaces..." Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
                        </Columns>
                    </Padder>
                }
                else if (_connectionFailed)
                {
                    <Padder Padding="@(new(0, 1, 0, 0))">
                        <Columns>
                            <Markup Content="Could not connect.  " Foreground="@Theme.Danger" />
                            <KeyButton Content="@($"{Icons.Refresh} Retry")" OnClick="RetryConnection" FocusedColor="@Theme.Warning" FocusOrder="3" OnKeyDown="@HandleKeyDown" />
                        </Columns>
                    </Padder>
                }
                else if (_namespaces.Count > 0)
                {
                    <SelectableList Items="@_namespaces"
                                PageSize="@NamespacePageSize"
                                Scrollbar="new()"
                                SelectedIndex="@_namespaceIndex"
                                SelectedIndexChanged="@(i => SelectNamespace(i))"
                                OnActivate="@(() => Nav.NavigateTo("/queues"))">
                        <SpectreTable Expand="true" Border="TableBorder.Rounded">
                            <SpectreTHead>
                                <SpectreTR>
                                    <SpectreTH Align="Justify.Left">Namespace</SpectreTH>
                                    <SpectreTH Align="Justify.Left">Resource group</SpectreTH>
                                    <SpectreTH Align="Justify.Left">Location</SpectreTH>
                                    <SpectreTH Align="Justify.Left">SKU</SpectreTH>
                                    <SpectreTH Align="Justify.Left">Status</SpectreTH>
                                </SpectreTR>
                            </SpectreTHead>
                            <NavigableTBody @ref="_namespaceBody"
                                          FocusOrder="3"
                                          OnKeyDown="@HandleKeyDown">
                                @{ var i = 0; }
                                @foreach (var ns in context.Items)
                                {
                                    var idx = i++;
                                    <SelectableRow @key="ns.Name" RowIndex="@idx">
                                        <SpectreTD>@($"{Icons.Namespace} {ns.Name}")</SpectreTD>
                                        <SpectreTD><Markup Content="@ns.ResourceGroup" Foreground="@Theme.Muted" /></SpectreTD>
                                        <SpectreTD><Markup Content="@ns.Location" Foreground="@Theme.Muted" /></SpectreTD>
                                        <SpectreTD>@ns.Sku</SpectreTD>
                                        <SpectreTD>
                                            @if (!string.IsNullOrEmpty(ns.Status))
                                            {
                                                <Markup Content="@($"{Icons.NamespaceStatus(ns.Status)} {ns.Status}")" Foreground="@Theme.NamespaceStatus(ns.Status)" />
                                            }
                                        </SpectreTD>
                                    </SelectableRow>
                                }
                            </NavigableTBody>
                        </SpectreTable>
                    </SelectableList>
                }

                @if (ChosenNamespace is not null)
                {
                    <Padder Padding="@(new(0, 1, 0, 0))">
                        <Columns>
                            <KeyButton Content="@($"[F1] {Icons.Queue} Queues")"
                                        OnClick="@(() => Nav.NavigateTo("/queues"))"
                                        FocusedColor="@Theme.Accent"
                                        FocusOrder="4"
                                        OnKeyDown="@HandleKeyDown" />
                            <Markup Content="  " />
                            @if (Connection.Current is IHasTopics)
                            {
                                <KeyButton Content="@($"[F2] {Icons.Topic} Topics")"
                                            OnClick="@(() => Nav.NavigateTo("/topics"))"
                                            FocusedColor="@Theme.Accent"
                                            FocusOrder="5"
                                            OnKeyDown="@HandleKeyDown" />
                                <Markup Content="  " />
                                <KeyButton Content="@($"[F3] {Icons.Subscription} All Subscriptions")"
                                            OnClick="@(() => Nav.NavigateTo("/subscriptions"))"
                                            FocusedColor="@Theme.Accent"
                                            FocusOrder="6"
                                            OnKeyDown="@HandleKeyDown" />
                                <Markup Content="  " />
                            }
                            <KeyButton Content="@($"[F12] {Icons.Metrics} Metrics")"
                                        OnClick="ToggleMetrics"
                                        FocusedColor="@Theme.Accent"
                                        FocusOrder="7"
                                        OnKeyDown="@HandleKeyDown" />
                        </Columns>
                    </Padder>
                }
            </Rows>
        </Panel>

        <Padder Padding="@(new(0, 1, 0, 0))">
            <Columns>
                <Markup Content="@($"Cache: {FileCache.CacheDirectory}")" Foreground="@Theme.Muted" Decoration="@Decoration.Italic" />
                <Markup Content="   " />
                @if (_cacheStatus is null)
                {
                    <KeyButton Content="@($"{Icons.Purge} Clear cache")" OnClick="ClearCache" FocusedColor="@Theme.Danger" FocusOrder="8" OnKeyDown="@HandleKeyDown" />
                }
                else
                {
                    <Markup Content="@_cacheStatus" Foreground="@(_cacheClearFailed ? Theme.Danger : Theme.Success)" />
                }
            </Columns>
        </Padder>
    </Rows>

    @if (ShowMetrics)
    {
        <MetricsPanel @ref="_metricsPanel"
                      Label="@($"{Icons.Namespace} namespace {ChosenNamespace?.Name}")"
                      Metrics="@ChartedMetrics"
                      Scope="@(ChartedMetrics is null ? null : new MetricsScope.Namespace())"
                      Placeholder="@(ChosenNamespace is { } chosen ? $"Azure Monitor metrics aren't available for {chosen.Name}." : "Choose a namespace to chart its Azure Monitor metrics.")"
                      FocusOrder="9"
                      OnKeyDown="@HandleKeyDown" />
    }
</Flex>

<ErrorModal Message="@_error" OnDismiss="@(() => _error = string.Empty)" />

@code {
    // Figlet 6 + banner 4; panel 2 + subscription table chrome 4 + namespace chrome 4 + buttons 2 + cache row 2.
    private const int LogoLines = 10;
    private const int ChromeLines = 14;
    private const int MaxSubscriptionRows = 8;

    // The metrics panel, and the line the terminal-high column leaves free.
    private const int MetricsLines = FullscreenLayout.MetricsPanel + 1;

    private int FixedLines => LogoLines + ChromeLines + (ShowMetrics ? MetricsLines : 0)
        + (_startupError is null ? 0 : 1) + (Catalog.Error is not null || Catalog.Loading ? 1 : 0);
    private int SubscriptionPageSize => Math.Clamp(_visible.Count, 1, MaxSubscriptionRows);
    private int NamespacePageSize => Math.Clamp(Viewport.Height - FixedLines - SubscriptionPageSize, 1, 10);
    private static readonly TimeSpan SubscriptionDebounce = TimeSpan.FromMilliseconds(250);

    private List<AzureSubscription> _subscriptions = [AzureSubscription.Emulator];
    private List<AzureSubscription> _visible = [AzureSubscription.Emulator];
    private string? _filter;
    private AzureSubscription _chosen = AzureSubscription.Emulator;
    private int _subscriptionIndex;
    private int _namespaceIndex;
    private List<NamespaceInfo> _namespaces = [];
    private bool _namespacesLoading;
    private bool _connectionFailed;
    private string _error = string.Empty;
    private CancellationTokenSource _cts = new();
    private NavigableTBody? _subscriptionBody;
    private NavigableTBody? _namespaceBody;
    private MetricsPanel? _metricsPanel;
    private bool _subscriptionsFocused;
    private bool _focusNamespaces;
    private string? _restoreNamespace;
    private StartupTarget? _startup;
    private string? _startupError;
    private string? _azDefaultId;

    private NamespaceInfo? ChosenNamespace => _namespacesLoading ? null : _namespaces.ElementAtOrDefault(_namespaceIndex);

    // When every subscription row and three namespaces fit next to it: by the terminal and the account's subscriptions,
    // never by the selection or the filter, so choosing moves nothing.
    private bool ShowMetrics => MetricsVisibility.IsVisible(Viewport.Height,
        LogoLines + ChromeLines + Math.Clamp(ListedSubscriptions, 1, MaxSubscriptionRows) + 3 + MetricsLines);

    // Rows the subscription list can show whatever the filter: ones known to have no namespaces are hidden.
    private int ListedSubscriptions => _subscriptions.Count(s => s.IsEmulator || Catalog.HasNamespaces(s) != false);

    // Only once the chosen namespace is open: the connection keeps the previous one until the new ones are listed.
    private IMetricsService? ChartedMetrics =>
        Connection.Current is { Info: var open } and IHasMetrics { Metrics: var metrics } && open == ChosenNamespace ? metrics : null;

    protected override async Task OnInitializedAsync()
    {
        Catalog.Changed += OnCatalogChanged;
        _subscriptions = [.. Catalog.Subscriptions];
        if (NavState.AzureSubscription is { IsEmulator: false } previous && !_subscriptions.Contains(previous)) _subscriptions.Add(previous);
        UpdateVisible();
        _ = Catalog.EnsureLoadedAsync();
        _startup = NavState.Startup;
        NavState.Startup = null;
        _azDefaultId = await NamespaceService.GetCurrentSubscriptionIdAsync();
        if (_startup is null && NavState.AzureSubscription is null && _azDefaultId is { } current)
            _startup = new StartupTarget(current) { IsAzureCliDefault = true };
        if (_startup is null) await SelectSubscription(NavState.AzureSubscription ?? AzureSubscription.Emulator, debounce: false);
        else await ApplyStartup();
    }

    public void Dispose() => Catalog.Changed -= OnCatalogChanged;

    private void OnCatalogChanged() => _ = InvokeAsync(() =>
    {
        _subscriptions = [.. Catalog.Subscriptions];
        UpdateVisible();
        StateHasChanged();
        return ApplyStartup();
    });

    // Waits for the command line's subscription in the listing, cached entries first; nothing is selected meanwhile.
    private Task ApplyStartup()
    {
        if (_startup is not { } startup) return Task.CompletedTask;
        if (Catalog.Subscriptions.FirstOrDefault(startup.Matches) is { } subscription)
            return SelectSubscription(subscription, debounce: false, startup);
        if (Catalog.Loading) return Task.CompletedTask;
        if (!startup.IsAzureCliDefault) _startupError = $"Azure subscription \"{startup.Subscription}\" not found.";
        return SelectSubscription(AzureSubscription.Emulator, debounce: false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_subscriptionsFocused && _subscriptionBody is not null)
        {
            _subscriptionsFocused = true;
            await FocusManager.FocusAsync(_subscriptionBody.FocusKey);
        }
        if (_focusNamespaces && _namespaceBody is not null)
        {
            _focusNamespaces = false;
            await FocusManager.FocusAsync(_namespaceBody.FocusKey);
        }
    }

    private void ToggleMetrics()
    {
        _ = MetricsVisibility.ToggleAsync(Viewport.Height);
        StateHasChanged();
    }

    private bool StepRange(KeyboardEventArgs e, string? filter) =>
        MetricsRange.StepOf(e, filter) is { } step && _metricsPanel?.StepRange(step) == true;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (StepRange(e, filter: null)) return;
        if (e.Key == "F12") { ToggleMetrics(); return; }
        if (ChosenNamespace is null) return;
        switch (e.Key)
        {
            case "F1": Nav.NavigateTo("/queues"); return;
            case "F2" when Connection.Current is IHasTopics: Nav.NavigateTo("/topics"); return;
            case "F3" when Connection.Current is IHasTopics: Nav.NavigateTo("/subscriptions"); return;
        }
    }

    // The emulator always stays visible. Others need a filter match, and must not be known to lack
    // Service Bus namespaces (unknown ones show until checked; the current choice is never hidden for it).
    private void UpdateVisible()
    {
        _visible = [.. _subscriptions.Where(s => s.IsEmulator
            || (MatchesFilter(s) && (s == _chosen || Catalog.HasNamespaces(s) != false)))];
        _subscriptionIndex = Math.Max(0, _visible.IndexOf(_chosen));
    }

    private bool MatchesFilter(AzureSubscription s) => string.IsNullOrWhiteSpace(_filter)
        || s.Name.Contains(_filter, StringComparison.CurrentCultureIgnoreCase)
        || (s.Id?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false);

    private void ApplyFilter(string? value)
    {
        _filter = value;
        UpdateVisible();
        // Filtering looks for an Azure subscription: move to the first match unless the choice still matches.
        var keep = !_chosen.IsEmulator && _visible.Contains(_chosen);
        if (!keep && !string.IsNullOrEmpty(_filter) && _visible.FirstOrDefault(s => !s.IsEmulator) is { } match)
        {
            _subscriptionIndex = _visible.IndexOf(match);
            _ = SelectSubscription(match);
        }
        StateHasChanged();
    }

    private void HandleSubscriptionKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (StepRange(e, _filter)) return;
        if (FilterEdit.From(_filter, e) is { } edit) ApplyFilter(edit.Filter);
        else HandleKeyDown(e);
    }

    private void FocusNamespaces()
    {
        _focusNamespaces = true;
        StateHasChanged();
    }

    private Task RetryConnection() => SelectSubscription(_chosen);

    private string? _cacheStatus;
    private bool _cacheClearFailed;

    private void ClearCache()
    {
        try
        {
            var count = FileCache.Clear();
            _cacheStatus = count == 0 ? "✓ Cache already empty" : $"✓ Cache cleared ({count} file{(count == 1 ? "" : "s")})";
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _cacheClearFailed = true;
            _cacheStatus = $"Clear failed: {ex.Message}";
        }
        StateHasChanged();
    }

    /// <param name="startup">From the command line: open its namespace once listed, or focus the namespaces when it names none.</param>
    private async Task SelectSubscription(AzureSubscription subscription, bool debounce = true, StartupTarget? startup = null)
    {
        // Take the token for *this* run: a newer selection replaces the field.
        _cts.Cancel();
        var token = (_cts = new CancellationTokenSource()).Token;
        _startup = null;
        _error = string.Empty;
        _connectionFailed = false;
        _namespaces = [];
        _namespaceIndex = 0;
        _restoreNamespace = Connection.CurrentNamespace;
        _chosen = subscription;
        NavState.AzureSubscription = subscription;
        UpdateVisible();
        if (startup is { Namespace: null }) FocusNamespaces();

        if (subscription.IsEmulator)
        {
            _namespaces = [NamespaceInfo.Emulator];
            SelectNamespace(0);
            if (startup is not null && !OpenStartupNamespace(startup, NamespaceInfo.Emulator, 0)) ReportMissingNamespace(startup, subscription);
            return;
        }

        _namespacesLoading = true;
        StateHasChanged();

        try
        {
            // Arrowing through subscriptions should not query Azure for each one passed.
            if (debounce) await Task.Delay(SubscriptionDebounce, token);
            await foreach (var ns in NamespaceService.GetNamespacesAsync(subscription, token))
            {
                if (token.IsCancellationRequested) return;
                _namespacesLoading = false;
                var idx = _namespaces.Upsert(ns, x => x.Name == ns.Name);
                if (ns.FullyQualifiedNamespace == _restoreNamespace)
                {
                    _restoreNamespace = null;
                    _namespaceIndex = idx;
                }
                SelectNamespace(_namespaceIndex);
                if (startup is not null && OpenStartupNamespace(startup, ns, idx)) startup = null;
            }
            if (startup is not null) ReportMissingNamespace(startup, subscription);
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) { _connectionFailed = true; _error = ErrorText.Of(ex); }

        _namespacesLoading = false;
        StateHasChanged();
    }

    private bool OpenStartupNamespace(StartupTarget startup, NamespaceInfo ns, int index)
    {
        if (!startup.Matches(ns)) return false;
        SelectNamespace(index);
        Nav.NavigateTo("/queues");
        return true;
    }

    private void ReportMissingNamespace(StartupTarget startup, AzureSubscription subscription)
    {
        if (startup.Namespace is { } name) _startupError = $"Namespace \"{name}\" not found in {subscription.Name}.";
    }

    private void SelectNamespace(int index)
    {
        _namespaceIndex = index;
        if (_namespaces.ElementAtOrDefault(index) is { } ns) Connection.SetNamespace(ns);
        StateHasChanged();
    }
}
