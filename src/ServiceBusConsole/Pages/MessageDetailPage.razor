@page "/message"
@implements IDisposable

@inject NavigationManager Nav
@inject ServiceBusConnection Connection
@inject NavigationState NavState
@inject MessageBrowserStore Store
@inject ITerminalViewport Viewport
@inject PluginActions PluginActions
@inject SessionContext Session
@inject Clipboard Clipboard
@inject ActivityLog Activity

@if (NavState.Message is null)
{
    <Markup Content="@PageStrings.MessageDetail_NoMessage" Foreground="@Theme.Danger" />
}
else
{
    var msg = NavState.Message;

    <Flex Class="rows" Direction="FlexDirection.Column" @onkeydown="HandleKeyDown">
        <ConnectionHeader Status="@Position">
            <Markup Content="@SourceLabel" Foreground="@Theme.Muted" />
            <Markup Content=" › " Foreground="@Theme.Muted" />
            <Markup Content="@($"{Icons.Message} {PageStrings.FormatMessageDetail_Title(msg.SequenceNumber)}")" Foreground="@Theme.Accent" Decoration="@Decoration.Bold" />
        </ConnectionHeader>

        <Flex Justify="FlexJustify.SpaceBetween" FillWidth="true">
            <Flex Gap="1">
                @foreach (var (tab, index) in Tabs(msg).Select((t, i) => (t, i)))
                {
                    var current = index == _tab;
                    <div class="zoom-tab" @onclick="@(() => ShowTab(index))">
                        <Markup Content="@($" {index + 1} {tab} ")" Background="@(current ? Theme.Selection : Color.Default)"
                                Foreground="@(current ? Theme.OnSelection : Theme.Muted)" Decoration="@(current ? Decoration.Bold : Decoration.None)" />
                    </div>
                }
            </Flex>
            <Markup Content="@BodySummary(msg)" Foreground="@Theme.Muted" />
        </Flex>

        @if (msg.DeadLetterReason is { } reason)
        {
            <Columns>
                <Markup Content="@($"{Icons.DeadLetter} {reason}")" Foreground="@Theme.Danger" Decoration="@Decoration.Bold" />
                @if (msg.DeadLetterErrorDescription is { Length: > 0 } description) { <Markup Content="@description" Foreground="@Theme.Muted" /> }
            </Columns>
        }

        <Panel BorderColor="@Theme.Border" Border="BoxBorder.Rounded" Width="@Viewport.Width" Height="@BoxHeight(msg)" Padding="@(new(1, 0, 1, 0))">
            <ViewHeightScrollable @key="@($"{msg.SequenceNumber}/{_tab}")" LinesToRender="@(BoxHeight(msg) - 2)" Scrollbar="@Theme.Scrollbar()" FocusOrder="0" OnKeyDown="@HandleKeyDown">
                @switch (_tab)
                {
                    case 0:
                        @if (MessagePreview.FormatJson(msg.BodyText) is { } json) { <SyntaxHighlighter Code="@json" Language="json" ShowLineNumbers="true" /> }
                        else { <Markup Content="@msg.BodyText" /> }
                        break;
                    case 1:
                        @Table(SystemProperties(msg))
                        break;
                    case 2:
                        @if (msg.Properties.Count == 0) { <Markup Content="@PageStrings.MessageDetail_NoApplicationProperties" Foreground="@Theme.Muted" /> }
                        else { @Table(msg.Properties.Select(p => (p.Key, p.Value))) }
                        break;
                    default:
                        <SyntaxHighlighter Code="@MessageJson.Format(msg)" Language="json" />
                        break;
                }
            </ViewHeightScrollable>
        </Panel>

        @if (_copied is { } copied)
        {
            <Markup Content="@copied" Foreground="@Theme.Success" />
        }
        <KeyHints Bindings="@Keys" FirstFocusOrder="1" OnKeyDown="@HandleKeyDown" />
    </Flex>
}

<OperationDialog Operation="@_browser?.Operation" OnDismiss="DismissOperation" />

<MessageActionsDialog @ref="_actions" OnClosed="StateHasChanged" />
<HelpDialog @ref="_help" OnClose="StateHasChanged" />

<AsyncCommand @ref="_complete" TItem="MessageInfo"
              ConfirmMessage="@(m => PageStrings.FormatMessageDetail_CompleteConfirm(m.SequenceNumber, NavState.MessageSource?.DisplayName))"
              Execute="@(m => Act(m, (b, l) => b.CompleteAsync(l)))" />

<AsyncCommand @ref="_abandon" TItem="MessageInfo"
              Execute="@(m => Act(m, (b, l) => b.AbandonAsync(l)))" />

<AsyncCommand @ref="_deadLetter" TItem="MessageInfo"
              ConfirmMessage="@(m => PageStrings.FormatMessageDetail_DeadLetterConfirm(m.SequenceNumber))"
              Execute="@(m => Act(m, (b, l) => b.DeadLetterAsync(l)))" />

<AsyncCommand @ref="_retry" TItem="MessageInfo"
              ConfirmMessage="@(m => RetryConfirm(m))"
              Execute="@(m => Act(m, (b, l) => b.RetryAsync(l)))" />

<AsyncCommand @ref="_resend" TItem="MessageInfo"
              ConfirmMessage="@(m => PageStrings.FormatMessageDetail_ResendConfirm(m.SequenceNumber, NavState.MessageSource?.SendTarget))"
              Execute="@(m => Act(m, (b, l) => b.ResendAsync(l)))" />

@code {
    private AsyncCommand<MessageInfo>? _complete;
    private AsyncCommand<MessageInfo>? _abandon;
    private AsyncCommand<MessageInfo>? _deadLetter;
    private AsyncCommand<MessageInfo>? _retry;
    private AsyncCommand<MessageInfo>? _resend;
    private MessageBrowser? _browser;
    private MessageActionsDialog? _actions;

    private bool IsDlq => NavState.MessageSource?.IsDlq == true;
    private BrowseMode? Mode => NavState.Message is null ? null : _browser?.Mode;
    private bool CanRetry => CanAct && Mode is { } mode && RetryText.CanRetry(mode, IsDlq);

    // False for a settled message or a lost lock in a locked list.
    private bool CanAct => _browser is { } b && NavState.Message is { } m && b.CanAct(m);

    private string RetryConfirm(MessageInfo message) => Mode is { } mode && NavState.MessageSource is { } source
        ? RetryText.Confirm(mode, source, Strings.FormatOneMessage(message.SequenceNumber), _browser?.Namespace is IHasTransactions)
        : "";

    protected override void OnInitialized()
    {
        if (Store.Current is { } current && current.Source == NavState.MessageSource) _browser = current;
        if (_browser is not null) _browser.Changed += OnBrowserChanged;
    }

    public void Dispose()
    {
        if (_browser is not null) _browser.Changed -= OnBrowserChanged;
    }

    // Progress of an action started here arrives from a background thread.
    private void OnBrowserChanged() => _ = InvokeAsync(StateHasChanged);

    private int _tab;
    private string? _copied;

    // Header 2 lines, tabs 1, the dead-letter line, a copied note, the key row 1, and the line left free at the bottom.
    private int BoxHeight(MessageInfo m) =>
        Math.Max(5, Viewport.Height - 5 - (m.DeadLetterReason is null ? 0 : 1) - (_copied is null ? 0 : 1));

    private static IReadOnlyList<string> Tabs(MessageInfo m) =>
        [
            $"{Icons.Body} {PageStrings.MessageDetail_TabBody}",
            $"{Icons.Properties} {PageStrings.MessageDetail_TabProperties}",
            m.Properties.Count > 0 ? PageStrings.FormatMessageDetail_TabApplicationCount(m.Properties.Count) : PageStrings.MessageDetail_TabApplication,
            PageStrings.MessageDetail_TabRaw,
        ];

    private static string BodySize(MessageInfo m) => Strings.FormatBytes(m.Body.Length.ToString("N0"));

    private static string BodySummary(MessageInfo m) =>
        string.Join(" · ", new[] { m.ContentType, BodySize(m) }.Where(p => p.Length > 0));

    private static RenderFragment Table(IEnumerable<(string Name, string Value)> rows) =>
        @<SpectreTable BorderColor="@Theme.Border" Expand="true" Border="TableBorder.None">
            <SpectreTBody>
                @foreach (var (name, value) in rows)
                {
                    <SpectreTR>
                        <SpectreTD><Markup Content="@name" Foreground="@Theme.Muted" /></SpectreTD>
                        <SpectreTD><Markup Content="@value" /></SpectreTD>
                    </SpectreTR>
                }
            </SpectreTBody>
        </SpectreTable>;

    private static IEnumerable<(string, string)> SystemProperties(MessageInfo m) =>
    [
        (Strings.MessageId, m.MessageId),
        (Strings.SequenceNumber, m.SequenceNumber.ToString()),
        (Strings.Subject, m.Subject),
        (PageStrings.MessageDetail_PropertyContentType, m.ContentType),
        (Strings.Enqueued, RelativeTime.Full(m.EnqueuedTime, DateTimeOffset.UtcNow)),
        (PageStrings.MessageDetail_PropertyDeliveryCount, m.DeliveryCount.ToString()),
        (Strings.State, m.State.ToString()),
        .. m.DeadLetterReason is { } reason ? [(PageStrings.MessageDetail_PropertyDeadLetterReason, reason)] : Array.Empty<(string, string)>(),
        .. m.DeadLetterErrorDescription is { } description ? [(PageStrings.MessageDetail_PropertyDeadLetterDescription, description)] : Array.Empty<(string, string)>(),
    ];

    /// <summary>Where the message is in the browser's list: "2 of 3"; nothing without the list.</summary>
    private RenderFragment? Position => IndexInList is { } i && _browser is { } b
        ? @<Markup Content="@(PageStrings.FormatMessageDetail_Position(i + 1, b.Messages.Count))" Foreground="@Theme.Muted" />
        : null;

    private int? IndexInList => _browser is { } b && NavState.Message is { } m
        && b.Messages.Select((x, i) => (x, i)).FirstOrDefault(e => e.x.SequenceNumber == m.SequenceNumber) is { x: not null } found
            ? found.i : null;

    private void ShowTab(int tab)
    {
        _tab = tab;
        StateHasChanged();
    }

    /// <summary>The previous or next message of the list, without going back to it; the list's cursor follows.</summary>
    private void Step(int by)
    {
        if (_browser is not { } b || IndexInList is not { } i) return;
        var next = Math.Clamp(i + by, 0, b.Messages.Count - 1);
        if (next == i) return;
        b.Cursor = next;
        NavState.Message = b.Messages[next];
        _copied = null;
        StateHasChanged();
    }

    private void CopyBody()
    {
        if (NavState.Message is not { } m) return;
        Clipboard.Copy(m.BodyText);
        _copied = $"{Icons.Done} {PageStrings.FormatMessageDetail_Copied(m.SequenceNumber, m.Body.Length.ToString("N0"))}";
        Activity.Record(ActivityKind.Operation, PageStrings.FormatMessageDetail_CopiedActivity(m.SequenceNumber), NavState.MessageSource);
        StateHasChanged();
    }

    private string SourceLabel => NavState.MessageSource is { } source
        ? $"{source.Match(_ => Icons.Queue, _ => Icons.Subscription)} {source.DisplayName}"
        : "";

    private AsyncCommand<MessageInfo>?[] Commands => [_complete, _abandon, _deadLetter, _retry, _resend];

    private Task Act(MessageInfo message, Func<MessageBrowser, IReadOnlyList<MessageInfo>, Task> action) =>
        _browser is { } b
            ? action(b, [message])
            : throw new InvalidOperationException(PageStrings.MessageDetail_NoLongerLoaded);

    private void OpenActions()
    {
        if (NavState.Message is { } message && NavState.MessageSource is { } source) _actions?.Open(message, source);
    }

    private void Run(AsyncCommand<MessageInfo>? command)
    {
        if (NavState.Message is { } message) command?.Invoke(message);
    }

    // The message is handled: back to the list. After a failure or cancel it is still here.
    private void DismissOperation()
    {
        if (_browser?.Operation is not { Finished: true } op) return;
        _browser.Dismiss();
        if (op.Outcome == OperationOutcome.Succeeded) GoBack();
    }

    private void GoBack()
    {
        switch (NavState.MessageSource)
        {
            case MessageSource.Queue q:
                Nav.NavigateTo($"/queues/{Uri.EscapeDataString(q.Name)}");
                break;
            case MessageSource.Subscription s:
                (NavState.TopicName, NavState.SubscriptionName) = (s.Topic, s.Name);
                Nav.NavigateTo("/subscription-browser");
                break;
            default:
                Nav.NavigateTo("/");
                break;
        }
    }

    private HelpDialog? _help;

    private IReadOnlyList<KeyBinding> Keys =>
    [
        .. Mode == BrowseMode.Locked && CanAct
            ? [new KeyBinding("c", $"{Icons.Complete} {Strings.Complete}", () => Run(_complete)) { Danger = true, Aliases = ["F9", "Delete"] },
               new KeyBinding("a", $"{Icons.Unlocked} {Strings.Abandon}", () => Run(_abandon)) { Aliases = ["F4"] },
               .. IsDlq ? Array.Empty<KeyBinding>()
                   : [new KeyBinding("X", $"{Icons.DeadLetter} {Strings.DeadLetter}", () => Run(_deadLetter)) { Danger = true, Aliases = ["F3"] }]]
            : Array.Empty<KeyBinding>(),
        .. CanRetry
            ? [new KeyBinding("R", $"{Icons.Retry} {RetryText.Label(IsDlq)}", () => Run(_retry)) { Danger = true, Aliases = ["F10"] }]
            : Mode == BrowseMode.Peek && _browser is not null
                ? [new KeyBinding("R", $"{Icons.Send} {Strings.Resend}", () => Run(_resend)) { Danger = true, Aliases = ["F10"] }]
                : Array.Empty<KeyBinding>(),
        .. NavState.Message is { } msg && NavState.MessageSource is { } source && PluginActions.Any(msg, source, Session.Snapshot)
            ? [new KeyBinding(".", $"{Icons.Actions} {Strings.Actions}", OpenActions) { Aliases = ["F2"] }]
            : Array.Empty<KeyBinding>(),
        new("[", PageStrings.MessageDetail_KeyPrevious, () => Step(-1)) { InFooter = _browser is { Messages.Count: > 1 } },
        new("]", PageStrings.MessageDetail_KeyNext, () => Step(1)) { InFooter = _browser is { Messages.Count: > 1 } },
        new("y", $"{Icons.Body} {PageStrings.MessageDetail_KeyCopy}", CopyBody),
        .. Tabs(NavState.Message ?? EmptyMessage).Select((t, i) => new KeyBinding($"{i + 1}", t, () => ShowTab(i)) { InFooter = false }),
        new("?", $"{Icons.Confirm} {Strings.Help}", () => _help?.Open(Keys)),
        new("Escape", $"{Icons.Back} {Strings.Back}", GoBack),
    ];

    private static readonly MessageInfo EmptyMessage = new() { SequenceNumber = 0, State = MessageState.Peeked };

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey || _help?.IsOpened == true || _actions?.IsOpened == true) return;
        if (_browser?.Operation is { Finished: true })
        {
            if (e.Key is "Escape" or "Enter") DismissOperation();
            return;
        }
        if (e.Key == "Escape" && _browser?.Operation is { Finished: false } running)
        {
            running.Cancel();
            StateHasChanged();
            return;
        }
        if (Commands.Any(c => c?.HandleKey(e) == true)) return;
        if (Commands.Any(c => c?.IsBusy == true)) return;
        KeyBinding.Dispatch(Keys, e);
    }
}
