<Project Sdk="Microsoft.NET.Sdk">
  <!-- rmqsb: the shared terminal UI (ServiceBusConsole) on RabbitMQ. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rmqsb</ToolCommandName>
    <PackageId>Net.RabbitMQ.ServiceBusConsole</PackageId>
    <Authors>zidad</Authors>
    <Description>RabbitMQ CLI and terminal UI: browse virtual hosts and queues, peek, receive, resend and purge messages from the terminal.</Description>
    <PackageTags>rabbitmq;amqp;queue;cli;tui;terminal;dead-letter;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/zidad/azure-servicebus-console</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/zidad/azure-servicebus-console</RepositoryUrl>
    <!-- A native package per platform, packed with dotnet pack -r <rid> on that OS; 'any' (framework-dependent) elsewhere. -->
    <PublishAot>true</PublishAot>
    <!-- Restores the 'any' target that a plain pack builds. -->
    <RuntimeIdentifiers>any</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64;win-x64;win-arm64;any</ToolPackageRuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <!-- Keep debug symbols and XML docs out of the tool packages and archives. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishReferencesSymbols>false</PublishReferencesSymbols>
    <!-- Blazor 10's Router.NotFoundPage setter is annotated for trimming; Router parameters are set by reflection (dotnet/aspnetcore#63951). -->
    <NoWarn>$(NoWarn);IL2110;IL2111</NoWarn>
  </PropertyGroup>
  <!-- The plain dotnet pack builds the pointer package and 'any' only, on any host; the native packages come from dotnet pack -r. -->
  <Target Name="PackAnyWithThePointer" BeforeTargets="ComputeToolPackageRuntimeIdentifiersToPack">
    <ItemGroup>
      <ToolPackageRuntimeIdentifiersToPack Include="any" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Blazor's Router finds the @page components by scanning the UI's assembly: trimming must keep them all. -->
    <TrimmerRootAssembly Include="ServiceBusConsole" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ServiceBusConsole/ServiceBusConsole.csproj" />
    <ProjectReference Include="../ServiceBusConsole.RabbitMQ/ServiceBusConsole.RabbitMQ.csproj" />
    <ProjectReference Include="../ServiceBusConsole.BundledPlugins/ServiceBusConsole.BundledPlugins.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="ServiceBusConsole.Abstractions" />
    <Using Include="ServiceBusConsole.CommandLine" />
    <Using Include="ServiceBusConsole.Configuration" />
    <Using Include="ServiceBusConsole.Rmqsb.Resources" />
  </ItemGroup>
</Project>
